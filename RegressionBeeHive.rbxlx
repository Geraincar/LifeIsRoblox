		collectRest = "Собрать остальные",
		collectTot = "Собрать в столбик",
		tapSquares = "тапни по квадрату",
		dragMean = "тяни к среднему",
		status = { res = "тапни по квадрату", mean = "тяни прямую к среднему", tot = "собери квадраты", done = "готово" },
		ssResTitle = "Сумма квадратов остатков",
		ssTotTitle = "Сумма квадратов отклонений от среднего",
		r2Title = "Коэффициент детерминации",
		lockRes = "собери все квадраты ошибок",
		lockTot = "поставь прямую на среднее и собери квадраты",
		lockR2 = "собери оба столбика",
	},

	-- ───── лор-задача ─────
	lore = {
		npcName = "Пасечник",
		promptTalk = "Поговорить",
		boardTitle = "Пять соседних пасек",
		tableHeader = "№   расст., м   пчёлы, тыс.   темп., °C   мёд, кг",
		tableRow = "%d   %9s   %11s   %9s   %7s",
		hiveName = "Улей %d",
		promptCount = "Посчитать пчёл",
		promptHarvest = "Собрать мёд",
		promptMeasure = "Измерить расстояние",
		meadowName = "Поляна улья %d",
		signText = "Поляна\nдо улья %d: %s м",
		cardTitle = "<b>Улей %d</b>",
		cardBees = "пчёлы: %s тыс.",
		cardDist = "до поляны: %s м",
		cardPred = "прогноз: %s",
		cardReal = "реально: %s (ошибка %s)",
		goToNpc = "Обучение завершено! Пасечник ждёт тебя — иди к лучу",
		columns = { "пасека", "расстояние, м", "пчёлы, тыс.", "температура, °C", "мёд, кг" },
		corrNote = "Корреляция пчёл и температуры: r = %s",
		npcSays = "«Помоги предсказать, сколько мёда дадут твои 5 ульев. Вот данные пяти соседних пасек: расстояние до ближайшей поляны, число пчёл и температура.\nТемпература влияет на мёд слабо и почти полностью повторяет число пчёл.\nКакой метод возьмёшь?»",
		methods = {
			{ id = "ols", label = "OLS — обычная регрессия", reply = "OLS возьмёт температуру в модель и на 5 пасеках раскачает коэффициенты. Вспомни 2D.5: какой из штрафов умеет обнулять лишний признак?" },
			{ id = "l2", label = "Ridge (L2)", reply = "Ridge уменьшит коэффициенты, но температуру не выключит — у круга нет углов. Какой из штрафов умеет обнулять лишний признак?" },
			{ id = "l1", label = "Lasso (L1)", reply = "" },
		},
		methodOk = "Верно: Lasso выключит лишний признак",
		toWorld = "Собирать данные  →",
		coefsTitle = "Коэффициенты (в единицах sd)",
		coefsAxis = "кг на 1 sd",
		train = "Обучить",
		lambdaGiven = "Пасечник: «λ = %s. Я подобрал его так, чтобы прогнозы для твоей пасеки попадали в правдоподобный диапазон 20–40 кг мёда». Нажми «Обучить».",
		lambdaWhy = "λ = %s подобрано так, чтобы прогнозы для пасеки попадали в правдоподобный диапазон 20–40 кг.",
		interpret = "Каждые 100 м до поляны — минус %s кг; каждая тысяча пчёл — плюс %s кг. Температура выключена L1 — измерять её не нужно.",
		lambdaTitle = "Сила штрафа",
		modelTitle = "Модель Lasso для мёда",
		lockTrain = "нажми «Обучить»",
		honeyWord = "мёд",
		distWord = "расстояние",
		beesWord = "пчёлы",
		featureNames = { "расстояние", "пчёлы", "температура" },
		tempOff = "выключена L1",
		beesCounted = "Улей %d: %s тыс. пчёл",
		distMeasured = "Поляна улья %d: %s м",
		enter = "Внести данные улья %d",
		helper = "🐝 Пчела-помощник: посчитать пчёл в остальных ульях",
		helperDone = "Пчела-помощник посчитала пчёл. До полян придётся дойти самому!",
		predicted = "Прогноз для улья %d: %s",
		season = "Прошёл сезон! Собери мёд у каждого улья",
		harvested = "Улей %d: собрано %s (прогноз %s)",
		finish = "Завершить модуль",
		hiveAxis = "улей №",
		whatIfOls = "А если бы OLS?",
		olsResult = "Прогнозы OLS: %s кг. R² = %s — хуже, чем просто предсказывать среднее!\nУ OLS коэффициент пчёл вышел отрицательным (%s), а температуры — огромным (%s): на пяти пасеках с почти одинаковыми признаками он «раскачался».",
		olsNote = "На малых данных с похожими признаками L1 спасает прогноз: лишний признак выключен, коэффициенты не раскачиваются.",
		r2Done = "R² близок к 1: модель Lasso хорошо предсказала мёд твоих ульев. А что было бы с обычной регрессией?",
		moduleDone = "Модуль «Регрессия» пройден! +3 мёда",
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[--!strict
-- Theme: палитра Okabe–Ito (различима при дальтонизме), шрифты, размеры.

local Theme = {}

Theme.hex = {
	c = "#E69F00", -- свободный член, высота прямой
	m = "#0072B2", -- наклон
	mText = "#3D9BE0", -- наклон в тексте на тёмном фоне (тот же тон, светлее для контраста)
	m_temp = "#009E73", -- коэффициент температуры
	m_dist = "#999999", -- коэффициент расстояния (лор)
	residual = "#D55E00", -- ошибки и их квадраты
	mean = "#7F7F7F", -- средние, ось вращения
	penalty = "#CC79A7", -- λ, штраф
	loss = "#56B4E9", -- функция потерь, записи на графике
	good = "#009E73",
	text = "#EDEDED",
	textDim = "#A0A0AA",
}

local function hex(s: string): Color3
	return Color3.fromHex(s)
end

Theme.color = {
	c = hex(Theme.hex.c),
	m = hex(Theme.hex.m),
	mText = hex(Theme.hex.mText),
	m_temp = hex(Theme.hex.m_temp),
	m_dist = hex(Theme.hex.m_dist),
	residual = hex(Theme.hex.residual),
	mean = hex(Theme.hex.mean),
	penalty = hex(Theme.hex.penalty),
	loss = hex(Theme.hex.loss),
	good = hex(Theme.hex.good),
	text = hex(Theme.hex.text),
	textDim = hex(Theme.hex.textDim),

	bg = hex("#1E1E24"),
	panel = hex("#2A2A33"),
	panel2 = hex("#34343F"),
	grid = hex("#3A3A46"),
	axis = hex("#8A8A96"),
	line = hex("#F4F4F4"), -- прямая в мире
	flag = hex("#FFFFFF"),

	-- Мир
	soil = hex("#5B3A29"),
	wood = hex("#8B5A2B"),
	stem = hex("#3F7D3A"),
	flowerCore = hex("#F2C14E"),
	boardFrame = hex("#2B2B2B"),
	petals = { hex("#E86A92"), hex("#9B7FE6"), hex("#F28C38"), hex("#5BC0EB"), hex("#F2F2F2") },
}

-- Builder Sans — фирменный шрифт Roblox; проверь глифы Σ ŷ λ ² − на ПК и телефоне
Theme.font = Enum.Font.BuilderSans
Theme.fontMedium = Enum.Font.BuilderSansMedium
Theme.fontBold = Enum.Font.BuilderSansBold

Theme.size = {
	touch = 44, -- минимальная зона касания
	hudText = 20,
	hudSmall = 16,
}

-- RichText-обёртка цветом токена
function Theme.tok(name: string, text: string): string
	local h = Theme.hex[name] or Theme.hex.text
	return ('<font color="%s">%s</font>'):format(h, text)
end

return Theme
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Viewport3D</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Viewport3D: интерактивная 3D-сцена в ViewportFrame (2D.4).
--   Орбитальная камера: перетаскивание (мышь / один палец) — поворот, колесо / щипок — зум, reset() — исходный вид.
--   Подписи и выделение — 2D-оверлей поверх кадра; позиции считаются проекцией (без Mouse.Target и
--   ViewportPointToRay — они работают в координатах экрана, а не фрейма).
--   Тап без перетаскивания → onTap(pos), pos — пиксели внутри фрейма.

local UserInputService = game:GetService("UserInputService")

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Drag = require(Regression.UI.Drag)

local Viewport3D = {}
Viewport3D.__index = Viewport3D

local TAP_PX = 8

function Viewport3D.new(parent: GuiObject, opts)
	local self = setmetatable({}, Viewport3D)
	opts = opts or {}
	self.center = opts.center or Vector3.zero
	self.home = { yaw = opts.yaw or math.rad(35), pitch = opts.pitch or math.rad(22), radius = opts.radius or 16 }
	self.yaw, self.pitch, self.radius = self.home.yaw, self.home.pitch, self.home.radius
	self.minR, self.maxR = opts.minRadius or 8, opts.maxRadius or 32
	self.totalYaw = 0 -- накопленный поворот, градусы (2D.4: «повернуть облако минимум на 90°»)
	self.onTap = nil :: ((Vector2) -> ())?
	self.onCamera = nil :: (() -> ())?

	self.frame = Gui.make("ViewportFrame", {
		Name = "Viewport3D", BackgroundColor3 = Theme.color.panel, BorderSizePixel = 0, Size = opts.size or UDim2.fromScale(1, 1),
		Position = opts.position or UDim2.new(), Ambient = Color3.fromRGB(170, 170, 180), LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-0.4, -1, -0.6), Parent = parent,
	})
	Gui.corner().Parent = self.frame
	self.world = Gui.make("WorldModel", { Parent = self.frame })
	self.camera = Gui.make("Camera", { FieldOfView = 50, Parent = self.frame })
	self.frame.CurrentCamera = self.camera
	self.overlay = Gui.frame({ Name = "Overlay", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = self.frame })

	local start, last, moved
	self.drag = Drag.attach(self.frame, {
		began = function(p)
			start, last, moved = p, p, false
			return true
		end,
		moved = function(p)
			if not last then
				return
			end
			local d = p - last
			last = p
			if (p - start).Magnitude > TAP_PX then
				moved = true
			end
			local dyaw = -d.X * 0.008
			self.yaw += dyaw
			self.totalYaw += math.deg(math.abs(dyaw))
			self.pitch = math.clamp(self.pitch + d.Y * 0.006, math.rad(-10), math.rad(80))
			self:updateCamera()
		end,
		ended = function(p)
			if start and not moved and self.onTap then
				local a = self.frame.AbsolutePosition
				self.onTap(Vector2.new(start.X - a.X, start.Y - a.Y))
			end
			start, last = nil, nil
		end,
	})
	self.conns = {}
	table.insert(self.conns, self.frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			self:zoom(-input.Position.Z * 1.5)
		end
	end))
	table.insert(self.conns, UserInputService.TouchPinch:Connect(function(_, scale, _, state)
		if self.frame.Visible and state == Enum.UserInputState.Change and scale and scale > 0 then
			self:zoom((1 - scale) * 4)
		end
	end))
	self:updateCamera()
	return self
end

function Viewport3D:zoom(d: number)
	self.radius = math.clamp(self.radius + d, self.minR, self.maxR)
	self:updateCamera()
end

function Viewport3D:reset()
	self.yaw, self.pitch, self.radius = self.home.yaw, self.home.pitch, self.home.radius
	self:updateCamera()
end

function Viewport3D:updateCamera()
	local cp = math.cos(self.pitch)
	local offset = Vector3.new(math.sin(self.yaw) * cp, math.sin(self.pitch), math.cos(self.yaw) * cp) * self.radius
	self.camera.CFrame = CFrame.lookAt(self.center + offset, self.center)
	if self.onCamera then
		self.onCamera()
	end
end

-- Мировая точка → пиксели внутри фрейма; visible = false, если за камерой
function Viewport3D:project(worldPos: Vector3): (number, number, boolean)
	local cam = self.camera
	local p = cam.CFrame:PointToObjectSpace(worldPos) -- камера смотрит по −Z
	if p.Z >= -0.05 then
		return 0, 0, false
	end
	local size = self.frame.AbsoluteSize
	local w, h = if size.X > 1 then size.X else 600, if size.Y > 1 then size.Y else 420
	local tanY = math.tan(math.rad(cam.FieldOfView) / 2) -- FieldOfView — вертикальный угол
	local aspect = w / h
	local nx = (p.X / -p.Z) / (tanY * aspect)
	local ny = (p.Y / -p.Z) / tanY
	return (nx + 1) / 2 * w, (1 - ny) / 2 * h, true
end

-- Тонкая деталь в мире вьюпорта
function Viewport3D:part(props)
	local defaults = { Parent = self.world }
	for k, v in props or {} do
		defaults[k] = v
	end
	return Gui.part(defaults)
end

-- Отрезок-брусок между двумя точками (переиспользуемый: передай существующий part)
function Viewport3D:segment(part: BasePart?, a: Vector3, b: Vector3, thickness: number, color: Color3)
	local p = part or self:part({ Material = Enum.Material.SmoothPlastic })
	local len = (b - a).Magnitude
	if len < 1e-3 then
		p.Transparency = 1
		return p
	end
	p.Transparency = 0
	if math.abs((b - a).Unit.Y) > 0.99 then
		-- вертикаль: lookAt с осью вверх вырождается
		p.Size = Vector3.new(thickness, len, thickness)
		p.CFrame = CFrame.new((a + b) / 2)
	else
		p.Size = Vector3.new(thickness, thickness, len)
		p.CFrame = CFrame.lookAt((a + b) / 2, b)
	end
	p.Color = color
	return p
end

function Viewport3D:Destroy()
	self.drag.Destroy()
	for _, c in self.conns do
		c:Disconnect()
	end
	self.frame:Destroy()
end

return Viewport3D
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="55">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Flowerbed</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Flowerbed: клумба в мире (локально у игрока): грядка, оси, 5 цветков, прямая, нити, квадраты, пульт.
-- Система координат: origin — центр клумбы на уровне земли; локальная X — вдоль клумбы (ось x данных),
-- локальная −Z — поперёк от игрока (ось y данных), Y — вверх. 1 м = Config.STUDS_PER_M studs.
-- Всё создаётся один раз; при движении прямой меняются только CFrame/Size/Transparency.

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local BedGeometry = require(Regression.Core.BedGeometry)
local Format = require(Regression.Core.Format)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)

local Flowerbed = {}
Flowerbed.__index = Flowerbed

local LINE_LIFT = 0.18
local THREAD_LIFT = 0.22
local SQUARE_LIFT = 0.04

function Flowerbed.new(args)
	local self = setmetatable({}, Flowerbed)
	local fb = args.data
	self.origin = args.origin :: CFrame
	self.W, self.H = fb.bed_length_m, fb.bed_width_m
	self.x, self.y, self.n = fb.x_m, fb.y_m, #fb.x_m
	self.pivotX = fb.pivot_x_m
	self.S = Config.STUDS_PER_M
	self.surface = 0.4
	self.model = Gui.make("Model", { Name = "RegressionFlowerbed" })
	self.flowers = {}
	self.threads, self.threadLabels, self.squares = {}, {}, {}
	self.cards = {}
	self.cardPinned, self.cardHover = {}, nil
	self:_buildBed()
	self:_buildFlowers()
	self:_buildLine()
	self:_buildResiduals()
	self:_buildPedestal()
	self.model.Parent = args.parent
	return self
end

-- ───── координаты ─────

function Flowerbed:localPos(x: number, y: number, lift: number?): Vector3
	return Vector3.new((x - self.W / 2) * self.S, self.surface + (lift or 0), -(y - self.H / 2) * self.S)
end

function Flowerbed:toWorld(x: number, y: number, lift: number?): Vector3
	return self.origin:PointToWorldSpace(self:localPos(x, y, lift))
end

function Flowerbed:cfAt(x: number, y: number, lift: number?): CFrame
	return self.origin * CFrame.new(self:localPos(x, y, lift))
end

-- Позиция игрока относительно клумбы → расстояние до её прямоугольника (studs)
function Flowerbed:distanceTo(worldPos: Vector3): number
	local p = self.origin:PointToObjectSpace(worldPos)
	return BedGeometry.distToRect(p.X, p.Z, self.W * self.S / 2, self.H * self.S / 2)
end

function Flowerbed:_attach(x: number, y: number, lift: number?): Attachment
	local a = Instance.new("Attachment")
	a.Parent = self.soil
	a.WorldPosition = self:toWorld(x, y, lift)
	return a
end

-- ───── построение ─────

function Flowerbed:_buildBed()
	local L, D = self.W * self.S, self.H * self.S
	local o = self.origin
	self.soil = Gui.part({
		Name = "Soil", Size = Vector3.new(L, 0.4, D), CFrame = o * CFrame.new(0, 0.2, 0),
		Color = Theme.color.soil, Material = Enum.Material.Ground, CanCollide = true, Parent = self.model,
	})
	for _, b in {
		{ Vector3.new(L + 1, 0.7, 0.5), Vector3.new(0, 0.35, D / 2 + 0.25) },
		{ Vector3.new(L + 1, 0.7, 0.5), Vector3.new(0, 0.35, -(D / 2 + 0.25)) },
		{ Vector3.new(0.5, 0.7, D), Vector3.new(L / 2 + 0.25, 0.35, 0) },
		{ Vector3.new(0.5, 0.7, D), Vector3.new(-(L / 2 + 0.25), 0.35, 0) },
	} do
		Gui.part({
			Name = "Border", Size = b[1], CFrame = o * CFrame.new(b[2]),
			Color = Theme.color.wood, Material = Enum.Material.Wood, CanCollide = true, Parent = self.model,
		})
	end

	-- Оси данных на земле: x вдоль ближнего края (y = 0), y вдоль левого края (x = 0)
	Gui.part({ Name = "AxisX", Size = Vector3.new(L, 0.04, 0.1), CFrame = self:cfAt(self.W / 2, 0, 0.02), Color = Theme.color.axis, Parent = self.model })
	Gui.part({ Name = "AxisY", Size = Vector3.new(0.1, 0.04, D), CFrame = self:cfAt(0, self.H / 2, 0.02), Color = Theme.color.axis, Parent = self.model })
	local function tick(x: number, y: number, text: string)
		Gui.billboard(self:_attach(x, y, 0.5), text, { Size = UDim2.fromOffset(60, 26), StudsOffsetWorldSpace = Vector3.zero, MaxDistance = 45 })
	end
	for i = 0, self.W do
		tick(i, -0.2, tostring(i))
	end
	for i = 1, self.H do
		tick(-0.2, i, tostring(i))
	end
	tick(self.W + 0.45, 0, "x, м")
	tick(0, self.H + 0.3, "y, м")

	-- Пунктир x = x̄ — ось вращения прямой (цвет «среднее»)
	local z = 0
	while z < self.H - 0.05 do
		Gui.part({ Name = "MeanDash", Size = Vector3.new(0.07, 0.03, 0.12 * self.S), CFrame = self:cfAt(self.pivotX, z + 0.06, 0.015), Color = Theme.color.mean, Parent = self.model })
		z += 0.25
	end
end

function Flowerbed:_buildFlowers()
	for i = 1, self.n do
		local x, y = self.x[i], self.y[i]
		local base = self:cfAt(x, y, 0)
		local flower = Gui.make("Model", { Name = "Flower" .. i })
		Gui.part({ Name = "Point", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.08, 0.8, 0.8),
			CFrame = base * CFrame.new(0, 0.04, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(25, 25, 25), Parent = flower })
		Gui.part({ Name = "Stem", Size = Vector3.new(0.22, 2.2, 0.22), CFrame = base * CFrame.new(0, 1.1, 0), Color = Theme.color.stem, CanQuery = true, Parent = flower })
		Gui.part({ Name = "Leaf", Size = Vector3.new(0.7, 0.08, 0.32), CFrame = base * CFrame.new(0.32, 0.8, 0) * CFrame.Angles(0, 0, math.rad(25)), Color = Theme.color.stem, Parent = flower })
		local head = Gui.part({ Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(0.62, 0.62, 0.62),
			CFrame = base * CFrame.new(0, 2.45, 0), Color = Theme.color.flowerCore, CanQuery = true, Parent = flower })
		local petal = Theme.color.petals[(i - 1) % #Theme.color.petals + 1]
		for k = 0, 5 do
			local a = k * math.pi / 3
			Gui.part({ Name = "Petal", Shape = Enum.PartType.Ball, Size = Vector3.new(0.55, 0.55, 0.3),
				CFrame = base * CFrame.new(math.cos(a) * 0.48, 2.45 + math.sin(a) * 0.48, -0.05), Color = petal, CanQuery = true, Parent = flower })
		end
		Gui.billboard(head, tostring(i), { Size = UDim2.fromOffset(30, 30), StudsOffsetWorldSpace = Vector3.new(0, 1.0, 0), MaxDistance = 50 })

		local prompt = Gui.make("ProximityPrompt", {
			ActionText = Strings.prompt.thread,
			ObjectText = Strings.prompt.flower:format(i),
			KeyboardKeyCode = Enum.KeyCode.F,
			HoldDuration = 0,
			MaxActivationDistance = 10,
			RequiresLineOfSight = false,
			Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton,
			Enabled = false,
			Parent = head,
		})
		flower.Parent = self.model
		self.flowers[i] = { model = flower, head = head, prompt = prompt }
		self:_buildCard(i, head)
	end
end

function Flowerbed:_buildCard(i: number, head: BasePart)
	local bb = Gui.make("BillboardGui", {
		Name = "Card", Adornee = head, Size = UDim2.fromOffset(270, 214), StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0),
		AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 80, Enabled = false, ResetOnSpawn = false,
	})
	local bg = Gui.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.08, Parent = bb })
	Gui.corner().Parent = bg
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), Parent = bg })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = bg })
	Gui.label({ Text = Strings.card.title:format(i), Font = Theme.fontBold, TextSize = 20, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 0, Parent = bg })
	local values = {}
	for order, key in { "x", "y", "yhat", "e", "e2", "share" } do
		local row = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = bg })
		Gui.label({ Text = Strings.card[key], TextSize = 17, TextColor3 = Theme.color.textDim, Size = UDim2.fromScale(0.6, 1), Parent = row })
		values[key] = Gui.label({ TextSize = 18, Font = Theme.fontBold, TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromScale(0.4, 1), Position = UDim2.fromScale(0.6, 0), Parent = row })
	end
	bb.Parent = head
	self.cards[i] = { gui = bb, values = values }
end

function Flowerbed:_buildLine()
	self.line = Gui.part({ Name = "Line", Size = Vector3.new(0.25, 0.25, 1), Color = Theme.color.line, Material = Enum.Material.Neon, Parent = self.model })
	-- Ось вращения (x̄; h): оранжевый — «высота прямой»
	self.pivot = Gui.part({ Name = "Pivot", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), Color = Theme.color.c, Parent = self.model })
	-- Метка высоты на оси y
	self.hTick = Gui.part({ Name = "HeightTick", Size = Vector3.new(0.6, 0.08, 0.18), Color = Theme.color.c, Parent = self.model })
end

function Flowerbed:_buildResiduals()
	for i = 1, self.n do
		local t = Gui.part({ Name = "Thread" .. i, Size = Vector3.new(0.15, 0.15, 1), Color = Theme.color.residual, Transparency = 1, Parent = self.model })
		local bb, lbl = Gui.billboard(t, "", { Size = UDim2.fromOffset(150, 30), StudsOffsetWorldSpace = Vector3.new(0, 1.3, 0), Enabled = false })
		lbl.TextColor3 = Theme.color.residual
		self.threads[i] = t
		self.threadLabels[i] = { gui = bb, label = lbl }
		self.squares[i] = Gui.part({ Name = "Square" .. i, Size = Vector3.new(1, 0.05, 1), Color = Theme.color.residual, Transparency = 1, Parent = self.model })
	end
end

function Flowerbed:_buildPedestal()
	local D = self.H * self.S
	local o = self.origin
	local post = Gui.part({ Name = "Pedestal", Size = Vector3.new(1.6, 2.6, 1.0), CFrame = o * CFrame.new(0, 1.3, D / 2 + 3.5),
		Color = Theme.color.wood, Material = Enum.Material.Wood, CanCollide = true, Parent = self.model })
	local top = Gui.part({ Name = "PedestalTop", Size = Vector3.new(2.6, 0.2, 1.7),
		CFrame = o * CFrame.new(0, 2.7, D / 2 + 3.5) * CFrame.Angles(math.rad(25), 0, 0), Color = Theme.color.bg, Parent = self.model })
	local sg = Gui.make("SurfaceGui", { Face = Enum.NormalId.Top, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 60, LightInfluence = 0 })
	Gui.label({ Size = UDim2.fromScale(1, 1), Text = Strings.prompt.pedestal .. "\nQ/E · Shift/Ctrl", TextSize = 26, Font = Theme.fontBold,
		TextXAlignment = Enum.TextXAlignment.Center, Parent = sg })
	sg.Parent = top
	self.pedestal = post
	self.controlPrompt = Gui.make("ProximityPrompt", {
		ActionText = Strings.prompt.control,
		ObjectText = Strings.prompt.pedestal,
		KeyboardKeyCode = Enum.KeyCode.F,
		HoldDuration = 0,
		MaxActivationDistance = 10,
		RequiresLineOfSight = false,
		Enabled = false,
		Parent = post,
	})
end

-- ───── отрисовка ─────

-- snap: снимок LineModel; vis.threadGrow[i], vis.squareGrow[i] ∈ [0; 1]
function Flowerbed:render(snap, vis)
	local S = self.S
	local rot = self.origin.Rotation

	local x0, y0, x1, y1 = BedGeometry.clipLine(snap.m, snap.c, self.W, self.H)
	if x0 then
		local p0, p1 = self:toWorld(x0, y0, LINE_LIFT), self:toWorld(x1, y1, LINE_LIFT)
		self.line.Size = Vector3.new(0.25, 0.25, (p1 - p0).Magnitude)
		self.line.CFrame = CFrame.lookAt((p0 + p1) / 2, p1, self.origin.UpVector)
		self.line.Transparency = 0
	else
		self.line.Transparency = 1
	end
	self.pivot.CFrame = self:cfAt(self.pivotX, snap.h, LINE_LIFT)
	self.hTick.CFrame = self:cfAt(-0.1, snap.h, 0.05)

	for i = 1, self.n do
		local x, y, yhat = self.x[i], self.y[i], snap.yhat[i]
		local g = vis.threadGrow[i] or 0
		local t, tl = self.threads[i], self.threadLabels[i]
		if g > 0 then
			local _, ty0, _, ty1 = BedGeometry.thread(x, y, yhat, g)
			local len = math.abs(ty1 - ty0) * S
			if len < 0.03 then
				t.Transparency = 1
			else
				t.Transparency = 0
				t.Size = Vector3.new(0.15, 0.15, len)
				t.CFrame = CFrame.new(self:toWorld(x, (ty0 + ty1) / 2, THREAD_LIFT)) * rot
			end
			local e = snap.e[i]
			tl.gui.Enabled = g >= 1 and math.abs(e) >= 0.005
			tl.label.Text = "e = " .. Format.signed(e) .. Format.NBSP .. "м"
		else
			t.Transparency = 1
			tl.gui.Enabled = false
		end

		local sg = vis.squareGrow[i] or 0
		local sq = self.squares[i]
		if sg > 0 then
			local cx, cy, side = BedGeometry.square(x, y, yhat, self.pivotX, sg)
			if side * S < 0.03 then
				sq.Transparency = 1
			else
				sq.Transparency = 0.5
				sq.Size = Vector3.new(side * S, 0.05, side * S)
				sq.CFrame = CFrame.new(self:toWorld(cx, cy, SQUARE_LIFT)) * rot
			end
		else
			sq.Transparency = 1
		end
	end
	self:_renderCards(snap, vis)
end

function Flowerbed:_renderCards(snap, vis)
	local now = os.clock()
	for i, card in self.cards do
		local hovered = self.cardHover ~= nil and self.cardHover.i == i and now - self.cardHover.t >= 0.15
		local show = self.cardPinned[i] == true or hovered
		card.gui.Enabled = show
		if show then
			local v = card.values
			local hasThread = (vis.threadGrow[i] or 0) >= 1
			v.x.Text = Format.len(self.x[i])
			v.y.Text = Format.len(self.y[i])
			v.yhat.Text = Format.len(snap.yhat[i])
			if hasThread then
				v.e.Text = Format.signed(snap.e[i]) .. Format.NBSP .. "м"
				v.e2.Text = Format.area(snap.sq[i])
				v.share.Text = if snap.L > 1e-12 then Format.percent(snap.sq[i] / snap.L) else "—"
			else
				v.e.Text, v.e2.Text, v.share.Text = "?", "?", "?"
			end
		end
	end
end

-- ───── карточки: наведение (ПК, 150 мс) и тап/клик (все устройства) ─────

function Flowerbed:toggleCard(i: number)
	self.cardPinned[i] = not self.cardPinned[i]
end

function Flowerbed:bindCards(onChanged: () -> ())
	local camera = workspace.CurrentCamera
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local models = {}
	for _, f in self.flowers do
		table.insert(models, f.model)
	end
	params.FilterDescendantsInstances = models

	local function pick(ray: Ray): number?
		local r = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
		if not r then
			return nil
		end
		for i, f in self.flowers do
			if r.Instance:IsDescendantOf(f.model) then
				return i
			end
		end
		return nil
	end

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp or input.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		local i = pick(camera:ScreenPointToRay(input.Position.X, input.Position.Y))
		if i then
			self:toggleCard(i)
			onChanged()
		end
	end)
	UserInputService.TouchTap:Connect(function(positions, gp)
		if gp or #positions == 0 then
			return
		end
		local p = positions[1]
		local i = pick(camera:ScreenPointToRay(p.X, p.Y))
		if i then
			self:toggleCard(i)
			onChanged()
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.05 or not UserInputService.MouseEnabled then
			return
		end
		acc = 0
		local m = UserInputService:GetMouseLocation()
		local i = pick(camera:ViewportPointToRay(m.X, m.Y))
		local cur = self.cardHover
		if i == nil then
			if cur then
				self.cardHover = nil
				onChanged()
			end
		elseif cur == nil or cur.i ~= i then
			self.cardHover = { i = i, t = os.clock() }
		elseif os.clock() - cur.t >= 0.15 and not cur.shown then
			cur.shown = true
			onChanged()
		end
	end)
end

return Flowerbed
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">LoreWorld</string>
            <string name="Source"><![CDATA[--!nonstrict
-- LoreWorld: пасека игрока для лор-задачи (локально у игрока).
--   Пасечник (NPC) с ProximityPrompt «Поговорить», табло «Пять соседних пасек»,
--   5 ульев игрока (ProximityPrompt «Посчитать пчёл» / «Собрать мёд», карточка над ульем),
--   у каждого улья — ближайшая поляна с табличкой расстояния и ProximityPrompt «Измерить расстояние».
-- Расстояния 200–2000 м пешком в Roblox не пройти: на табличке — сюжетная величина в метрах,
-- а путь в мире ей пропорционален (Config.LORE_STUDS_PER_M).
-- Система координат: origin — центр пасеки на земле; локальная +Z смотрит туда, откуда приходит игрок.

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local Format = require(Regression.Core.Format)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)

local LoreWorld = {}
LoreWorld.__index = LoreWorld

local S = Strings.lore
local HIVE_SPACING = 8
local HIVE_Z = 6
local MEADOW_ANGLES = { -18, 10, -8, 16, 0 } -- небольшой разброс направлений к полянам, градусы

local function prompt(parent: Instance, action: string, object: string, dist: number?): ProximityPrompt
	return Gui.make("ProximityPrompt", {
		ActionText = action, ObjectText = object, KeyboardKeyCode = Enum.KeyCode.F, HoldDuration = 0,
		MaxActivationDistance = dist or 10, RequiresLineOfSight = false, Enabled = false, Parent = parent,
	})
end

function LoreWorld.new(args)
	local self = setmetatable({}, LoreWorld)
	self.origin = args.origin :: CFrame
	self.data = args.data
	self.model = Gui.make("Model", { Name = "RegressionLore" })
	self.hives, self.meadows = {}, {}
	self:_buildNpc()
	self:_buildBoard()
	for i, h in self.data.player_hives do
		self:_buildHive(i, h)
	end
	self:_buildBeacon()
	self.model.Parent = args.parent
	return self
end

function LoreWorld:cf(x: number, y: number, z: number): CFrame
	return self.origin * CFrame.new(x, y, z)
end

-- Расстояние от точки до пасеки (центр), studs
function LoreWorld:distanceTo(p: Vector3): number
	local l = self.origin:PointToObjectSpace(p)
	return Vector3.new(l.X, 0, l.Z).Magnitude
end

function LoreWorld:_buildNpc()
	local npc = Gui.make("Model", { Name = "Beekeeper" })
	local base = self:cf(0, 0, 14) * CFrame.Angles(0, math.pi, 0)
	local body = Gui.part({ Name = "Body", Size = Vector3.new(2, 2.6, 1.2), CFrame = base * CFrame.new(0, 1.3 + 1.2, 0), Color = Color3.fromHex("#F2F2F2"),
		CanCollide = true, Parent = npc })
	Gui.part({ Name = "Legs", Size = Vector3.new(1.8, 1.2, 1), CFrame = base * CFrame.new(0, 0.6, 0), Color = Color3.fromHex("#3B4A6B"), Parent = npc })
	local head = Gui.part({ Name = "Head", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = base * CFrame.new(0, 4.4, 0),
		Color = Color3.fromHex("#E0B38C"), Parent = npc })
	Gui.part({ Name = "HatBrim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 2.6, 2.6), CFrame = base * CFrame.new(0, 5.0, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromHex("#E8DCA0"), Parent = npc })
	Gui.part({ Name = "Veil", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.0, 1.7, 1.7), CFrame = base * CFrame.new(0, 4.5, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromHex("#2B2B2B"), Transparency = 0.55, Parent = npc })
	Gui.billboard(head, S.npcName, { Size = UDim2.fromOffset(160, 30), StudsOffsetWorldSpace = Vector3.new(0, 1.8, 0) })
	npc.PrimaryPart = body
	npc.Parent = self.model
	self.npc = npc
	self.npcPrompt = prompt(body, S.promptTalk, S.npcName, 12)
end

function LoreWorld:_buildBoard()
	local cf = self:cf(8, 3.6, 14) * CFrame.Angles(0, 0, 0)
	local screen = Gui.part({ Name = "DataBoard", Size = Vector3.new(9, 5.2, 0.3), CFrame = cf, Color = Theme.color.bg, Parent = self.model })
	Gui.part({ Name = "Leg", Size = Vector3.new(0.4, 1.4, 0.4), CFrame = self:cf(8, 0.7, 14.05), Color = Theme.color.boardFrame, Parent = self.model })
	local sg = Gui.make("SurfaceGui", { Face = Enum.NormalId.Back, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 50,
		LightInfluence = 0, Parent = screen })
	local root = Gui.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.color.bg, Parent = sg })
	Gui.label({ Text = S.boardTitle, Font = Theme.fontBold, TextSize = 30, Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -32, 0, 40), Parent = root })
	local lines = { S.tableHeader }
	for _, a in self.data.train_apiaries do
		table.insert(lines, S.tableRow:format(a.apiary, Format.num(a.distance_to_meadow_m, 0), Format.num(a.bees_k, 1), Format.num(a.temperature_C, 1),
			Format.num(a.honey_kg, 1)))
	end
	Gui.label({ Text = table.concat(lines, "\n"), Font = Enum.Font.RobotoMono, TextSize = 22, Position = UDim2.fromOffset(16, 54),
		Size = UDim2.new(1, -32, 1, -64), TextYAlignment = Enum.TextYAlignment.Top, RichText = false, Parent = root })
	self.board = screen
end

function LoreWorld:_buildHive(i: number, h)
	local x = -2 * HIVE_SPACING + (i - 1) * HIVE_SPACING
	local hive = Gui.make("Model", { Name = "Hive" .. i })
	local base = self:cf(x, 0, HIVE_Z)
	Gui.part({ Name = "Stand", Size = Vector3.new(2.8, 0.6, 2.8), CFrame = base * CFrame.new(0, 0.3, 0), Color = Theme.color.wood, Material = Enum.Material.Wood, CanCollide = true, Parent = hive })
	local box = Gui.part({ Name = "Box", Size = Vector3.new(2.4, 2.4, 2.4), CFrame = base * CFrame.new(0, 1.8, 0), Color = Color3.fromHex("#E8B84A"), Material = Enum.Material.Wood,
		CanCollide = true, CanQuery = true, Parent = hive })
	for k = 1, 2 do
		Gui.part({ Name = "Stripe", Size = Vector3.new(2.45, 0.12, 2.45), CFrame = base * CFrame.new(0, 1.2 + k * 0.8 - 0.4, 0), Color = Color3.fromHex("#B8862B"), Parent = hive })
	end
	Gui.part({ Name = "Roof", Size = Vector3.new(3, 0.35, 3), CFrame = base * CFrame.new(0, 3.2, 0), Color = Color3.fromHex("#7A4E2D"), Parent = hive })
	Gui.part({ Name = "Entrance", Size = Vector3.new(0.9, 0.2, 0.05), CFrame = base * CFrame.new(0, 0.9, 1.22), Color = Color3.fromHex("#2B1A0E"), Parent = hive })
	Gui.billboard(box, S.hiveName:format(i), { Size = UDim2.fromOffset(120, 28), StudsOffsetWorldSpace = Vector3.new(0, 2.4, 0) })
	-- карточка улья: данные, прогноз, реальный мёд
	local card = Gui.make("BillboardGui", { Name = "Card", Adornee = box, Size = UDim2.fromOffset(230, 0), StudsOffsetWorldSpace = Vector3.new(0, 5.2, 0),
		AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 70, Enabled = false, ResetOnSpawn = false, Parent = box })
	local cardLabel = Gui.label({ Size = UDim2.fromOffset(230, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.1,
		TextSize = 18, Parent = card })
	Gui.corner().Parent = cardLabel
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = cardLabel })
	card.Size = UDim2.fromOffset(230, 130)
	hive.PrimaryPart = box
	hive.Parent = self.model
	local hp = prompt(box, S.promptCount, S.hiveName:format(i), 9)

	-- поляна: путь в мире пропорционален сюжетному расстоянию
	local d = h.distance_to_meadow_m * Config.LORE_STUDS_PER_M + 4
	local a = math.rad(MEADOW_ANGLES[i] or 0)
	local mx, mz = x + math.sin(a) * d, HIVE_Z - math.cos(a) * d
	local meadow = Gui.make("Model", { Name = "Meadow" .. i })
	local mcf = self:cf(mx, 0, mz)
	Gui.part({ Name = "Grass", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.2, 6, 6), CFrame = mcf * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromHex("#6BBF59"), Material = Enum.Material.Grass, Parent = meadow })
	for k = 1, 7 do
		local ang = k * 2.4
		local r = 0.8 + (k % 3) * 0.75
		Gui.part({ Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.new(0.45, 0.45, 0.45),
			CFrame = mcf * CFrame.new(math.cos(ang) * r, 0.6, math.sin(ang) * r), Color = Theme.color.petals[(k - 1) % #Theme.color.petals + 1], Parent = meadow })
	end
	local post = Gui.part({ Name = "SignPost", Size = Vector3.new(0.3, 2.2, 0.3), CFrame = mcf * CFrame.new(2.6, 1.1, 0), Color = Theme.color.wood, Parent = meadow })
	local sign = Gui.part({ Name = "Sign", Size = Vector3.new(3.2, 1.3, 0.15), CFrame = mcf * CFrame.new(2.6, 2.5, 0) * CFrame.Angles(0, math.pi, 0), Color = Theme.color.wood, Parent = meadow })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local sg = Gui.make("SurfaceGui", { Face = face, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 50, LightInfluence = 0, Parent = sign })
		Gui.label({ Size = UDim2.fromScale(1, 1), Text = S.signText:format(i, Format.num(h.distance_to_meadow_m, 0)), Font = Theme.fontBold, TextSize = 24,
			TextColor3 = Color3.fromHex("#2B1A0E"), TextXAlignment = Enum.TextXAlignment.Center, Parent = sg })
	end
	-- тропинка от улья к поляне
	local from, to = self:cf(x, 0, HIVE_Z).Position, mcf.Position
	local steps = math.max(2, math.floor((to - from).Magnitude / 2.2))
	for k = 1, steps - 1 do
		local p = from:Lerp(to, k / steps)
		Gui.part({ Name = "Path", Size = Vector3.new(0.9, 0.05, 0.9), CFrame = CFrame.new(p + Vector3.new(0, 0.03, 0)) * self.origin.Rotation,
			Color = Color3.fromHex("#C9B48A"), Parent = meadow })
	end
	meadow.Parent = self.model
	local mp = prompt(post, S.promptMeasure, S.meadowName:format(i), 8)
	self.hives[i] = { model = hive, box = box, prompt = hp, card = card, cardLabel = cardLabel }
	self.meadows[i] = { model = meadow, prompt = mp, post = post, sign = sign }
end

function LoreWorld:_buildBeacon()
	self.beacon = Gui.part({ Name = "Beacon", Shape = Enum.PartType.Cylinder, Size = Vector3.new(40, 1.2, 1.2), Color = Theme.color.c,
		Material = Enum.Material.Neon, Transparency = 1, Parent = self.model })
end

-- Луч-ориентир над целью (nil — спрятать)
function LoreWorld:setBeacon(target: BasePart?)
	if target then
		self.beacon.CFrame = CFrame.new(target.Position + Vector3.new(0, 20, 0)) * CFrame.Angles(0, 0, math.rad(90))
		self.beacon.Transparency = 0.45
	else
		self.beacon.Transparency = 1
	end
end

function LoreWorld:setCard(i: number, text: string?)
	local h = self.hives[i]
	h.card.Enabled = text ~= nil
	if text then
		h.cardLabel.Text = text
	end
end

-- Все ProximityPrompt пасеки (для отключения на время режима управления прямой)
function LoreWorld:prompts(): { ProximityPrompt }
	local out = { self.npcPrompt }
	for i = 1, #self.hives do
		table.insert(out, self.hives[i].prompt)
		table.insert(out, self.meadows[i].prompt)
	end
	return out
end

return LoreWorld
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">NextBoard</string>
            <string name="Source"><![CDATA[--!nonstrict
-- NextBoard: второе табло (3D.6). Скрыто до вызова rise(): поднимается из-под земли за ≤ 2 с,
-- на экране — превью параболы игрока; ProximityPrompt «Продолжить обучение» открывает 2D experience.

local TweenService = game:GetService("TweenService")

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)

local NextBoard = {}
NextBoard.__index = NextBoard

local W_STUDS, H_STUDS = 14, 7.875 -- 700 × 394 px при 50 px/stud

-- args: parent, cframe (итоговый центр экрана), groundY, playerGui, onContinue
function NextBoard.new(args)
	local self = setmetatable({}, NextBoard)
	self.parent = args.parent
	self.finalCF = args.cframe :: CFrame
	self.model = Gui.make("Model", { Name = "RegressionNextBoard" })
	local cf = self.finalCF
	self.screen = Gui.part({ Name = "Screen", Size = Vector3.new(W_STUDS, H_STUDS, 0.4), CFrame = cf, Color = Theme.color.bg, Parent = self.model })
	Gui.part({ Name = "Frame", Size = Vector3.new(W_STUDS + 0.8, H_STUDS + 0.8, 0.3), CFrame = cf * CFrame.new(0, 0, 0.3),
		Color = Theme.color.boardFrame, Parent = self.model })
	local legH = (cf.Position.Y - H_STUDS / 2) - args.groundY + 0.4
	Gui.part({ Name = "Leg", Size = Vector3.new(0.8, legH, 0.8), CFrame = cf * CFrame.new(0, -H_STUDS / 2 - legH / 2 + 0.4, 0.45),
		Color = Theme.color.boardFrame, CanCollide = true, Parent = self.model })
	self.model.PrimaryPart = self.screen
	self.depth = H_STUDS + legH + 1 -- на сколько опустить под землю

	self.prompt = Gui.make("ProximityPrompt", {
		ActionText = Strings.prompt.continue,
		ObjectText = Strings.prompt.board2,
		KeyboardKeyCode = Enum.KeyCode.F,
		HoldDuration = 0,
		MaxActivationDistance = 16,
		RequiresLineOfSight = false,
		Enabled = false,
		Parent = self.screen,
	})
	self.prompt.Triggered:Connect(function()
		if args.onContinue then
			args.onContinue()
		end
	end)

	self.gui = Gui.make("SurfaceGui", {
		Name = "RegressionNextBoardGui", Adornee = self.screen, Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 50, LightInfluence = 0,
		ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Enabled = false, Parent = args.playerGui,
	})
	local root = Gui.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.color.bg, Parent = self.gui })
	Gui.label({ Position = UDim2.fromOffset(24, 12), Size = UDim2.fromOffset(660, 44), Text = Strings.screen2d.boardTitle,
		TextSize = 36, Font = Theme.fontBold, Parent = root })
	Gui.label({ Position = UDim2.fromOffset(24, 56), Size = UDim2.fromOffset(300, 300), Text = Strings.screen2d.boardBody .. "\n\n<b>dL/dm = 0</b>",
		TextSize = 26, TextYAlignment = Enum.TextYAlignment.Top, Parent = root })
	local holder = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(330, 60), Size = UDim2.fromOffset(360, 320), Parent = root })
	self.plot = PlotView2D.new(holder, {
		xMin = -1, xMax = 1.5, yMin = 0, yMax = 2,
		xTicks = { -1, 0, 1 }, yTicks = { 0, 1, 2 },
		padL = 40, padR = 8, padT = 12, padB = 36, fontSize = 18,
		fallbackW = 312, fallbackH = 272,
	})
	return self
end

function NextBoard:setParabola(P, records)
	local L = self.plot:layer("parabola", 3)
	L:begin()
	if P then
		L:curve(function(m)
			return P.a * m * m + P.b * m + P.k
		end, -1, 1.5, 80, { color = Theme.color.loss, thickness = 3 })
		L:dashedV(P.tStar, 0, P.vStar, { color = Theme.color.flag, thickness = 2 })
		for _, r in records or {} do
			L:dot(r.m, r.mse, { color = Theme.color.loss, size = 12 })
		end
		L:dot(P.tStar, P.vStar, { color = Theme.color.flag, size = 14 })
	end
	L:finish()
end

function NextBoard:rise(onDone: (() -> ())?)
	local target = self.finalCF
	self.model:PivotTo(target * CFrame.new(0, -self.depth, 0))
	self.model.Parent = self.parent
	self.gui.Enabled = true
	local v = Instance.new("CFrameValue")
	v.Value = target * CFrame.new(0, -self.depth, 0)
	v.Changed:Connect(function(cf)
		self.model:PivotTo(cf)
	end)
	local tw = TweenService:Create(v, TweenInfo.new(Config.BOARD2_RISE_S, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = target })
	tw.Completed:Connect(function()
		v:Destroy()
		self.prompt.Enabled = true
		if onDone then
			onDone()
		end
	end)
	tw:Play()
end

return NextBoard
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">Scoreboard</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Scoreboard: табло у клумбы. Part-экран + SurfaceGui в PlayerGui (иначе кнопки на нём не нажимаются).
-- Слева — параметры (m, h и c, ŷ, MSE, λ), сообщение шага и кнопка записи; справа — график «MSE от наклона»:
-- живой маркер текущей прямой, записи, бледные записи другой высоты, парабола и флажок минимума.

local Regression = script.Parent.Parent
local Records = require(Regression.Core.Records)
local Format = require(Regression.Core.Format)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)

local Scoreboard = {}
Scoreboard.__index = Scoreboard

local PPS = 50 -- пикселей на stud
local W_STUDS, H_STUDS = 20, 11.25 -- 1000 × 562 px

-- args: parent, cframe (центр экрана, −Z смотрит на игрока), playerGui, onRecord
function Scoreboard.new(args)
	local self = setmetatable({}, Scoreboard)
	self.onRecord = args.onRecord
	self.model = Gui.make("Model", { Name = "RegressionScoreboard" })
	local cf = args.cframe :: CFrame
	self.screen = Gui.part({ Name = "Screen", Size = Vector3.new(W_STUDS, H_STUDS, 0.4), CFrame = cf, Color = Theme.color.bg, Parent = self.model })
	Gui.part({ Name = "Frame", Size = Vector3.new(W_STUDS + 0.8, H_STUDS + 0.8, 0.3), CFrame = cf * CFrame.new(0, 0, 0.3),
		Color = Theme.color.boardFrame, Parent = self.model })
	local bottomY = cf.Position.Y - H_STUDS / 2
	local groundY = args.groundY or (bottomY - 1.5)
	for _, dx in { -W_STUDS / 2 + 1.5, W_STUDS / 2 - 1.5 } do
		local legH = bottomY - groundY + 0.4
		Gui.part({ Name = "Leg", Size = Vector3.new(0.6, legH, 0.6), CFrame = cf * CFrame.new(dx, -H_STUDS / 2 - legH / 2 + 0.4, 0.45),
			Color = Theme.color.boardFrame, CanCollide = true, Parent = self.model })
	end
	self.model.Parent = args.parent

	self.gui = Gui.make("SurfaceGui", {
		Name = "RegressionScoreboardGui",
		Adornee = self.screen,
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = PPS,
		LightInfluence = 0,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = args.playerGui,
	})
	self:_buildLeft()
	self:_buildPlot()
	self:_buildIdle()
	return self
end

function Scoreboard:_buildLeft()
	local root = Gui.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.color.bg, Parent = self.gui })
	self.root = root
	local function row(y: number, h: number, size: number, bold: boolean?)
		return Gui.label({ Position = UDim2.fromOffset(28, y), Size = UDim2.fromOffset(380, h), TextSize = size,
			Font = if bold then Theme.fontBold else Theme.font, Parent = root })
	end
	self.title = row(12, 44, 32, true)
	self.title.Text = Strings.boardTitle
	self.rowM = row(66, 42, 32, true)
	self.rowH = row(110, 42, 28)
	self.rowEq = row(152, 36, 26)
	self.rowMse = row(192, 48, 36, true)
	self.rowMseFormula = row(240, 32, 22)
	self.rowLambda = row(276, 34, 24)
	self.message = row(316, 118, 24)
	self.message.TextYAlignment = Enum.TextYAlignment.Top
	self.message.TextScaled = true -- длинные сообщения ужимаются, но не крупнее 24 px
	Gui.make("UITextSizeConstraint", { MaxTextSize = 24, MinTextSize = 16, Parent = self.message })
	self.message.TextColor3 = Theme.color.text

	self.recordBtn = Gui.button({
		Position = UDim2.fromOffset(28, 444), Size = UDim2.fromOffset(372, 58), TextSize = 28,
		BackgroundColor3 = Theme.color.loss, TextColor3 = Theme.color.bg, Text = Strings.recordBtn, Visible = false, Parent = root,
	})
	self.recordBtn.Activated:Connect(function()
		if self.onRecord then
			self.onRecord()
		end
	end)
	self.recordCounter = row(508, 40, 24)
	self.recordCounter.TextColor3 = Theme.color.textDim
end

function Scoreboard:_buildPlot()
	local holder = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(420, 14), Size = UDim2.fromOffset(566, 534), Parent = self.root })
	Gui.label({ Text = Strings.plotTitle, Position = UDim2.fromOffset(64, 0), Size = UDim2.fromOffset(480, 30), TextSize = 26,
		Font = Theme.fontBold, Parent = holder })
	local inner = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26), Parent = holder })
	self.plot = PlotView2D.new(inner, {
		xMin = -1, xMax = 1.5, yMin = 0, yMax = 2,
		xTicks = { -1, -0.5, 0, 0.5, 1, 1.5 }, yTicks = { 0, 0.5, 1, 1.5, 2 },
		xLabel = Strings.plotX, yLabel = Strings.plotY,
		padL = 62, padR = 14, padT = 40, padB = 70, fontSize = 22,
		fallbackW = 566 - 62 - 14, fallbackH = 508 - 40 - 70,
	})
	self.plot.onResize = function()
		self.dirty = true
	end
end

function Scoreboard:_buildIdle()
	self.idle = Gui.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Theme.color.bg, ZIndex = 50, Parent = self.gui })
	Gui.label({ Size = UDim2.fromScale(1, 1), Text = Strings.boardIdle, TextSize = 44, Font = Theme.fontBold, ZIndex = 51,
		TextColor3 = Theme.color.textDim, TextXAlignment = Enum.TextXAlignment.Center, Parent = self.idle })
end

function Scoreboard:setActive(on: boolean)
	self.idle.Visible = not on
end

function Scoreboard:setMessage(text: string, color: Color3?)
	self.message.Text = text
	self.message.TextColor3 = color or Theme.color.text
end

-- snap: LineModel-снимок; st: { records, parabola, recordEnabled, showMseFormula, bestLine }
function Scoreboard:render(snap, st)
	local tok = Theme.tok
	self.rowM.Text = ("%s  <font size=\"24\">%s</font>   %s"):format(tok("mText", "m"), Strings.slopeName, Format.coef(snap.m))
	self.rowH.Text = ("%s  <font size=\"22\">%s</font>  %s     %s = %s"):format(
		tok("c", "h"), Strings.heightName, Format.len(snap.h), tok("c", "c"), Format.len(snap.c))
	self.rowEq.Text = ("ŷ = %s·x + %s"):format(tok("mText", Format.coef(snap.m)), tok("c", Format.num(snap.c, 2)))
	self.rowMse.Text = ("%s = %s"):format(tok("residual", "MSE"), Format.mse(snap.mse))
	if st.showMseFormula then
		self.rowMseFormula.Text = ("MSE = Σe² / %d = %s / %d"):format(snap.n, Format.num(snap.L, 3), snap.n)
	else
		self.rowMseFormula.Text = ""
	end
	self.rowLambda.Text = ("%s = %s   <font color=\"%s\">%s</font>"):format(tok("penalty", "λ"), Format.lambda(0), Theme.hex.textDim, Strings.lambdaNote)

	local cur = Records.atHeight(st.records, snap.h)
	self.recordBtn.Visible = st.recordEnabled == true
	if st.recordEnabled or #st.records > 0 then
		self.recordCounter.Text = if st.parabola then Strings.recordsDone
			else Strings.recordCounter:format(Format.len(snap.h), #cur)
	else
		self.recordCounter.Text = ""
	end

	self:_renderPlot(snap, st, cur)
end

function Scoreboard:_renderPlot(snap, st, cur)
	local plot = self.plot
	local anyStale = #cur < #st.records

	local stale = plot:layer("stale", 3)
	stale:begin()
	for _, r in st.records do
		if not Records.sameHeight(r.h, snap.h) then
			stale:dot(r.m, r.mse, { color = Theme.color.textDim, size = 14, transparency = 0.6 })
		end
	end
	stale:finish()

	local P = st.parabola
	local par = plot:layer("parabola", 4)
	par:begin()
	if P then
		local sameH = Records.sameHeight(P.h, snap.h)
		local tr = if sameH then 0 else 0.6
		par:curve(function(m)
			return P.a * m * m + P.b * m + P.k
		end, -1, 1.5, 100, { color = Theme.color.loss, thickness = 3, transparency = tr })
		par:dashedV(P.tStar, 0, P.vStar, { color = Theme.color.flag, thickness = 2, transparency = tr })
		par:dot(P.tStar, P.vStar, { color = Theme.color.flag, size = 18, transparency = tr })
		par:label(P.tStar, P.vStar, ("m* = %s"):format(Format.coef(P.tStar)), {
			dx = 12, dy = -10, anchor = Vector2.new(0, 1), size = 24, font = Theme.fontBold, color = Theme.color.flag, transparency = tr,
		})
		if not sameH then
			par:labelPx(8, 8, Strings.parabolaOtherH:format(Format.len(P.h)), { anchor = Vector2.new(0, 0), size = 18, color = Theme.color.textDim })
		end
	end
	if anyStale then
		par:labelPx(8, if P then 32 else 8, Strings.staleNote, { anchor = Vector2.new(0, 0), size = 18, color = Theme.color.textDim })
	end
	par:finish()

	local recs = plot:layer("records", 5)
	recs:begin()
	for _, r in cur do
		recs:dot(r.m, r.mse, { color = Theme.color.loss, size = 16, strokeColor = Theme.color.bg })
	end
	recs:finish()

	-- текущее положение прямой — с шага записей (до него график пуст: точки «заносятся с п. 4»)
	local live = plot:layer("live", 6)
	live:begin()
	if st.recordEnabled or P or #st.records > 0 then
		live:dot(snap.m, snap.mse, { color = Theme.color.line, size = 20, hollow = true })
	end
	live:finish()
end

return Scoreboard
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="60">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="61">
      <Properties>
        <string name="Name">RegressionTests</string>
        <bool name="Disabled">false</bool>
        <string name="Source"><![CDATA[-- RegressionTests: прогон автотестов ядра и логики 3D при запуске в Studio (в опубликованной игре не выполняется).
-- Ожидаемый вывод в Output: «MathCore: 160/160», «Logic3D: 62/62», «Regression ИТОГО: 222/222».
-- Сквозной сценарий игрока (3D → 2D → лор) гоняется вне Studio: luau tests/scenario.luau (README).
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then
	return
end

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Regression = ReplicatedStorage:WaitForChild("Regression")
local MathCore = require(Regression.MathCore)
local Datasets = require(Regression.Data.Datasets)
local Expected = require(Regression.Data.ExpectedValues)

local c1, f1 = require(Regression.Tests.MathCoreSpec)(MathCore, Datasets, Expected)
local c2, f2 = require(Regression.Tests.LogicSpec)({
	MathCore = MathCore,
	Datasets = Datasets,
	Format = require(Regression.Core.Format),
	BedGeometry = require(Regression.Core.BedGeometry),
	Records = require(Regression.Core.Records),
	LineModel = require(Regression.Core.LineModel),
	Store = require(Regression.Core.Store),
})
local total, failed = c1 + c2, f1 + f2
if failed > 0 then
	warn(("Regression ИТОГО: %d/%d — есть упавшие проверки, смотри FAIL выше"):format(total - failed, total))
else
	print(("Regression ИТОГО: %d/%d"):format(total, total))
end
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="62">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="63">
        <Properties>
          <string name="Name">RegressionProgress</string>
          <string name="Source"><![CDATA[-- RegressionProgress: вехи модуля «Регрессия» от клиента → LearningService (как у других уроков SkRob).
-- Клиент присылает только id из списка ниже; прогресс прохождения внутри модуля живёт на клиенте (Store.serialize).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- В песочнице RegressionBeeHive сервисов SkRob нет — тогда вехи просто не сохраняются
local services = script.Parent:FindFirstChild("Services")
if not services or not services:FindFirstChild("LearningService") then
	return
end
local LearningService = require(services.LearningService)

local MILESTONES = {
	regression_3d = true, -- клумба: найден оптимальный наклон (3D.6)
	regression_2d = true, -- экраны 2D.1–2D.7 пройдены (R² открыт)
	regression_lore = true, -- лор-задача: прогноз мёда проверен через R²
}

local remote = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("RegressionProgress")

remote.OnServerEvent:Connect(function(player, milestone)
	if type(milestone) ~= "string" or not MILESTONES[milestone] then
		return
	end
	if LearningService.IsCompleted(player, milestone) then
		return
	end
	LearningService.Complete(player, milestone)
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="64">
      <Properties>
        <string name="Name">RegressionLevelServer</string>
        <string name="Source"><![CDATA[-- RegressionLevelServer: копирует CFrame и Size площадок уровня «Регрессия» в атрибуты папки
-- Workspace/RegressionLevel. В SkRob включён StreamingEnabled: сами детали приходят клиенту не сразу,
-- а атрибуты папки — сразу, поэтому клумба и пасека строятся на своих местах в первый же кадр.
-- Двигать площадки и куб можно прямо в Studio — атрибуты обновятся при запуске.
local level = workspace:WaitForChild("RegressionLevel")

local function publish(part: Instance)
	if part:IsA("BasePart") then
		level:SetAttribute(part.Name .. "_CFrame", part.CFrame)
		level:SetAttribute(part.Name .. "_Size", part.Size)
	end
end

for _, child in level:GetChildren() do
	publish(child)
	if child:IsA("BasePart") then
		child:GetPropertyChangedSignal("CFrame"):Connect(function() publish(child) end)
		child:GetPropertyChangedSignal("Size"):Connect(function() publish(child) end)
	end
end
level.ChildAdded:Connect(publish)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="65">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="66">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="67">
        <Properties>
          <string name="Name">RegressionClient</string>
          <bool name="Disabled">false</bool>
          <string name="Source"><![CDATA[--!nonstrict
-- RegressionClient: точка входа модуля «Регрессия» (3D experience → 2D experience → лор-задача).
-- Всё обучение — на клиенте: клумба, табло, экраны и пасека создаются локально, у каждого игрока свои.
-- Где строить (общая карта SkRob): Workspace/RegressionLevel/FlowerbedAnchor и …/LoreAnchor
--   (низ детали — земля; локальная +Z детали смотрит туда, откуда приходит игрок). Высота уточняется лучом вниз;
--   если земля ещё не подгрузилась (StreamingEnabled), остаётся низ якоря.
-- Клумба и пасека строятся сразу при входе в игру и видны всегда. Площадки в SkRob стримятся (StreamingEnabled),
--   поэтому их CFrame/Size берутся из атрибутов папки RegressionLevel (их ставит сервер, RegressionLevelServer) —
--   без ожидания; если атрибутов нет — из самих деталей, а если и их нет — из Core/LevelLayout.
-- Кнопки квестов модуля (подсказки F, HUD, пульт, экран 2D) работают, только когда уровень активен:
--   игрок внутри куба Workspace/RegressionLevel/RegressionZone и (если в месте есть LevelFlow) ActiveLevel = "regression".
-- Прогресс: вехи regression_3d / regression_2d / regression_lore → RemoteEvent ReplicatedStorage.Remotes.RegressionProgress.
-- В Studio: _G.RegressionDebug.goto("2D.4") — перейти к шагу (для проверки экранов без прохождения).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Regression = ReplicatedStorage:WaitForChild("Regression")
local MathCore = require(Regression.MathCore)
local Datasets = require(Regression.Data.Datasets)
local Config = require(Regression.Core.Config)
local Layout = require(Regression.Core.LevelLayout)
local Store = require(Regression.Core.Store)
local LineModel = require(Regression.Core.LineModel)
local Hud = require(Regression.UI.Hud)
local Shell2D = require(Regression.UI.Shell2D)
local Strings = require(Regression.UI.Strings)
local Flowerbed = require(Regression.World.Flowerbed)
local Scoreboard = require(Regression.World.Scoreboard)
local NextBoard = require(Regression.World.NextBoard)
local LoreWorld = require(Regression.World.LoreWorld)
local LineControls = require(Regression.Input.LineControls)
local PlayerControls = require(Regression.Input.PlayerControls)
local Flow3D = require(Regression.Scenes.Flow3D)
local SceneMachine = require(Regression.Scenes.SceneMachine)
local Screens = Regression.Scenes.Screens2D

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local fb = Datasets.flowerbed

-- ───── 1. Место в мире ─────

-- В SkRob включён StreamingEnabled: детали-якоря могут прийти на клиент позже скрипта — ждём их
local level = workspace:WaitForChild("RegressionLevel", 10)
local LEVEL_PARTS = { FlowerbedAnchor = true, LoreAnchor = true, RegressionZone = true }

-- Площадки и куб — служебные детали: в игре невидимы и не мешают (в том числе те, что придут стримингом позже)
local function hideLevelPart(d: Instance)
	if d:IsA("BasePart") and LEVEL_PARTS[d.Name] then
		d.Transparency = 1
		d.CanCollide, d.CanQuery, d.CanTouch = false, false, false
	end
end
if level then
	for _, d in level:GetChildren() do
		hideLevelPart(d)
	end
	level.ChildAdded:Connect(hideLevelPart)
end

-- CFrame и размер площадки без ожидания стриминга: атрибуты папки → деталь → LevelLayout
local function levelPart(name: string): (CFrame, Vector3)
	if level then
		local cf, size = level:GetAttribute(name .. "_CFrame"), level:GetAttribute(name .. "_Size")
		if typeof(cf) == "CFrame" and typeof(size) == "Vector3" then
			return cf, size
		end
		local part = level:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			return part.CFrame, part.Size
		end
	end
	local p = Layout.parts[name]
	return p.cframe, p.size
end
local worldFolder = Instance.new("Folder")
worldFolder.Name = "RegressionWorld"
worldFolder.Parent = workspace

local function groundAt(pos: Vector3, fallbackY: number): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { worldFolder }
	if level then
		table.insert(ignore, level)
	end
	if player.Character then
		table.insert(ignore, player.Character)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -200, 0), params)
	return if hit then hit.Position.Y else fallbackY
end

-- Якорь → CFrame на земле с поворотом только вокруг вертикали
local function findOrigin(name: string): CFrame
	local acf, asize = levelPart(name)
	local cf = acf * CFrame.new(0, -asize.Y / 2, 0)
	local _, yaw, _ = cf:ToOrientation()
	local p = cf.Position
	return CFrame.new(p.X, groundAt(p, p.Y), p.Z) * CFrame.Angles(0, yaw, 0)
end

local origin = findOrigin("FlowerbedAnchor")
local loreOrigin = findOrigin("LoreAnchor")

-- Куб уровня (его можно растянуть/повернуть в Studio)
local zoneCF, zoneSize = levelPart("RegressionZone")
local function insideCube(p: Vector3): boolean
	local l = zoneCF:PointToObjectSpace(p)
	return math.abs(l.X) <= zoneSize.X / 2 and math.abs(l.Y) <= zoneSize.Y / 2 and math.abs(l.Z) <= zoneSize.Z / 2
end

-- ───── 2. Состояние и модель ─────

local store = Store.new({
	scene = "",
	m = fb.start_line.m,
	h = fb.start_line.h,
	threads = table.create(#fb.x_m, false),
	records = {},
	parabola = nil,
	honey = 0,
	predictions = {},
	inZone = false,
	controlUnlocked = false,
	controlMode = false,
	recordEnabled = false,
	movedSlope = false,
	movedHeight = false,
	showMseFormula = false,
	opened2D = false,
	highlight = nil,
	notes = {},
	inQuestCube = false,
})
local lineModel = LineModel.new(MathCore, fb)

local progressRemote = nil
task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
	progressRemote = remotes and remotes:WaitForChild("RegressionProgress", 10)
end)
local function milestone(id: string)
	if progressRemote then
		progressRemote:FireServer(id)
	end
end

-- ───── 3. Мир и UI ─────

local D = fb.bed_width_m * Config.STUDS_PER_M
local hud = Hud.new(playerGui)
local shell = Shell2D.new(playerGui, store)
local bed = Flowerbed.new({ parent = worldFolder, origin = origin, data = fb })
local lore = LoreWorld.new({ parent = worldFolder, origin = loreOrigin, data = Datasets.lore })

local flow -- объявлены заранее: кнопки табло и промпты ссылаются на них
local machine
local board = Scoreboard.new({
	parent = worldFolder,
	cframe = origin * CFrame.new(0, 1.2 + 11.25 / 2, -(D / 2 + 4)) * CFrame.Angles(0, math.pi, 0),
	groundY = origin.Position.Y,
	playerGui = playerGui,
	onRecord = function()
		flow:record()
	end,
})
local nextBoard = NextBoard.new({
	parent = worldFolder,
	cframe = origin * CFrame.new(20, 1.2 + 7.875 / 2, -(D / 2 + 4)) * CFrame.Angles(0, math.pi, 0),
	groundY = origin.Position.Y,
	playerGui = playerGui,
	onContinue = function()
		flow:openScreen2D()
	end,
})

local prompts = { bed.controlPrompt }
for _, f in bed.flowers do
	table.insert(prompts, f.prompt)
end
local controls = LineControls.new({
	store = store,
	hud = hud,
	prompts = prompts,
	onRecord = function()
		flow:record()
	end,
})

-- ───── 3a. Уровень активен (куб + LevelFlow): иначе подсказки модуля недоступны ─────
-- Enabled подсказок ведут сцены, поэтому не трогаем его: вне куба MaxActivationDistance = 0 (исходное — в атрибуте).
local inCube = false
local function gatePrompt(p: ProximityPrompt)
	if inCube then
		return
	end
	if p:GetAttribute("RegDist") == nil then
		p:SetAttribute("RegDist", p.MaxActivationDistance)
		p.MaxActivationDistance = 0
	end
end
local function setCube(on: boolean)
	inCube = on
	for _, d in worldFolder:GetDescendants() do
		if d:IsA("ProximityPrompt") then
			if on then
				local dist = d:GetAttribute("RegDist")
				if dist ~= nil then
					d.MaxActivationDistance = dist
					d:SetAttribute("RegDist", nil)
				end
			else
				gatePrompt(d)
			end
		end
	end
	store:set("inQuestCube", on)
end
worldFolder.DescendantAdded:Connect(function(d)
	if d:IsA("ProximityPrompt") then
		gatePrompt(d) -- например, подсказка второго табло, которое поднимается позже
	end
end)

-- ───── 4. Сцены: 3D (Flow3D) → экраны 2D и лор (SceneMachine) ─────

local scenes = { require(Screens.S2D_1_DerivativeM) }
for _, sc in require(Screens.S2D_23_Intercept) do
	table.insert(scenes, sc)
end
for _, mod in { Screens.S2D_4_SmallSample, Screens.S2D_5_RidgeLasso, Screens.S2D_6_PenaltyCurves, Screens.S2D_7_R2 } do
	table.insert(scenes, require(mod))
end
for _, sc in require(Regression.Scenes.Lore.LoreScenes) do
	table.insert(scenes, sc)
end

machine = SceneMachine.new({
	store = store, shell = shell, hud = hud, MathCore = MathCore, Datasets = Datasets, scenes = scenes,
	onMilestone = milestone,
})
machine.shared.loreWorld = lore

local function open2D()
	if machine:sceneId() == nil then
		machine:start("2D.1")
	elseif not machine.finished then
		local id = machine:sceneId()
		if id and id:sub(1, 2) == "2D" then
			machine:open()
		else
			hud:toast(Strings.lore.goToNpc, nil)
		end
	end
end

flow = Flow3D.new({
	store = store, hud = hud, bed = bed, board = board, nextBoard = nextBoard,
	controls = controls, lineModel = lineModel, MathCore = MathCore, open2D = open2D, onMilestone = milestone,
})

-- пасечник: вернуться к экрану лор-задачи, если игрок закрыл его
lore.npcPrompt.Triggered:Connect(function()
	local spec = machine:current()
	if spec and spec.panel and not shell.isOpen and (machine:sceneId() or ""):sub(1, 1) == "L" then
		machine:open()
	end
end)

-- ───── 5. Цикл: клумба — каждый кадр при изменениях, табло и экраны — не чаще 30 Гц ─────

local dirtyWorld, dirtyBoard = true, true
store.Changed:Connect("*", function()
	dirtyWorld, dirtyBoard = true, true
end)
bed:bindCards(function()
	dirtyWorld = true
end)

setCube(false) -- до первой проверки положения игрока всё закрыто
flow:start()

local uiAcc = 0
RunService.RenderStepped:Connect(function(dt)
	controls:step(dt)

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		-- LevelFlow включает уровни по очереди: ActiveLevel = "regression" ставит сервер у входа в уровень.
		-- Без LevelFlow (песочница) атрибута нет — тогда уровень активен всегда.
		local activeLevel = player:GetAttribute("ActiveLevel")
		local cube = insideCube(root.Position) and (activeLevel == nil or activeLevel == "regression")
		if cube ~= inCube then
			setCube(cube)
			if not cube then
				-- вышли из куба или уровень сменился: закрыть экран 2D и режим управления прямой
				controls:exit()
				if shell.isOpen then
					shell:close()
					PlayerControls.release("shell")
				end
			end
		end
		store:set("inZone", cube and bed:distanceTo(root.Position) <= Config.ZONE_STUDS)
		-- HUD модуля — только внутри куба: рядом с клумбой/пасекой или во время заданий модуля
		local id = machine:sceneId()
		local loreWorldStep = id ~= nil and id:sub(1, 1) == "L" and not shell.isOpen
		hud:setVisible(cube and (controls.active or loreWorldStep or bed:distanceTo(root.Position) <= Config.HUD_RADIUS_BED
			or lore:distanceTo(root.Position) <= Config.HUD_RADIUS_LORE))
	end

	local now = os.clock()
	local snap = lineModel:compute(store:get("m"), store:get("h"))
	local vis = flow:visuals(now)
	if dirtyWorld or vis.animating or bed.cardHover ~= nil then
		dirtyWorld = false
		bed:render(snap, vis)
	end

	flow:tick(snap, now)
	machine:tick(dt)

	uiAcc += dt
	if (dirtyBoard or board.dirty) and uiAcc >= 1 / Config.UI_HZ then
		uiAcc = 0
		dirtyBoard, board.dirty = false, false
		board:render(snap, {
			records = store:get("records"),
			parabola = store:get("parabola"),
			recordEnabled = store:get("recordEnabled"),
			showMseFormula = store:get("showMseFormula"),
		})
	end
end)

-- ───── 6. Отладка в Studio ─────

if RunService:IsStudio() then
	_G.RegressionDebug = {
		store = store, flow = flow, machine = machine, shell = shell, lore = lore, bed = bed,
		inCube = function() return inCube end,
		-- перейти к шагу: "3D.4", "2D.5", "L.3" …
		goto = function(id: string)
			if id:sub(1, 2) == "3D" then
				local i = table.find({ "3D.1", "3D.2", "3D.3", "3D.4", "3D.5", "3D.6" }, id)
				if i then
					store:set("controlUnlocked", i >= 3)
					flow:goto(i)
				end
			else
				flow:goto(7)
				machine:goto(id)
			end
		end,
	}
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>