-- BedGeometry: геометрия клумбы в координатах данных (метры). Без Roblox API.
-- Клумба — прямоугольник [0; W] × [0; H], ось x вдоль, ось y поперёк.

local BedGeometry = {}

-- Отрезок прямой y = m·x + c внутри прямоугольника. Возвращает x0, y0, x1, y1 или nil.
function BedGeometry.clipLine(m: number, c: number, W: number, H: number): (number?, number?, number?, number?)
	local x0, x1 = 0, W
	if math.abs(m) < 1e-12 then
		if c < 0 or c > H then
			return nil, nil, nil, nil
		end
	else
		local xa, xb = (0 - c) / m, (H - c) / m
		if xa > xb then
			xa, xb = xb, xa
		end
		x0 = math.max(x0, xa)
		x1 = math.min(x1, xb)
		if x0 >= x1 then
			return nil, nil, nil, nil
		end
	end
	return x0, m * x0 + c, x1, m * x1 + c
end

-- Нить от цветка (x, y) к прямой параллельно оси y. grow ∈ [0; 1] — доля «протянутости».
function BedGeometry.thread(x: number, y: number, yhat: number, grow: number): (number, number, number, number)
	return x, y, x, y + (yhat - y) * grow
end

-- Квадрат ошибки: одна сторона — нить, другая — вдоль x в сторону от центра клумбы.
-- Возвращает центр (cx, cy) и сторону (м).
function BedGeometry.square(x: number, y: number, yhat: number, pivotX: number, grow: number): (number, number, number)
	local side = math.abs(y - yhat) * grow
	local dir = if x < pivotX then -1 else 1
	local yEnd = y + (yhat - y) * grow
	return x + dir * side / 2, (y + yEnd) / 2, side
end

-- Расстояние от точки (px, pz) до прямоугольника с полуразмерами (hx, hz) с центром в нуле
function BedGeometry.distToRect(px: number, pz: number, hx: number, hz: number): number
	local dx = math.max(math.abs(px) - hx, 0)
	local dz = math.max(math.abs(pz) - hz, 0)
	return math.sqrt(dx * dx + dz * dz)
end

-- Отрезок в прямоугольнике [xMin; xMax] × [yMin; yMax] (Лян — Барски). Для графиков на табло.
function BedGeometry.clipSegment(
	x0: number, y0: number, x1: number, y1: number,
	xMin: number, xMax: number, yMin: number, yMax: number
): (number?, number?, number?, number?)
	local dx, dy = x1 - x0, y1 - y0
	local t0, t1 = 0, 1
	local p = { -dx, dx, -dy, dy }
	local q = { x0 - xMin, xMax - x0, y0 - yMin, yMax - y0 }
	for i = 1, 4 do
		if p[i] == 0 then
			if q[i] < 0 then
				return nil, nil, nil, nil
			end
		else
			local t = q[i] / p[i]
			if p[i] < 0 then
				if t > t1 then return nil, nil, nil, nil end
				if t > t0 then t0 = t end
			else
				if t < t0 then return nil, nil, nil, nil end
				if t < t1 then t1 = t end
			end
		end
	end
	return x0 + t0 * dx, y0 + t0 * dy, x0 + t1 * dx, y0 + t1 * dy
end

return BedGeometry
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- Config: все числовые константы 3D experience в одном месте.

return {
	STUDS_PER_M = 4, -- 1 м данных = 4 studs: клумба 5 × 3 м = 20 × 12 studs

	-- Прямая
	SLOPE_MIN = -1,
	SLOPE_MAX = 1.5,
	H_MIN = 0,
	H_MAX = 3,
	H_STEP = 0.05, -- высота «защёлкивается» на сетку 0,05 м при отпускании Shift/Ctrl
	ANGLE_SPEED_DEG = 20, -- Q/E: град/с
	H_SPEED = 0.5, -- Shift/Ctrl: м/с

	-- Шаги
	ZONE_STUDS = 10, -- табло оживает, когда игрок ближе 10 studs к клумбе
	MANUAL_THREADS_BEFORE_AUTO = 2, -- после 2 ручных нитей — кнопка «протянуть остальные»
	SNAP_TOL = 0.03, -- 3D.5: прилипание к m*
	BEST_H = 1.5, -- 3D.5 бонус: высота лучшей прямой (= ȳ)
	ONE_SIDE_CHECK_AFTER = 4, -- после 4-й записи проверка «все по одну сторону»

	-- Анимации (все ≤ 3 с, переходы ≤ 0,6 с)
	THREAD_GROW_S = 0.5,
	SQUARE_GROW_S = 0.6,
	BOARD2_RISE_S = 1.8,

	-- Подсказки и UI
	HINT_IDLE_S = 45,
	UI_HZ = 30,
	TOAST_S = 3,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Format</string><ProtectedString name="Source"><![CDATA[--!strict
-- Format: числа для UI. Десятичная запятая, неразрывный пробел перед единицей,
-- типографский минус, явный знак у ошибок. Без Roblox API (тестируется standalone).

local Format = {}

Format.NBSP = "\u{00A0}"
Format.MINUS = "\u{2212}"

function Format.num(x: number, digits: number?): string
	local d = digits or 2
	local s = string.format("%." .. d .. "f", x)
	if tonumber(s) == 0 then
		s = string.format("%." .. d .. "f", 0) -- без «−0,00»
	end
	s = (s:gsub("%.", ","))
	s = (s:gsub("^%-", Format.MINUS))
	return s
end

-- Со знаком: +0,26 / −0,37 / 0,00
function Format.signed(x: number, digits: number?): string
	local s = Format.num(x, digits)
	local d = digits or 2
	local r = tonumber(string.format("%." .. d .. "f", x)) or 0
	if r > 0 then
		return "+" .. s
	end
	return s
end

function Format.unit(x: number, digits: number?, unit: string): string
	return Format.num(x, digits) .. Format.NBSP .. unit
end

-- Коэффициенты (наклон m): 2 знака на табло, сравнение точности — в логике
function Format.coef(x: number): string
	return Format.num(x, 2)
end

function Format.len(x: number): string
	return Format.unit(x, 2, "м")
end

function Format.area(x: number): string
	return Format.unit(x, 2, "м²")
end

function Format.mse(x: number): string
	return Format.unit(x, 3, "м²")
end

function Format.lambda(x: number): string
	if x == 0 then
		return "0"
	end
	return Format.num(x, 1)
end

function Format.percent(share: number): string
	return Format.unit(share * 100, 1, "%")
end

return Format
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">LineModel</string><ProtectedString name="Source"><![CDATA[--!strict
-- LineModel: всё, что табло и клумба показывают о прямой y = m·x + c. Числа — только из MathCore.
-- Прямая вращается вокруг точки (x̄; h) — центра клумбы, поэтому c = h − x̄·m.

export type Snapshot = {
	m: number, h: number, c: number,
	yhat: { number }, e: { number }, sq: { number },
	L: number, mse: number, n: number,
}

local LineModel = {}
LineModel.__index = LineModel

function LineModel.new(MathCore: any, fb: any)
	local self = setmetatable({}, LineModel)
	self.MathCore = MathCore
	self.x = fb.x_m :: { number }
	self.y = fb.y_m :: { number }
	self.n = #fb.x_m
	self.pivotX = fb.pivot_x_m :: number
	self.W = fb.bed_length_m :: number
	self.H = fb.bed_width_m :: number
	local o = MathCore.ols1d(self.x, self.y)
	self.mOpt = o.b1 :: number -- 0,33
	self.cOpt = o.b0 :: number -- 0,675
	self.hOpt = (o.b0 + o.b1 * self.pivotX) :: number -- = ȳ = 1,5
	return self
end

function LineModel.compute(self: any, m: number, h: number): Snapshot
	local MathCore = self.MathCore
	local c = MathCore.lineFromPivot(m, h, self.pivotX)
	local yhat, e, sq = table.create(self.n), table.create(self.n), table.create(self.n)
	for i = 1, self.n do
		yhat[i] = m * self.x[i] + c
		e[i] = self.y[i] - yhat[i]
		sq[i] = e[i] * e[i]
	end
	local mse = MathCore.mseLine(self.x, self.y, m, c)
	return { m = m, h = h, c = c, yhat = yhat, e = e, sq = sq, L = mse * self.n, mse = mse, n = self.n }
end

return LineModel
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Records</string><ProtectedString name="Source"><![CDATA[--!strict
-- Records: записи (m, MSE) на табло. Без Roblox API.
-- Правила из раскадровки 3D.4: 5 записей на одной высоте, наклоны различаются не меньше чем на 0,1.

export type Record = { m: number, mse: number, h: number }

local Records = {}

Records.NEED = 5
Records.MIN_DM = 0.1
Records.H_TOL = 1e-3 -- высота дискретна (шаг 0,05 м), так что допуск только на погрешность float
Records.MAX_TOTAL = 20

function Records.sameHeight(a: number, b: number): boolean
	return math.abs(a - b) < Records.H_TOL
end

function Records.atHeight(list: { Record }, h: number): { Record }
	local out = {}
	for _, r in list do
		if Records.sameHeight(r.h, h) then
			table.insert(out, r)
		end
	end
	return out
end

-- ok, reason ("full" | "too_close"), конфликтующая запись
function Records.validate(list: { Record }, m: number, h: number): (boolean, string?, Record?)
	local cur = Records.atHeight(list, h)
	if #cur >= Records.NEED then
		return false, "full", nil
	end
	for _, r in cur do
		if math.abs(r.m - m) < Records.MIN_DM - 1e-9 then
			return false, "too_close", r
		end
	end
	return true, nil, nil
end

-- Добавляет запись в новый список (старый не меняется — удобно для Store).
-- Если записей слишком много, выбрасывает самые старые записи других высот.
function Records.add(list: { Record }, rec: Record): { Record }
	local out = table.clone(list)
	table.insert(out, rec)
	local i = 1
	while #out > Records.MAX_TOTAL and i <= #out do
		if not Records.sameHeight(out[i].h, rec.h) then
			table.remove(out, i)
		else
			i += 1
		end
	end
	return out
end

-- Все записи по одну сторону от mOpt (подсказка «попробуй наклон в другую сторону»)
function Records.oneSide(list: { Record }, mOpt: number): boolean
	if #list == 0 then
		return false
	end
	local below, above = 0, 0
	for _, r in list do
		if r.m < mOpt then below += 1 else above += 1 end
	end
	return below == 0 or above == 0
end

-- Парабола по записям: MathCore передаётся снаружи, чтобы модуль оставался чистым
function Records.fit(MathCore: any, list: { Record })
	local t, v = {}, {}
	for i, r in list do
		t[i], v[i] = r.m, r.mse
	end
	return MathCore.fitParabola(t, v)
end

return Records
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Store</string><ProtectedString name="Source"><![CDATA[--!strict
-- Store: плоское состояние модуля + подписки по ключам. Без Roblox API.
--   store:get(key), store:set(key, value), store:patch({...})
--   store.Changed:Connect(key, fn)  → { Disconnect = fn }; key "*" — любые изменения
-- Таблицы (records, threads) заменяются целиком, а не мутируются, — так подписчики не пропустят изменение.

local Store = {}
Store.__index = Store

local PERSISTENT = { "m", "h", "scene", "threads", "records", "parabola", "honey", "predictions" }

function Store.new(initial: { [string]: any }?)
	local self = setmetatable({}, Store)
	self.state = table.clone(initial or {}) :: { [string]: any }
	self.listeners = {} :: { [string]: { (any, string) -> () } }
	local store = self
	self.Changed = {
		Connect = function(_, key: string, fn: (any, string) -> ())
			local list = store.listeners[key]
			if not list then
				list = {}
				store.listeners[key] = list
			end
			table.insert(list, fn)
			return {
				Disconnect = function()
					local i = table.find(list, fn)
					if i then
						table.remove(list, i)
					end
				end,
			}
		end,
	}
	return self
end

function Store.get(self: any, key: string): any
	return self.state[key]
end

function Store.set(self: any, key: string, value: any)
	if self.state[key] == value and type(value) ~= "table" then
		return
	end
	self.state[key] = value
	for _, k in { key, "*" } do
		local list = self.listeners[k]
		if list then
			for _, fn in (table.clone(list) :: { (any, string) -> () }) do
				fn(value, key)
			end
		end
	end
end

function Store.patch(self: any, t: { [string]: any })
	for k, v in t do
		self:set(k, v)
	end
end

-- Для будущего DataStore (вне рамок ТЗ): только то, что нужно восстановить
function Store.serialize(self: any): { [string]: any }
	local out = {}
	for _, k in PERSISTENT do
		local v = self.state[k]
		out[k] = if type(v) == "table" then table.clone(v) else v
	end
	return out
end

return Store
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX0000000F"><Properties><string name="Name">Data</string></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Datasets</string><ProtectedString name="Source"><![CDATA[-- Сгенерировано scripts/json_to_luau.py из assets/datasets.json. Не редактировать вручную.
