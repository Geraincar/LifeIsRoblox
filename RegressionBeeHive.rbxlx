        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">BedGeometry</string>
            <string name="Source"><![CDATA[--!strict
-- BedGeometry: геометрия клумбы в координатах данных (метры). Без Roblox API.
-- Клумба — прямоугольник [0; W] × [0; H], ось x вдоль, ось y поперёк.

local BedGeometry = {}

-- Отрезок прямой y = m·x + c внутри прямоугольника. Возвращает x0, y0, x1, y1 или nil.
function BedGeometry.clipLine(m: number, c: number, W: number, H: number): (number?, number?, number?, number?)
	local x0, x1 = 0, W
	if math.abs(m) < 1e-12 then
		if c < 0 or c > H then
			return nil, nil, nil, nil
		end
	else
		local xa, xb = (0 - c) / m, (H - c) / m
		if xa > xb then
			xa, xb = xb, xa
		end
		x0 = math.max(x0, xa)
		x1 = math.min(x1, xb)
		if x0 >= x1 then
			return nil, nil, nil, nil
		end
	end
	return x0, m * x0 + c, x1, m * x1 + c
end

-- Нить от цветка (x, y) к прямой параллельно оси y. grow ∈ [0; 1] — доля «протянутости».
function BedGeometry.thread(x: number, y: number, yhat: number, grow: number): (number, number, number, number)
	return x, y, x, y + (yhat - y) * grow
end

-- Квадрат ошибки: одна сторона — нить, другая — вдоль x в сторону от центра клумбы.
-- Возвращает центр (cx, cy) и сторону (м).
function BedGeometry.square(x: number, y: number, yhat: number, pivotX: number, grow: number): (number, number, number)
	local side = math.abs(y - yhat) * grow
	local dir = if x < pivotX then -1 else 1
	local yEnd = y + (yhat - y) * grow
	return x + dir * side / 2, (y + yEnd) / 2, side
end

-- Расстояние от точки (px, pz) до прямоугольника с полуразмерами (hx, hz) с центром в нуле
function BedGeometry.distToRect(px: number, pz: number, hx: number, hz: number): number
	local dx = math.max(math.abs(px) - hx, 0)
	local dz = math.max(math.abs(pz) - hz, 0)
	return math.sqrt(dx * dx + dz * dz)
end

-- Отрезок в прямоугольнике [xMin; xMax] × [yMin; yMax] (Лян — Барски). Для графиков на табло.
function BedGeometry.clipSegment(
	x0: number, y0: number, x1: number, y1: number,
	xMin: number, xMax: number, yMin: number, yMax: number
): (number?, number?, number?, number?)
	local dx, dy = x1 - x0, y1 - y0
	local t0, t1 = 0, 1
	local p = { -dx, dx, -dy, dy }
	local q = { x0 - xMin, xMax - x0, y0 - yMin, yMax - y0 }
	for i = 1, 4 do
		if p[i] == 0 then
			if q[i] < 0 then
				return nil, nil, nil, nil
			end
		else
			local t = q[i] / p[i]
			if p[i] < 0 then
				if t > t1 then return nil, nil, nil, nil end
				if t > t0 then t0 = t end
			else
				if t < t0 then return nil, nil, nil, nil end
				if t < t1 then t1 = t end
			end
		end
	end
	return x0 + t0 * dx, y0 + t0 * dy, x0 + t1 * dx, y0 + t1 * dy
end

return BedGeometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Config</string>
            <string name="Source"><![CDATA[--!strict
-- Config: все числовые константы 3D experience в одном месте.

return {
	STUDS_PER_M = 4, -- 1 м данных = 4 studs: клумба 5 × 3 м = 20 × 12 studs

	-- Прямая
	SLOPE_MIN = -1,
	SLOPE_MAX = 1.5,
	H_MIN = 0,
	H_MAX = 3,
	H_STEP = 0.05, -- высота «защёлкивается» на сетку 0,05 м при отпускании Shift/Ctrl
	ANGLE_SPEED_DEG = 20, -- Q/E: град/с
	H_SPEED = 0.5, -- Shift/Ctrl: м/с

	-- Шаги
	ZONE_STUDS = 10, -- табло оживает, когда игрок ближе 10 studs к клумбе
	MANUAL_THREADS_BEFORE_AUTO = 2, -- после 2 ручных нитей — кнопка «протянуть остальные»
	SNAP_TOL = 0.03, -- 3D.5: прилипание к m*
	BEST_H = 1.5, -- 3D.5 бонус: высота лучшей прямой (= ȳ)
	ONE_SIDE_CHECK_AFTER = 4, -- после 4-й записи проверка «все по одну сторону»

	-- Анимации (все ≤ 3 с, переходы ≤ 0,6 с)
	THREAD_GROW_S = 0.5,
	SQUARE_GROW_S = 0.6,
	BOARD2_RISE_S = 1.8,

	-- Лор-задача: путь в мире пропорционален сюжетному расстоянию до поляны
	LORE_STUDS_PER_M = 0.012, -- 550 м ≈ 11 studs, 1630 м ≈ 24 studs (плюс 4 studs от улья)

	-- Встраивание в общий мир: HUD модуля виден только рядом с клумбой или пасекой
	HUD_RADIUS_BED = 60,
	HUD_RADIUS_LORE = 45,

	-- Подсказки и UI
	HINT_IDLE_S = 45,
	UI_HZ = 30,
	TOAST_S = 3,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
-- Format: числа для UI. Десятичная запятая, неразрывный пробел перед единицей,
-- типографский минус, явный знак у ошибок. Без Roblox API (тестируется standalone).

local Format = {}

Format.NBSP = "\u{00A0}"
Format.MINUS = "\u{2212}"

function Format.num(x: number, digits: number?): string
	local d = digits or 2
	local s = string.format("%." .. d .. "f", x)
	if tonumber(s) == 0 then
		s = string.format("%." .. d .. "f", 0) -- без «−0,00»
	end
	s = (s:gsub("%.", ","))
	s = (s:gsub("^%-", Format.MINUS))
	return s
end

-- Со знаком: +0,26 / −0,37 / 0,00
function Format.signed(x: number, digits: number?): string
	local s = Format.num(x, digits)
	local d = digits or 2
	local r = tonumber(string.format("%." .. d .. "f", x)) or 0
	if r > 0 then
		return "+" .. s
	end
	return s
end

function Format.unit(x: number, digits: number?, unit: string): string
	return Format.num(x, digits) .. Format.NBSP .. unit
end

-- Коэффициенты (наклон m): 2 знака на табло, сравнение точности — в логике
function Format.coef(x: number): string
	return Format.num(x, 2)
end

function Format.len(x: number): string
	return Format.unit(x, 2, "м")
end

function Format.area(x: number): string
	return Format.unit(x, 2, "м²")
end

function Format.mse(x: number): string
	return Format.unit(x, 3, "м²")
end

function Format.lambda(x: number): string
	if x == 0 then
		return "0"
	end
	return Format.num(x, 1)
end

function Format.percent(share: number): string
	return Format.unit(share * 100, 1, "%")
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">LevelLayout</string>
            <string name="Source"><![CDATA[-- Сгенерировано tools/level.py. Не редактировать.
-- Площадки модуля «Регрессия» и куб уровня (RegressionZone) — как в общей карте SkRob.
-- Клиент берёт детали из Workspace/RegressionLevel; эти числа — запасной вариант и основа тестов.
return {
	groundY = -30.575768,
	spawn = Vector3.new(41.965675, -30.575768, 1.0869448),
	parts = {
		FlowerbedAnchor = { cframe = CFrame.new(115.64024, -30.075768, -4.472183, 0.7071072, 0.0, -0.70710653, 0.0, 1.0, 0.0, 0.70710653, 0.0, 0.7071072), size = Vector3.new(20.0, 1.0, 12.0) },
		LoreAnchor = { cframe = CFrame.new(118.48942, -30.075768, 73.57159, -0.7071064, 0.0, -0.70710725, 0.0, 1.0, 0.0, 0.70710725, 0.0, -0.7071064), size = Vector3.new(40.0, 1.0, 44.0) },
		RegressionZone = { cframe = CFrame.new(114.435646, -12.134401, 35.826294, 0.97657514, 0.0, 0.21517709, 0.0, 1.0, 0.0, -0.21517709, 0.0, 0.97657514), size = Vector3.new(89.78053, 61.882736, 165.9553) },
	},
}
]]></string>
