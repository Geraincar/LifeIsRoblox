      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Input</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">LineControls</string>
            <string name="Source"><![CDATA[--!nonstrict
-- LineControls: режим управления прямой.
--   Q/E — наклон (угол ±20°/с, m = tan угла), Shift/Ctrl — высота h (0,5 м/с, при отпускании — на сетку 0,05 м),
--   R — записать, X — выйти. Геймпад: R1/L1 — наклон, R2/L2 — высота, X — запись, B — выход.
--   Телефон и мышь: кнопки пульта в Hud (удержание = непрерывное изменение).
-- ContextActionService с приоритетом High и Sink: клавиши не уходят персонажу и shift-lock.
-- На время режима: движение персонажа выключено, shift-lock запрещён, ProximityPrompt'ы клумбы выключены.

local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)

local LineControls = {}
LineControls.__index = LineControls

local PRIORITY = Enum.ContextActionPriority.High.Value
local ANGLE_MIN = math.atan(Config.SLOPE_MIN)
local ANGLE_MAX = math.atan(Config.SLOPE_MAX)

-- args: store, hud, prompts (список ProximityPrompt, которые глушить), onRecord, onExit
function LineControls.new(args)
	local self = setmetatable({}, LineControls)
	self.store = args.store
	self.hud = args.hud
	self.prompts = args.prompts or {}
	self.onRecord = args.onRecord
	self.held = { slopeUp = false, slopeDown = false, up = false, down = false }
	self.active = false
	self.savedPrompts = {}

	for name in self.held do
		self.hud.padHandlers[name] = function(down: boolean)
			self.held[name] = down
		end
	end
	self.hud.padHandlers.record = function()
		self:record()
	end
	self.hud.padHandlers.exit = function()
		self:exit()
	end

	local player = Players.LocalPlayer
	task.spawn(function()
		local ok, pm = pcall(function()
			local pm: any = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
			return (require :: any)(pm)
		end)
		if ok and pm then
			self.controls = pm:GetControls()
		end
	end)
	player.CharacterAdded:Connect(function()
		if self.active then
			self:exit()
		end
	end)
	return self
end

function LineControls:record()
	if self.active and self.store:get("recordEnabled") and self.onRecord then
		self.onRecord()
	end
end

function LineControls:enter()
	if self.active or not self.store:get("controlUnlocked") then
		return
	end
	self.active = true
	self.store:set("controlMode", true)

	local function holdAction(name: string)
		return function(_, state: Enum.UserInputState)
			if state == Enum.UserInputState.Begin then
				self.held[name] = true
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				self.held[name] = false
			end
			return Enum.ContextActionResult.Sink
		end
	end
	ContextActionService:BindActionAtPriority("RegSlopeUp", holdAction("slopeUp"), false, PRIORITY, Enum.KeyCode.Q, Enum.KeyCode.ButtonR1)
	ContextActionService:BindActionAtPriority("RegSlopeDown", holdAction("slopeDown"), false, PRIORITY, Enum.KeyCode.E, Enum.KeyCode.ButtonL1)
	ContextActionService:BindActionAtPriority("RegUp", holdAction("up"), false, PRIORITY, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonR2)
	ContextActionService:BindActionAtPriority("RegDown", holdAction("down"), false, PRIORITY, Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl, Enum.KeyCode.ButtonL2)
	ContextActionService:BindActionAtPriority("RegRecord", function(_, state)
		if state == Enum.UserInputState.Begin then
			self:record()
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	ContextActionService:BindActionAtPriority("RegExit", function(_, state)
		if state == Enum.UserInputState.Begin then
			task.defer(function()
				self:exit()
			end)
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, Enum.KeyCode.X, Enum.KeyCode.ButtonB)

	local player = Players.LocalPlayer
	self.savedMouseLock = player.DevEnableMouseLock
	pcall(function()
		player.DevEnableMouseLock = false
	end)
	if self.controls then
		self.controls:Disable()
	end
	self.savedPrompts = {}
	for _, p in self.prompts do
		self.savedPrompts[p] = p.Enabled
		p.Enabled = false
	end
	self.hud:showPad(true, UserInputService.KeyboardEnabled, self.store:get("recordEnabled") == true)
end

function LineControls:exit()
	if not self.active then
		return
	end
	self.active = false
	for _, name in { "RegSlopeUp", "RegSlopeDown", "RegUp", "RegDown", "RegRecord", "RegExit" } do
		ContextActionService:UnbindAction(name)
	end
	for k in self.held do
		self.held[k] = false
	end
	pcall(function()
		Players.LocalPlayer.DevEnableMouseLock = self.savedMouseLock
	end)
	if self.controls then
		self.controls:Enable()
	end
	for p, was in self.savedPrompts do
		p.Enabled = was
	end
	self.savedPrompts = {}
	self:_snapHeight()
	self.hud:showPad(false, false, false)
	self.store:set("controlMode", false)
end

-- Подсказку можно включить/выключить снаружи, пока режим активен (например, сцена включила новые промпты)
function LineControls:setPromptWanted(p: ProximityPrompt, enabled: boolean)
	if self.active and self.savedPrompts[p] ~= nil then
		self.savedPrompts[p] = enabled
	else
		p.Enabled = enabled
	end
end

function LineControls:_snapHeight()
	local h = self.store:get("h")
	local snapped = math.clamp(math.round(h / Config.H_STEP) * Config.H_STEP, Config.H_MIN, Config.H_MAX)
	if math.abs(snapped - h) > 1e-9 then
		self.store:set("h", snapped)
	end
end

-- Вызывать каждый кадр
function LineControls:step(dt: number)
	if not self.active then
		return
	end
	local st = self.store
	local held = self.held
	self.hud:showPad(true, UserInputService.KeyboardEnabled, st:get("recordEnabled") == true)

	local dirA = (if held.slopeUp then 1 else 0) - (if held.slopeDown then 1 else 0)
	if dirA ~= 0 then
		local a = math.clamp(math.atan(st:get("m")) + dirA * math.rad(Config.ANGLE_SPEED_DEG) * dt, ANGLE_MIN, ANGLE_MAX)
		st:set("m", math.tan(a))
		st:set("movedSlope", true)
		self.slopeWasHeld = true
	elseif self.slopeWasHeld then
		self.slopeWasHeld = false
		-- прилипание к цели (3D.5), только когда клавиша отпущена
		local snap = st:get("mSnap")
		if snap and math.abs(st:get("m") - snap.target) < snap.tol then
			st:set("m", snap.target)
		end
	end

	local dirH = (if held.up then 1 else 0) - (if held.down then 1 else 0)
	if dirH ~= 0 then
		st:set("h", math.clamp(st:get("h") + dirH * Config.H_SPEED * dt, Config.H_MIN, Config.H_MAX))
		st:set("movedHeight", true)
		self.heightWasHeld = true
	elseif self.heightWasHeld then
		self.heightWasHeld = false
		self:_snapHeight()
	end
end

return LineControls
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">PlayerControls</string>
            <string name="Source"><![CDATA[--!nonstrict
-- PlayerControls: выключить движение персонажа на время экрана 2D или панели (счётчик запросов).
-- Камеру не трогает. Работает через PlayerModule:GetControls(); если модуля нет — тихо ничего не делает.

local Players = game:GetService("Players")

local PlayerControls = {}

local holds = {}
local controls = nil

local function get()
	if controls then
		return controls
	end
	local ok, c = pcall(function()
		local pm: any = Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
		return (require :: any)(pm):GetControls()
	end)
	if ok then
		controls = c
	end
	return controls
end

local function apply()
	local c = get()
	if not c then
		return
	end
	if next(holds) then
		c:Disable()
	else
		c:Enable()
	end
end

function PlayerControls.hold(key: string)
	holds[key] = true
	task.spawn(apply)
end

function PlayerControls.release(key: string)
	holds[key] = nil
	task.spawn(apply)
end

return PlayerControls
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">MathCore</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MathCore: чистая математика регрессионного модуля «Улей». Без Roblox API —
-- запускается и в Studio, и в standalone luau (для автотестов).
-- Соглашения совпадают с scripts/reference_math.py:
--   L = Σe² (сумма, не среднее); Ridge: + λΣb²; Lasso: + λΣ|b|; b₀ не штрафуется;
--   стандартизация sd с делением на n, mean/sd только по train.

export type Vector = { number }
export type Matrix = { Vector } -- Matrix[i] — строка i (наблюдение)

local MathCore = {}

function MathCore.mean(v: Vector): number
	local s = 0
	for _, x in v do s += x end
	return s / #v
end

function MathCore.column(X: Matrix, j: number): Vector
	local c = table.create(#X)
	for i, row in X do c[i] = row[j] end
	return c
end

-- Одномерная МНК: возвращает b0, b1 и промежуточные суммы для формул UI
function MathCore.ols1d(x: Vector, y: Vector)
	local n = #x
	local xm, ym = MathCore.mean(x), MathCore.mean(y)
	local sxx, sxy, syy = 0, 0, 0
	for i = 1, n do
		local dx, dy = x[i] - xm, y[i] - ym
		sxx += dx * dx; sxy += dx * dy; syy += dy * dy
	end
	local b1 = sxy / sxx
	return {
		b0 = ym - b1 * xm, b1 = b1, n = n, xMean = xm, yMean = ym,
		sxx = sxx, sxy = sxy, syy = syy,
	}
end

-- Сумма квадратов остатков для прямой
function MathCore.sse1d(x: Vector, y: Vector, b0: number, b1: number): number
	local s = 0
	for i = 1, #x do
		local e = y[i] - (b0 + b1 * x[i])
		s += e * e
	end
	return s
end

-- MSE прямой y = m·x + c (табло в 3D показывает MSE = L/n)
function MathCore.mseLine(x: Vector, y: Vector, m: number, c: number): number
	return MathCore.sse1d(x, y, c, m) / #x
end

-- Прямая вращается вокруг точки (pivotX, h): свободный член
function MathCore.lineFromPivot(m: number, h: number, pivotX: number): number
	return h - m * pivotX
end

-- МНК-парабола v ≈ a·t² + b·t + k по записанным точкам (≥ 3 разных t).
-- Возвращает a, b, k и вершину (tStar, vStar). Для MSE при фиксированной высоте подгонка точная.
function MathCore.fitParabola(t: Vector, v: Vector)
	local S = table.create(5, 0) -- Σt^0..Σt^4
	local T = table.create(3, 0) -- Σv·t^0..Σv·t^2
	for i = 1, #t do
		local p = 1
		for k = 1, 5 do
			S[k] += p
			if k <= 3 then T[k] += v[i] * p end
			p *= t[i]
		end
	end
	-- нормальные уравнения для (k, b, a)
	local A = {
		{ S[1], S[2], S[3] },
		{ S[2], S[3], S[4] },
		{ S[3], S[4], S[5] },
	}
	local sol = MathCore._solve(A, { T[1], T[2], T[3] })
	local k, b, a = sol[1], sol[2], sol[3]
	local ts = -b / (2 * a)
	return { a = a, b = b, k = k, tStar = ts, vStar = a * ts * ts + b * ts + k }
end

-- Сумма квадратов остатков при оптимальном c (= ȳ − m·x̄) плюс штраф; kind = "l2" | "l1"
function MathCore.penalizedLoss1d(x: Vector, y: Vector, m: number, lambda: number, kind: string): number
	local c = MathCore.mean(y) - m * MathCore.mean(x)
	return MathCore.sse1d(x, y, c, m) + lambda * (if kind == "l2" then m * m else math.abs(m))
end

function MathCore.standardize(X: Matrix, means: Vector?, sds: Vector?): (Matrix, Vector, Vector)
	local p = #X[1]
	local m: Vector, s: Vector
	if means and sds then
		m, s = means, sds
	else
		m, s = table.create(p), table.create(p)
		for j = 1, p do
			local col = MathCore.column(X, j)
			local mu = MathCore.mean(col)
			local v = 0
			for _, x in col do v += (x - mu) ^ 2 end
			m[j], s[j] = mu, math.sqrt(v / #col)
		end
	end
	local Z: Matrix = table.create(#X)
	for i, row in X do
		local r = table.create(p)
		for j = 1, p do r[j] = (row[j] - m[j]) / s[j] end
		Z[i] = r
	end
	return Z, m, s
end

local function centered(X: Matrix, y: Vector): (Matrix, Vector, Vector, number)
	local n, p = #X, #X[1]
	local xm = table.create(p, 0)
	for _, row in X do for j = 1, p do xm[j] += row[j] / n end end
	local ym = MathCore.mean(y)
	local Xc: Matrix, yc: Vector = table.create(n), table.create(n)
	for i, row in X do
		local r = table.create(p)
		for j = 1, p do r[j] = row[j] - xm[j] end
		Xc[i], yc[i] = r, y[i] - ym
	end
	return Xc, yc, xm, ym
end

-- Решение A·b = c методом Гаусса с выбором ведущего элемента
local function solve(A: Matrix, c: Vector): Vector
	local p = #c
	local M: Matrix = table.create(p)
	for i = 1, p do
		local r = table.clone(A[i]); r[p + 1] = c[i]; M[i] = r
	end
	for k = 1, p do
		local piv = k
		for i = k + 1, p do if math.abs(M[i][k]) > math.abs(M[piv][k]) then piv = i end end
		M[k], M[piv] = M[piv], M[k]
		for i = k + 1, p do
			local f = M[i][k] / M[k][k]
			for j = k, p + 1 do M[i][j] -= f * M[k][j] end
		end
	end
	local b = table.create(p, 0)
	for i = p, 1, -1 do
		local s = M[i][p + 1]
		for j = i + 1, p do s -= M[i][j] * b[j] end
		b[i] = s / M[i][i]
	end
	return b
end

MathCore._solve = solve

local function intercept(xm: Vector, ym: number, b: Vector): number
	local s = ym
	for j = 1, #b do s -= xm[j] * b[j] end
	return s
end

-- Ridge (λ = 0 → обычная МНК). Xs — уже стандартизованные признаки.
function MathCore.ridge(Xs: Matrix, y: Vector, lambda: number): (number, Vector)
	local Xc, yc, xm, ym = centered(Xs, y)
	local p = #Xc[1]
	local A: Matrix, c: Vector = table.create(p), table.create(p, 0)
	for a = 1, p do
		A[a] = table.create(p, 0)
		for b = 1, p do
			local s = 0
			for i = 1, #Xc do s += Xc[i][a] * Xc[i][b] end
			A[a][b] = s + (if a == b then lambda else 0)
		end
		for i = 1, #Xc do c[a] += Xc[i][a] * yc[i] end
	end
	local b = solve(A, c)
	return intercept(xm, ym, b), b
end

function MathCore.ols(Xs: Matrix, y: Vector): (number, Vector)
	return MathCore.ridge(Xs, y, 0)
end

-- Lasso координатным спуском: b_j = S(ρ_j, λ/2) / Σx_j²
function MathCore.lasso(Xs: Matrix, y: Vector, lambda: number, maxIter: number?, tol: number?): (number, Vector)
	local Xc, yc, xm, ym = centered(Xs, y)
	local n, p = #Xc, #Xc[1]
	local b = table.create(p, 0)
	local z = table.create(p, 0)
	for j = 1, p do for i = 1, n do z[j] += Xc[i][j] ^ 2 end end
	local r = table.clone(yc) -- остатки при b = 0
	for _ = 1, maxIter or 5000 do
		local maxDelta = 0
		for j = 1, p do
			local rho = 0
			for i = 1, n do rho += Xc[i][j] * (r[i] + Xc[i][j] * b[j]) end
			local mag = math.max(math.abs(rho) - lambda / 2, 0)
			local nb = (if rho >= 0 then mag else -mag) / z[j]
			local d = nb - b[j]
			if d ~= 0 then
				for i = 1, n do r[i] -= Xc[i][j] * d end
				b[j] = nb
				maxDelta = math.max(maxDelta, math.abs(d))
			end
		end
		if maxDelta < (tol or 1e-12) then break end
	end
	return intercept(xm, ym, b), b
end

function MathCore.predict(b0: number, b: Vector, Xs: Matrix): Vector
	local out = table.create(#Xs)
	for i, row in Xs do
		local s = b0
		for j = 1, #b do s += row[j] * b[j] end
		out[i] = s
	end
	return out
end

-- R² = 1 − SS_res/SS_tot; возвращает и обе суммы для визуализации
function MathCore.r2(y: Vector, yhat: Vector): (number, number, number)
	local ym = MathCore.mean(y)
	local res, tot = 0, 0
	for i = 1, #y do
		res += (y[i] - yhat[i]) ^ 2
		tot += (y[i] - ym) ^ 2
	end
	return 1 - res / tot, res, tot
end

-- ───── 2D experience и лор ─────

-- Корреляция Пирсона
function MathCore.corr(a: Vector, b: Vector): number
	local ma, mb = MathCore.mean(a), MathCore.mean(b)
	local sab, saa, sbb = 0, 0, 0
	for i = 1, #a do
		local da, db = a[i] - ma, b[i] - mb
		sab += da * db; saa += da * da; sbb += db * db
	end
	return sab / math.sqrt(saa * sbb)
end

-- L(m) = a·m² + b·m + k для прямой, вращаемой вокруг (pivotX, h) (2D.1). При pivotX = x̄:
-- a = Σ(Δx)², b = −2·ΣΔxΔy, k = Σ(Δy)² + n·(ȳ − h)².
function MathCore.slopeLoss(x: Vector, y: Vector, h: number, pivotX: number): (number, number, number)
	local a, b, k = 0, 0, 0
	for i = 1, #x do
		local u, w = x[i] - pivotX, y[i] - h
		a += u * u; b -= 2 * u * w; k += w * w
	end
	return a, b, k
end

-- dL/dc = −2·Σ(yᵢ − m·xᵢ − c) (2D.3)
function MathCore.dLdc(x: Vector, y: Vector, m: number, c: number): number
	local s = 0
	for i = 1, #x do s += y[i] - m * x[i] - c end
	return -2 * s
end

-- Минимум L(m) + штраф при оптимальном c (2D.6): L2 → Sxy/(Sxx + λ); L1 → S(2·Sxy, λ)/(2·Sxx)
function MathCore.penalizedMin1d(x: Vector, y: Vector, lambda: number, kind: string): number
	local o = MathCore.ols1d(x, y)
	if kind == "l2" then
		return o.sxy / (o.sxx + lambda)
	end
	local mag = math.max(math.abs(2 * o.sxy) - lambda, 0)
	return (if o.sxy >= 0 then mag else -mag) / (2 * o.sxx)
end

-- Коэффициенты стандартизованной модели → исходные единицы: ŷ = a0 + Σ a_j·x_j
function MathCore.toRawUnits(b0: number, b: Vector, means: Vector, sds: Vector): (number, Vector)
	local a = table.create(#b)
	local a0 = b0
	for j = 1, #b do
		a[j] = b[j] / sds[j]
		a0 -= a[j] * means[j]
	end
	return a0, a
end

-- G = XcᵀXc (2 признака): SSE(b) = SSE(b̂) + (b − b̂)ᵀ·G·(b − b̂) — эллипсы уровня в 2D.5
function MathCore.gram(Xs: Matrix): Matrix
	local Xc = centered(Xs, table.create(#Xs, 0))
	local p = #Xc[1]
	local G = table.create(p)
	for a = 1, p do
		G[a] = table.create(p, 0)
		for b = 1, p do
			for i = 1, #Xc do G[a][b] += Xc[i][a] * Xc[i][b] end
		end
	end
	return G
end

-- Сумма квадратов остатков при коэффициентах b и оптимальном свободном члене
function MathCore.sseCoef(Xs: Matrix, y: Vector, b: Vector): number
	local _, _, xm, ym = centered(Xs, y)
	local b0 = intercept(xm, ym, b)
	local s = 0
	for i, row in Xs do
		local e = y[i] - b0
		for j = 1, #b do e -= row[j] * b[j] end
		s += e * e
	end
	return s
end

-- Собственные числа и векторы симметричной 2×2 (по возрастанию): w1, w2, v1, v2
local function eig2(G: Matrix): (number, number, Vector, Vector)
	local a, b, d = G[1][1], G[1][2], G[2][2]
	local tr, det = a + d, a * d - b * b
	local disc = math.sqrt(math.max(tr * tr / 4 - det, 0))
	local w1, w2 = tr / 2 - disc, tr / 2 + disc
	local v1: Vector
	if math.abs(b) > 1e-12 then
		v1 = { w1 - d, b }
	else
		v1 = if a <= d then { 1, 0 } else { 0, 1 }
	end
	local len = math.sqrt(v1[1] ^ 2 + v1[2] ^ 2)
	v1 = { v1[1] / len, v1[2] / len }
	return w1, w2, v1, { -v1[2], v1[1] }
end
MathCore._eig2 = eig2

-- Точка эллипса (b − c)ᵀG(b − c) = level, параметр t ∈ [0; 2π)
function MathCore.ellipsePoint(G: Matrix, center: Vector, level: number, t: number): Vector
	local w1, w2, v1, v2 = eig2(G)
	local p, q = math.sqrt(level / w1) * math.cos(t), math.sqrt(level / w2) * math.sin(t)
	return { center[1] + v1[1] * p + v2[1] * q, center[2] + v1[2] * p + v2[2] * q }
end

-- Путь коэффициентов на сетке λ (считать один раз при входе в сцену): { lambdas, b0s, coefs }
function MathCore.path(kind: string, Xs: Matrix, y: Vector, lambdaMax: number, steps: number)
	local lambdas, b0s, coefs = table.create(steps + 1), table.create(steps + 1), table.create(steps + 1)
	for i = 0, steps do
		local lam = lambdaMax * i / steps
		local b0, b
		if kind == "l2" then
			b0, b = MathCore.ridge(Xs, y, lam)
		else
			b0, b = MathCore.lasso(Xs, y, lam)
		end
		lambdas[i + 1], b0s[i + 1], coefs[i + 1] = lam, b0, b
	end
	return { lambdas = lambdas, b0s = b0s, coefs = coefs, lambdaMax = lambdaMax, steps = steps }
end

-- Коэффициенты на пути при произвольном λ (линейная интерполяция между узлами сетки;
-- точные нули Lasso сохраняются, если оба соседних узла — нули)
function MathCore.pathAt(path, lambda: number): (number, Vector)
	local f = math.clamp(lambda / path.lambdaMax, 0, 1) * path.steps
	local i = math.floor(f)
	if i >= path.steps then
		return path.b0s[path.steps + 1], table.clone(path.coefs[path.steps + 1])
	end
	local t = f - i
	local a, b = path.coefs[i + 1], path.coefs[i + 2]
	local out = table.create(#a)
	for j = 1, #a do
		out[j] = if a[j] == b[j] then a[j] else a[j] + (b[j] - a[j]) * t
	end
	return path.b0s[i + 1] + (path.b0s[i + 2] - path.b0s[i + 1]) * t, out
end

return MathCore
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">Scenes</string>
        </Properties>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Flow3D</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Flow3D: машина сцен 3D experience (3D.1 → 3D.6 → «2D»: дальше ведёт SceneMachine экранов 2D и лора).
-- Каждая сцена: enter(flow), exit(flow)?, update(flow, snap)?, canAdvance(flow, snap), hintTargets(flow).
-- Переход только по действию игрока; анимации ≤ 3 с; подсказки — 3 уровня («?» или 45 с без прогресса).

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local Records = require(Regression.Core.Records)
local Format = require(Regression.Core.Format)
local Theme = require(Regression.UI.Theme)
local Strings = require(Regression.UI.Strings)

local Flow3D = {}
Flow3D.__index = Flow3D

local ORDER = { "3D.1", "3D.2", "3D.3", "3D.4", "3D.5", "3D.6", "2D" }

local function allTrue(t: { boolean }, n: number): boolean
	for i = 1, n do
		if not t[i] then
			return false
		end
	end
	return true
end

-- ctx: store, hud, bed, board, nextBoard, controls, lineModel, MathCore, open2D (открыть экран 2D), onMilestone?
function Flow3D.new(ctx)
	local self = setmetatable({}, Flow3D)
	for k, v in ctx do
		self[k] = v
	end
	self.n = self.lineModel.n
	self.index = 0
	self.threadStart = {} -- i → os.clock() начала анимации нити
	self.squareStart = {}
	self.manualThreads = 0
	self.lastProgress = os.clock()
	self.hintLevel = 0
	self.highlights = {}
	self.watchers = {}
	self.scenes = self:_buildScenes()

	for i, f in self.bed.flowers do
		f.prompt.Triggered:Connect(function()
			self:_onFlowerPrompt(i)
		end)
	end
	self.bed.controlPrompt.Triggered:Connect(function()
		self.controls:enter()
	end)
	self.hud.onHintRequest = function()
		self:requestHint()
	end
	return self
end

function Flow3D:start()
	self:goto(1)
end

function Flow3D:sceneId(): string
	return ORDER[self.index]
end

function Flow3D:progress()
	self.lastProgress = os.clock()
end

function Flow3D:goto(i: number)
	local cur = self.scenes[ORDER[self.index]]
	if cur and cur.exit then
		cur.exit(self)
	end
	self.index = i
	local id = ORDER[i]
	self.store:set("scene", id)
	self.hud:setStep(id)
	self:clearHint()
	self:progress()
	self.scenes[id].enter(self)
end

function Flow3D:addHoney(n: number)
	local v = (self.store:get("honey") or 0) + n
	self.store:set("honey", v)
	self.hud:setHoney(v)
end

function Flow3D:setPrediction(key: string, value: number)
	local p = table.clone(self.store:get("predictions") or {})
	p[key] = value
	self.store:set("predictions", p)
end

-- ───── анимации нитей и квадратов ─────

function Flow3D:visuals(now: number)
	local tg, sg = {}, {}
	local animating = false
	for i = 1, self.n do
		local ts, ss = self.threadStart[i], self.squareStart[i]
		tg[i] = if ts then math.clamp((now - ts) / Config.THREAD_GROW_S, 0, 1) else 0
		sg[i] = if ss then math.clamp((now - ss) / Config.SQUARE_GROW_S, 0, 1) else 0
		if (ts and tg[i] < 1) or (ss and sg[i] < 1) then
			animating = true
		end
	end
	return { threadGrow = tg, squareGrow = sg, animating = animating }
end

function Flow3D:drawThread(i: number, delay: number?)
	local threads = table.clone(self.store:get("threads"))
	if threads[i] then
		return
	end
	threads[i] = true
	self.store:set("threads", threads)
	self.threadStart[i] = os.clock() + (delay or 0)
	self.bed.flowers[i].prompt.ActionText = Strings.prompt.card
	self:progress()
end

function Flow3D:_onFlowerPrompt(i: number)
	if self:sceneId() == "3D.2" and not self.store:get("threads")[i] then
		self.manualThreads += 1
		self:drawThread(i)
		if self.manualThreads == 1 then
			self.board:setMessage(Strings.msg.firstThread, Theme.color.residual)
		end
		local threads = self.store:get("threads")
		if self.manualThreads >= Config.MANUAL_THREADS_BEFORE_AUTO and not allTrue(threads, self.n) then
			self.hud:setAction("primary", Strings.hud.restThreads, function()
				local k = 0
				for j = 1, self.n do
					if not self.store:get("threads")[j] then
						self:drawThread(j, k * 0.12)
						k += 1
					end
				end
				self.hud:setAction("primary", nil)
			end)
		end
	elseif self.store:get("threads")[i] then
		self.bed:toggleCard(i)
		self.store:set("cardsTick", os.clock()) -- перерисовать клумбу
	end
end

-- ───── запись точки на табло (R, кнопка табло, кнопка пульта) ─────

function Flow3D:record()
	local st = self.store
	if not st:get("recordEnabled") then
		return
	end
	local snap = self.lineModel:compute(st:get("m"), st:get("h"))
	local records = st:get("records")
	local ok, reason, other = Records.validate(records, snap.m, snap.h)
	if not ok then
		if reason == "too_close" and other then
			self.hud:toast(Strings.msg.recordTooClose:format(Format.coef(other.m)), Theme.color.c)
		else
			self.hud:toast(Strings.msg.recordFull, Theme.color.c)
		end
		return
	end
	records = Records.add(records, { m = snap.m, mse = snap.mse, h = snap.h })
	st:set("records", records)
	self.hud:toast(Strings.msg.recordAdded:format(Format.coef(snap.m), Format.mse(snap.mse)), Theme.color.loss)
	self.hud:flash(self.board.recordBtn)
	self:progress()

	local cur = Records.atHeight(records, snap.h)
	if #cur == Config.ONE_SIDE_CHECK_AFTER then
		if Records.oneSide(cur, self.lineModel.mOpt) then
			self.board:setMessage(Strings.msg.oneSide, Theme.color.c)
			self.hud:toast(Strings.msg.oneSide, Theme.color.c)
		elseif (st:get("predictions") or {}).minimum == nil then
			self.hud:ask(Strings.predictions.minimum, function(k)
				self:setPrediction("minimum", k)
				self:progress()
			end)
		end
	end
end

-- ───── подсказки ─────

function Flow3D:clearHighlights()
	for _, h in self.highlights do
		h:Destroy()
	end
	self.highlights = {}
end

function Flow3D:highlight(targets: { Instance })
	self:clearHighlights()
	for _, t in targets do
		local h = Instance.new("Highlight")
		h.FillColor = Theme.color.loss
		h.FillTransparency = 0.75
		h.OutlineColor = Theme.color.loss
		h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Adornee = t
		h.Parent = t
		table.insert(self.highlights, h)
	end
end

function Flow3D:clearHint()
	self.hintLevel = 0
	self.hud:hideHint()
	self:clearHighlights()
end

function Flow3D:showHint(level: number)
	local id = self:sceneId()
	local texts = Strings.hints[id]
	local scene = self.scenes[id]
	if not texts or not scene then
		return
	end
	self.hintLevel = level
	local text = texts[level]
	if scene.hintText then
		text = scene.hintText(self, level) or text
	end
	self.hud:showHint(level, text)
	if scene.hintTargets then
		self:highlight(scene.hintTargets(self))
	end
	local shownLevel = level
	task.delay(15, function()
		if self.hintLevel == shownLevel and self:sceneId() == id then
			self.hud:hideHint()
			self:clearHighlights()
		end
	end)
end

function Flow3D:requestHint()
	self:showHint(math.min(self.hintLevel + 1, 3))
	self:progress()
end

-- ───── кадр ─────

function Flow3D:tick(snap, now: number)
	local st = self.store
	local id = self:sceneId()
	local scene = self.scenes[id]
	if scene.update then
		scene.update(self, snap)
	end
	for _, w in table.clone(self.watchers) do
		w(self, snap)
	end

	-- кнопка «Управлять прямой» для телефона и мыши
	local wantControlBtn = st:get("controlUnlocked") == true and st:get("inZone") == true and not st:get("controlMode")
	if wantControlBtn ~= self.controlBtnShown then
		self.controlBtnShown = wantControlBtn
		if wantControlBtn then
			self.hud:setAction("control", Strings.hud.control, function()
				self.controls:enter()
			end)
		else
			self.hud:setAction("control", nil)
		end
	end

	if scene.canAdvance and scene.canAdvance(self, snap) and self.index < #ORDER then
		self:goto(self.index + 1)
		return
	end

	-- 45 с без прогресса → следующий уровень подсказки (автоматически не дальше 2-го)
	if now - self.lastProgress > Config.HINT_IDLE_S and self.hintLevel < 2 then
		self:showHint(self.hintLevel + 1)
		self:progress()
	end
end

function Flow3D:watch(fn)
	table.insert(self.watchers, fn)
	return function()
		local i = table.find(self.watchers, fn)
		if i then
			table.remove(self.watchers, i)
		end
	end
end

-- ───── сцены ─────

function Flow3D:_buildScenes()
	local scenes = {}

	scenes["3D.1"] = {
		enter = function(f)
			f.board:setActive(false)
			f.board:setMessage(Strings.msg.idle)
		end,
		canAdvance = function(f)
			return f.store:get("inZone") == true
		end,
		exit = function(f)
			f.board:setActive(true)
		end,
		hintTargets = function(f)
			return { f.bed.soil }
		end,
	}

	scenes["3D.2"] = {
		enter = function(f)
			for _, fl in f.bed.flowers do
				f.controls:setPromptWanted(fl.prompt, true)
			end
		end,
		canAdvance = function(f)
			if not allTrue(f.store:get("threads"), f.n) then
				return false
			end
			local v = f:visuals(os.clock())
			for i = 1, f.n do
				if v.threadGrow[i] < 1 then
					return false
				end
			end
			return true
		end,
		exit = function(f)
			f.hud:setAction("primary", nil)
			f.board:setMessage(Strings.msg.threadsDone)
		end,
		hintTargets = function(f)
			local t = {}
			for i, fl in f.bed.flowers do
				if not f.store:get("threads")[i] then
					table.insert(t, fl.model)
				end
			end
			return t
		end,
	}

	scenes["3D.3"] = {
		enter = function(f)
			for i = 1, f.n do
				f.squareStart[i] = os.clock() + (i - 1) * 0.08
			end
			f.store:set("showMseFormula", true)
			f.board:setMessage(Strings.msg.squares, Theme.color.residual)
			f.hud:ask(Strings.predictions.squaresUp, function(k)
				f:setPrediction("squaresUp", k)
				f.store:set("controlUnlocked", true)
				f.controls:setPromptWanted(f.bed.controlPrompt, true)
				f.board:setMessage(Strings.msg.squares .. "\n" .. Strings.msg.controlHint, Theme.color.residual)
				f:progress()
				-- ответ на ставку — после действия: прямая выше всех цветков и поднята ещё на 0,1 м
				-- (тогда все e < 0 и каждый квадрат растёт с высотой — ответ «вырастут» верен строго)
				local crossH = nil
				local stop
				stop = f:watch(function(ff, snap)
					for i = 1, ff.n do
						if snap.e[i] >= 0 then
							crossH = nil
							return
						end
					end
					if crossH == nil then
						crossH = snap.h
						ff.hud:toast(Strings.msg.aboveAll, Theme.color.residual)
						return
					end
					if snap.h >= crossH + 0.1 - 1e-9 then
						stop()
						local correct = k == 1
						ff.hud:resolve(correct, Strings.predictions.squaresUp.reveal)
						if correct then
							ff:addHoney(1)
						end
					end
				end)
			end)
		end,
		update = function(f)
			if f.store:get("movedSlope") and not f.sawSlope then
				f.sawSlope = true
				f:progress()
			end
			if f.store:get("movedHeight") and not f.sawHeight then
				f.sawHeight = true
				f:progress()
			end
		end,
		canAdvance = function(f)
			local st = f.store
			return st:get("controlUnlocked") and st:get("movedSlope") and st:get("movedHeight")
		end,
		hintText = function(f, level)
			if not f.store:get("controlUnlocked") then
				return Strings.hints.betFirst
			end
			return nil
		end,
		hintTargets = function(f)
			return { if f.store:get("controlMode") then f.bed.line else f.bed.pedestal }
		end,
	}

	scenes["3D.4"] = {
		enter = function(f)
			f.store:set("recordEnabled", true)
			f.board:setMessage(Strings.msg.recordHint)
			f.lastRecordH = f.store:get("h")
		end,
		update = function(f, snap)
			-- высота сменилась при наличии записей — прежние бледнеют
			if not Records.sameHeight(snap.h, f.lastRecordH) then
				f.lastRecordH = snap.h
				local recs = f.store:get("records")
				if #recs > #Records.atHeight(recs, snap.h) then
					f.board:setMessage(Strings.msg.heightChanged, Theme.color.c)
				end
			end
		end,
		canAdvance = function(f, snap)
			return #Records.atHeight(f.store:get("records"), snap.h) >= Records.NEED
		end,
		exit = function(f)
			f.store:set("recordEnabled", false)
		end,
		hintTargets = function(f)
			return { f.bed.line, f.board.screen }
		end,
	}

	scenes["3D.5"] = {
		enter = function(f)
			local h = f.store:get("h")
			local cur = Records.atHeight(f.store:get("records"), h)
			local P = Records.fit(f.MathCore, cur)
			P.h = h
			P.records = cur
			f.store:set("parabola", P)
			f.store:set("mSnap", { target = P.tStar, tol = Config.SNAP_TOL })
			f.board:setMessage(Strings.msg.parabola:format(Format.coef(P.tStar), Format.num(math.deg(math.atan(P.tStar)), 1), Format.mse(P.vStar)), Theme.color.loss)
			local pick = (f.store:get("predictions") or {}).minimum
			if pick then
				local region = if P.tStar < 0 then 1 elseif P.tStar <= 0.5 then 2 else 3
				f.hud:resolve(pick == region, Strings.predictions.minimum.reveal:format(Format.coef(P.tStar)))
				if pick == region then
					f:addHoney(1)
				end
			else
				f.hud:closePrediction()
			end
		end,
		canAdvance = function(f, snap)
			local P = f.store:get("parabola")
			return P ~= nil and math.abs(snap.m - P.tStar) < 1e-9
		end,
		hintText = function(f, level)
			if level == 2 then
				local P = f.store:get("parabola")
				return Strings.hints["3D.5"][2]:format(Format.coef(P.tStar), Format.coef(f.store:get("m")))
			end
			return nil
		end,
		hintTargets = function(f)
			return { f.bed.line }
		end,
	}

	scenes["3D.6"] = {
		enter = function(f)
			if f.onMilestone then
				f.onMilestone("regression_3d") -- оптимальный наклон найден: 3D experience пройдено
			end
			local P = f.store:get("parabola")
			f.board:setMessage(Strings.msg.optimumFound .. "\n" .. Strings.msg.bestLineTip, Theme.color.good)
			f.hud:toast(Strings.msg.optimumFound, Theme.color.good)
			f.nextBoard:setParabola(P, P.records)
			f.nextBoard:rise(function()
				f.hud:toast(Strings.msg.nextBoard)
			end)
			-- бонус: лучшая прямая (m = m*, h = ȳ = 1,5 м) — в любой момент после 3D.5
			local stop
			stop = f:watch(function(ff, snap)
				if math.abs(snap.m - P.tStar) < 1e-9 and math.abs(snap.h - Config.BEST_H) < 1e-3 then
					stop()
					ff:addHoney(1)
					ff.board:setMessage(Strings.msg.bestLine:format(Format.mse(snap.mse)), Theme.color.good)
					ff.hud:toast(Strings.msg.bestLine:format(Format.mse(snap.mse)), Theme.color.good)
				end
			end)
		end,
		canAdvance = function(f)
			return f.store:get("opened2D") == true
		end,
		hintTargets = function(f)
			return { f.nextBoard.screen }
		end,
	}

	-- 3D пройдено: дальше экраны 2D (второе табло) и лор-задача — их ведёт SceneMachine
	scenes["2D"] = {
		enter = function(f) end,
		canAdvance = function()
			return false
		end,
	}

	return scenes
end

-- Вызывается вторым табло
function Flow3D:openScreen2D()
	self.controls:exit()
	self.store:set("opened2D", true)
	self:progress()
	if self.open2D then
		self.open2D()
	end
end

return Flow3D
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="29">
          <Properties>
            <string name="Name">Lore</string>
          </Properties>
          <Item class="ModuleScript" referent="30">
            <Properties>
              <string name="Name">LoreScenes</string>
              <string name="Source"><![CDATA[--!nonstrict
-- Лор-задача: прогноз мёда для своей пасеки по данным пяти других пасек (lore-task.md).
--   L.0 (мир)    дойти до пасечника — «Поговорить»
--   L.1 (экран)  таблица пасек + подсказка; выбор метода OLS / Ridge / Lasso (ошибка не блокирует — напоминание и повтор)
--   L.2 (экран)  λ = 2,5 с пояснением; «Обучить» → коэффициенты и формула в исходных единицах
--   L.3 (мир)    у каждого улья: «Посчитать пчёл», дойти до поляны — «Измерить расстояние», «Внести» → прогноз;
--                после первого улья — пчела-помощник считает пчёл в остальных (до полян игрок ходит сам)
--   L.4 (мир)    «Собрать мёд» у каждого улья → реальный мёд рядом с прогнозом
--   L.5 (экран)  R² как в 2D.7 (игрок сам собирает SS_res и SS_tot) → «А если бы OLS?» → награда и выход
-- Мир пасеки (LoreWorld) кладёт в machine.shared.loreWorld точка входа RegressionClient.

local Regression = script.Parent.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)
local R2View = require(Regression.UI.R2View)
local S2D7 = require(Regression.Scenes.Screens2D.S2D_7_R2)

local S = Strings.lore
local MANUAL_HIVES = 1 -- после стольких ульев, внесённых вручную, появляется пчела-помощник

-- ───── модель (числа — только из MathCore) ─────

local function model(sc)
	local shared = sc.shared
	if shared.loreModel then
		return shared.loreModel
	end
	local L, MathCore = sc.Datasets.lore, sc.MathCore
	local X, y = {}, {}
	for i, a in L.train_apiaries do
		local row = {}
		for j, f in L.features do row[j] = a[f] end
		X[i], y[i] = row, a.honey_kg
	end
	local Z, mu, sd = MathCore.standardize(X)
	local b0, b = MathCore.lasso(Z, y, L.lambda_given)
	local a0, a = MathCore.toRawUnits(b0, b, mu, sd)
	local o0, ob = MathCore.ols(Z, y)
	local oa0, oa = MathCore.toRawUnits(o0, ob, mu, sd)
	local bees, temp = MathCore.column(X, 2), MathCore.column(X, 3)
	local m = {
		X = X, y = y, mu = mu, sd = sd, b0 = b0, b = b, a0 = a0, a = a, lambda = L.lambda_given,
		ols = { b0 = o0, b = ob, a0 = oa0, a = oa }, corr = MathCore.corr(bees, temp),
	}
	-- прогноз по исходным единицам признаков (расстояние, пчёлы, температура)
	function m.predict(row: { number }, which: string?): number
		local w = if which == "ols" then m.ols else m
		local s = w.a0
		for j = 1, 3 do s += w.a[j] * row[j] end
		return s
	end
	shared.loreModel = m
	shared.lore = shared.lore or { bees = {}, dist = {}, entered = {}, pred = {}, real = {}, manual = 0, helper = false }
	return m
end

local function hiveRow(sc, i: number): { number }
	local h = sc.Datasets.lore.player_hives[i]
	return { h.distance_to_meadow_m, h.bees_k, h.temperature_C }
end

local function kg(v: number): string
	return Format.unit(v, 2, "кг")
end

local function cardText(sc, i: number): string
	local st = sc.shared.lore
	local lines = { S.cardTitle:format(i) }
	table.insert(lines, S.cardBees:format(if st.bees[i] then Format.num(st.bees[i], 1) else "?"))
	table.insert(lines, S.cardDist:format(if st.dist[i] then Format.num(st.dist[i], 0) else "?"))
	if st.pred[i] then
		table.insert(lines, Theme.tok("loss", S.cardPred:format(kg(st.pred[i]))))
	end
	if st.real[i] then
		table.insert(lines, S.cardReal:format(kg(st.real[i]), Format.signed(st.real[i] - st.pred[i], 2)))
	end
	return table.concat(lines, "\n")
end

-- ───── L.0 к пасечнику ─────

local L0 = { id = "L.0", panel = false }

function L0.enter(sc)
	local lw = sc.shared.loreWorld
	model(sc)
	sc.s.talked = false
	lw.npcPrompt.Enabled = true
	lw:setBeacon(lw.npc.PrimaryPart)
	sc:conn(lw.npcPrompt.Triggered:Connect(function()
		sc.s.talked = true
		sc:progress()
	end))
	sc:toast(S.goToNpc, Theme.color.c)
end

function L0.exit(sc)
	sc.shared.loreWorld:setBeacon(nil)
end

function L0.canAdvance(sc)
	return sc.s.talked
end

function L0.hintTargets(sc)
	return { sc.shared.loreWorld.npc }
end

-- ───── L.1 выбор метода ─────

local L1 = { id = "L.1", panel = true, autoAdvance = true }

function L1.enter(sc)
	local m = model(sc)
	local L = sc.Datasets.lore
	local main = sc.shell.main
	-- таблица пяти пасек
	local tbl = Gui.frame({ BackgroundColor3 = Theme.color.panel, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = main })
	Gui.corner().Parent = tbl
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), Parent = tbl })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2), Parent = tbl })
	local function row(cells, order, header)
		local r = Gui.frame({ BackgroundTransparency = if header then 1 else 0.9, BackgroundColor3 = Theme.color.panel2, Size = UDim2.new(1, 0, 0, 34),
			LayoutOrder = order, Parent = tbl })
		for k, text in cells do
			Gui.label({ Text = text, TextSize = if header then 16 else 19, Font = if header then Theme.font else Theme.fontMedium,
				TextColor3 = if header then Theme.color.textDim else (if k == 4 then Theme.color.m_temp else Theme.color.text),
				TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale((k - 1) / 5, 0), Size = UDim2.fromScale(1 / 5, 1), Parent = r })
		end
	end
	row(S.columns, 0, true)
	for i, a in L.train_apiaries do
		row({ tostring(a.apiary), Format.num(a.distance_to_meadow_m, 0), Format.num(a.bees_k, 1), Format.num(a.temperature_C, 1), Format.num(a.honey_kg, 1) }, i)
	end
	Gui.label({ Text = S.corrNote:format(Format.num(m.corr, 2)), TextSize = 18, TextColor3 = Theme.color.m_temp, Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 10, Parent = tbl })

	sc.shell:setText(S.npcSays)
	for k, opt in S.methods do
		sc.shell:button(opt.label, { order = k, onClick = function()
			if sc.s.chosen then
				return
			end
			sc:progress()
			if opt.id == "l1" then
				sc.s.chosen = true
				sc.shell:toast(S.methodOk, Theme.color.good)
				sc:honey(1)
			else
				sc.s.wrong = (sc.s.wrong or 0) + 1
				sc.shell:setText(S.npcSays .. "\n\n" .. Theme.tok("c", opt.reply))
			end
		end })
	end
end

function L1.canAdvance(sc)
	return sc.s.chosen == true
end

-- ───── L.2 модель ─────

local L2 = { id = "L.2", panel = true }
L2.nextLabel = S.toWorld

function L2.enter(sc)
	local m = model(sc)
	local s = sc.s
	s.trained = false
	local main = sc.shell.main
	Gui.label({ Text = S.coefsTitle, Font = Theme.fontBold, TextSize = 20, Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -56, 0, 26), Parent = main })
	local inner = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26), Parent = main })
	s.plot = PlotView2D.new(inner, {
		xMin = 0, xMax = 4, yMin = -16, yMax = 18, xTicks = {}, yTicks = { -15, -10, -5, 0, 5, 10, 15 },
		yLabel = S.coefsAxis, padL = 52, padR = 10, padT = 14, padB = 56, fontSize = 15, fallbackW = 420, fallbackH = 400,
	})
	s.plot.onResize = function() L2.draw(sc) end
	s.trainBtn = sc.shell:button(S.train, { order = 1, color = Theme.color.loss, textColor = Theme.color.bg, onClick = function()
		if s.trained then
			return
		end
		s.trained = true
		s.trainBtn.Visible = false
		sc.store:set("loreTrained", true)
		sc.shell:setText(S.lambdaWhy:format(Format.lambda(m.lambda)) .. "\n\n" .. S.interpret:format(Format.num(-m.a[1] * 100, 2), Format.num(m.a[2], 2)))
		sc:progress()
		L2.draw(sc)
	end })
	local T = sc.T
	sc:formula({
		id = "LORE_LAMBDA", title = S.lambdaTitle,
		lines = { { id = "eq", open = true, general = { T.sym("λ", "penalty"), " = ", T.col(Format.lambda(m.lambda), "penalty") } } },
	})
	sc:formula({
		id = "LORE_MODEL", title = S.modelTitle, toNotebook = true,
		lines = {
			{ id = "std", hint = S.lockTrain,
				general = { T.hat("y"), " = ", T.sub("b", "0"), " + ", T.sub("b", "р", "m_dist"), "·", T.sub("z", "расст"), " + ", T.sub("b", "п", "m"), "·", T.sub("z", "пчёлы"),
					" + ", T.sub("b", "т", "m_temp"), "·", T.sub("z", "темп") },
				numbers = function()
					return { T.hat("y"), " = ", Format.num(m.b0, 1), " ", Format.MINUS, " ", T.col(Format.num(-m.b[1], 2), "m_dist"), "·", T.sub("z", "р"),
						" + ", T.col(Format.num(m.b[2], 2), "m"), "·", T.sub("z", "п"), " + ", T.col(Format.num(m.b[3], 0), "m_temp"), "·", T.sub("z", "т") }
				end },
			{ id = "raw", hint = S.lockTrain,
				general = { S.honeyWord, " = ", T.sub("a", "0"), " + ", T.sub("a", "р", "m_dist"), "·", S.distWord, " + ", T.sub("a", "п", "m"), "·", S.beesWord },
				numbers = function()
					return { S.honeyWord, " = ", Format.num(m.a0, 2), " ", Format.MINUS, " ", T.col(Format.num(-m.a[1], 4), "m_dist"), "·", S.distWord, " + ",
						T.col(Format.num(m.a[2], 3), "m"), "·", S.beesWord }
				end },
		},
	})
	sc.shell:setText(S.lambdaGiven:format(Format.lambda(m.lambda)))
	L2.draw(sc)
end

function L2.draw(sc)
	local s, m = sc.s, model(sc)
	local L = s.plot:layer("bars", 3)
	L:begin()
	if s.trained then
		local colors = { Theme.color.m_dist, Theme.color.m, Theme.color.m_temp }
		for j = 1, 3 do
			local v = m.b[j]
			L:rect(j - 0.3, 0, j + 0.3, v, { color = colors[j], transparency = 0.1 })
			L:label(j, v, Format.num(v, 2), { anchor = Vector2.new(0.5, if v >= 0 then 1 else 0), dy = if v >= 0 then -2 else 2, size = 18, font = Theme.fontBold })
			local px = s.plot:toPx(j, 0)
			local _, ph = s.plot:size()
			L:labelPx(px, ph + 6, S.featureNames[j], { anchor = Vector2.new(0.5, 0), size = 15, color = colors[j] })
		end
		L:label(3, 0, S.tempOff, { anchor = Vector2.new(0.5, 1), dy = -26, size = 15, color = Theme.color.m_temp })
	end
	L:finish()
end

L2.unlocks = {
	{ formula = "LORE_MODEL", line = "std", when = function(sc) return sc.s.trained end },
	{ formula = "LORE_MODEL", line = "raw", when = function(sc) return sc.s.trained end },
}

function L2.canAdvance(sc)
	return sc.s.trained == true
end

-- ───── L.3 сбор данных ─────

local L3 = { id = "L.3", panel = false }

function L3.enter(sc)
	local lw = sc.shared.loreWorld
	local m = model(sc)
	local st = sc.shared.lore
	local n = #sc.Datasets.lore.player_hives
	for i = 1, n do
		local h = lw.hives[i]
		h.prompt.ActionText = S.promptCount
		h.prompt.Enabled = st.bees[i] == nil
		lw.meadows[i].prompt.Enabled = st.dist[i] == nil
		lw:setCard(i, cardText(sc, i))
		sc:conn(h.prompt.Triggered:Connect(function()
			if st.bees[i] == nil then
				st.bees[i] = sc.Datasets.lore.player_hives[i].bees_k
				h.prompt.Enabled = false
				sc:toast(S.beesCounted:format(i, Format.num(st.bees[i], 1)), Theme.color.m)
				L3.changed(sc, i)
			end
		end))
		sc:conn(lw.meadows[i].prompt.Triggered:Connect(function()
			if st.dist[i] == nil then
				st.dist[i] = sc.Datasets.lore.player_hives[i].distance_to_meadow_m
				lw.meadows[i].prompt.Enabled = false
				sc:toast(S.distMeasured:format(i, Format.num(st.dist[i], 0)), Theme.color.m_dist)
				L3.changed(sc, i)
			end
		end))
	end
	sc.s.model = m
	L3.refreshAction(sc)
end

function L3.changed(sc, i: number)
	sc.shared.loreWorld:setCard(i, cardText(sc, i))
	sc.store:set("loreTick", os.clock())
	sc:progress()
	L3.refreshAction(sc)
end

-- Кнопка HUD: «Внести данные улья N» (как только для улья известны оба признака) или пчела-помощник
function L3.refreshAction(sc)
	local st = sc.shared.lore
	local n = #sc.Datasets.lore.player_hives
	for i = 1, n do
		if st.bees[i] and st.dist[i] and not st.entered[i] then
			sc.hud:setAction("primary", S.enter:format(i), function()
				L3.enter_(sc, i)
			end)
			return
		end
	end
	if st.manual >= MANUAL_HIVES and not st.helper then
		local missing = false
		for i = 1, n do
			if st.bees[i] == nil then missing = true end
		end
		if missing then
			sc.hud:setAction("primary", S.helper, function()
				st.helper = true
				local lw = sc.shared.loreWorld
				for k = 1, n do
					if st.bees[k] == nil then
						st.bees[k] = sc.Datasets.lore.player_hives[k].bees_k
						lw.hives[k].prompt.Enabled = false
						lw:setCard(k, cardText(sc, k))
					end
				end
				sc:toast(S.helperDone, Theme.color.c)
				sc.store:set("loreTick", os.clock())
				L3.refreshAction(sc)
			end)
			return
		end
	end
	sc.hud:setAction("primary", nil)
end

function L3.enter_(sc, i: number)
	local st = sc.shared.lore
	if st.entered[i] then
		return
	end
	st.entered[i] = true
	st.manual += 1
	local row = hiveRow(sc, i)
	row[1], row[2] = st.dist[i], st.bees[i]
	st.pred[i] = sc.s.model.predict(row)
	sc:toast(S.predicted:format(i, kg(st.pred[i])), Theme.color.loss)
	L3.changed(sc, i)
end

function L3.exit(sc)
	sc.hud:setAction("primary", nil)
end

function L3.canAdvance(sc)
	local st = sc.shared.lore
	for i = 1, #sc.Datasets.lore.player_hives do
		if not st.entered[i] then
			return false
		end
	end
	return true
end

function L3.hintTargets(sc)
	local st, lw = sc.shared.lore, sc.shared.loreWorld
	for i = 1, #lw.hives do
		if st.bees[i] == nil then
			return { lw.hives[i].model }
		elseif st.dist[i] == nil then
			return { lw.meadows[i].model }
		end
	end
	return {}
end

-- ───── L.4 сбор мёда ─────

local L4 = { id = "L.4", panel = false }

function L4.enter(sc)
	local lw = sc.shared.loreWorld
	local st = sc.shared.lore
	sc:toast(S.season, Theme.color.c)
	for i, h in lw.hives do
		h.prompt.ActionText = S.promptHarvest
		h.prompt.Enabled = st.real[i] == nil
		sc:conn(h.prompt.Triggered:Connect(function()
			if st.real[i] == nil then
				st.real[i] = sc.Datasets.lore.player_hives[i].honey_kg
				h.prompt.Enabled = false
				lw:setCard(i, cardText(sc, i))
				sc:toast(S.harvested:format(i, kg(st.real[i]), kg(st.pred[i])), Theme.color.c)
				sc.store:set("loreTick", os.clock())
				sc:progress()
			end
		end))
	end
end

function L4.canAdvance(sc)
	local st = sc.shared.lore
	for i = 1, #sc.Datasets.lore.player_hives do
		if st.real[i] == nil then
			return false
		end
	end
	return true
end

function L4.hintTargets(sc)
	local st, lw = sc.shared.lore, sc.shared.loreWorld
	for i, h in lw.hives do
		if st.real[i] == nil then
			return { h.model }
		end
	end
	return {}
end

-- ───── L.5 проверка R² ─────

local L5 = { id = "L.5", panel = true, milestone = "regression_lore" }
L5.nextLabel = S.finish

function L5.enter(sc)
	local s, st, m = sc.s, sc.shared.lore, model(sc)
	local n = #sc.Datasets.lore.player_hives
	local xs, real, pred = {}, {}, {}
	for i = 1, n do
		xs[i], real[i], pred[i] = i, st.real[i], st.pred[i]
	end
	s.view = R2View.new(sc.shell.main, {
		x = xs, y = real, yhat = pred, markers = true,
		xMin = 0.5, xMax = n + 0.5, xTicks = xs, yMin = 15, yMax = 45, yTicks = { 15, 20, 25, 30, 35, 40, 45 },
		xLabel = S.hiveAxis, yLabel = Strings.s2d["2D.2"].yLabel, unit = "кг²", meanStart = 18, snapTol = 1.0, store = sc.store,
		onPhase = function(phase)
			sc.shell:setText(Strings.s2d["2D.7"].phase[phase] or "")
			sc:progress()
		end,
		onChanged = function() sc:progress() end,
	})
	sc:conn({ Disconnect = function() s.view:Destroy() end })
	S2D7.formulas(sc, s.view)
	s.olsBtn = sc.shell:button(S.whatIfOls, { order = 1, visible = false, onClick = function()
		if s.olsShown then
			return
		end
		s.olsShown = true
		s.olsBtn.Visible = false
		local olsPred = {}
		for i = 1, n do
			olsPred[i] = m.predict(hiveRow(sc, i), "ols")
		end
		local r2ols = sc.MathCore.r2(real, olsPred)
		local preds = {}
		for i = 1, n do
			table.insert(preds, Format.num(olsPred[i], 1))
		end
		sc.shell:setText(S.olsResult:format(table.concat(preds, "; "), Format.num(r2ols, 2), Format.num(m.ols.b[2], 2), Format.num(m.ols.b[3], 2)))
		sc:note(S.olsNote)
		sc:progress()
	end })
	sc.shell:setText(Strings.s2d["2D.7"].phase.res)
end

L5.unlocks = {
	S2D7.r2Unlocks[1], S2D7.r2Unlocks[2],
	{ formula = "R2", line = "eq", when = S2D7.r2Unlocks[3].when, onUnlock = function(sc)
		sc.s.olsBtn.Visible = true
		sc.shell:setText(S.r2Done)
	end },
}

function L5.canAdvance(sc)
	return sc.s.olsShown == true
end

function L5.exit(sc)
	sc:honey(3)
	if sc.hud then
		sc.hud:toast(S.moduleDone, Theme.color.good)
	end
end

function L5.hintTargets(sc)
	local v = sc.s.view
	if v.phase == "done" then
		return { sc.s.olsBtn }
	end
	return { v.plot.area }
end

function L5.hintText(sc, level)
	local v = sc.s.view
	return Strings.hints["2D.7"][v.phase] and Strings.hints["2D.7"][v.phase][level] or nil
end

return { L0, L1, L2, L3, L4, L5 }
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">SceneMachine</string>
            <string name="Source"><![CDATA[--!nonstrict
-- SceneMachine: сцены 2D experience (экраны 2D.1–2D.7) и лор-задачи (L.1–L.5).
-- Сцена — таблица:
--   id, panel (true — экран в оболочке Shell2D; false — задание в мире, оболочка закрыта, работает HUD),
--   enter(sc), exit(sc)?, update(sc, dt)? (≤ 30 Гц), canAdvance(sc) → boolean,
--   unlocks = { { formula = "DLDC", line = "zero", when = function(sc) … end } } — строка формулы открывается
--     ТОЛЬКО так: машина проверяет условия на каждом кадре и при изменениях Store,
--   hintTargets(sc) → { GuiObject | Instance }?, keepMain (не чистить графики при выходе: 2D.2 → 2D.3),
--   nextLabel (текст кнопки «Дальше»), autoAdvance (для сцен в мире — переход без кнопки).
-- Контекст сцены sc: store, shell, hud, machine, MathCore, Datasets, Format, Theme, Strings, Gui, T (токены формул),
--   f[id] — формулы сцены, s — локальное состояние, shared — общее для сцен,
--   sc:formula(spec), sc:conn(c), sc:keys(name, keys, fn), sc:progress(), sc:honey(n), sc:note(text).

local ContextActionService = game:GetService("ContextActionService")

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local Format = require(Regression.Core.Format)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)
local FormulaView = require(Regression.UI.FormulaView)
local PlayerControls = require(Regression.Input.PlayerControls)

local SceneMachine = {}
SceneMachine.__index = SceneMachine

local PRIORITY = Enum.ContextActionPriority.High.Value

-- ctx: store, shell, hud, MathCore, Datasets, scenes = { spec, … } (по порядку), onMilestone(id)?, onFinished()?
function SceneMachine.new(ctx)
	local self = setmetatable({}, SceneMachine)
	self.store = ctx.store
	self.shell = ctx.shell
	self.hud = ctx.hud
	self.MathCore = ctx.MathCore
	self.Datasets = ctx.Datasets
	self.onMilestone = ctx.onMilestone
	self.onSceneChanged = ctx.onSceneChanged
	self.order = {}
	self.byId = {}
	for i, spec in ctx.scenes do
		self.order[i] = spec.id
		self.byId[spec.id] = spec
	end
	self.index = 0
	self.shared = {}
	self.sc = nil
	self.lastProgress = os.clock()
	self.hintLevel = 0
	self.acc = 0

	self.shell.onNext = function()
		self:advance()
	end
	self.shell.onClose = function()
		PlayerControls.release("shell")
		self:_releaseKeys()
	end
	self.shell.onHint = function()
		self:requestHint()
	end
	self.store.Changed:Connect("*", function(_, key)
		if key ~= "highlight" then
			self:_checkUnlocks()
		end
	end)
	return self
end

function SceneMachine:current()
	return self.byId[self.order[self.index]]
end

function SceneMachine:sceneId(): string?
	return self.order[self.index]
end

function SceneMachine:has(id: string): boolean
	return self.byId[id] ~= nil
end

-- ───── контекст сцены ─────

local Ctx = {}
Ctx.__index = Ctx

function Ctx:formula(spec)
	local fv = self.shell:addFormula(spec, self.s)
	self.f[spec.id] = fv
	return fv
end

function Ctx:conn(c)
	table.insert(self.conns, c)
	return c
end

-- Клавиши сцены (ContextActionService, High + Sink): fn(down: boolean)
function Ctx:keys(name: string, keys: { Enum.KeyCode }, fn: (boolean) -> ())
	local action = "Reg2D_" .. name
	self.keyBinds[action] = { keys = keys, fn = fn }
	if self.machine.shell.isOpen or not self.spec.panel then
		self.machine:_bindKey(action, self.keyBinds[action])
	end
end

function Ctx:progress()
	self.machine:progress()
end

function Ctx:honey(n: number)
	local v = (self.store:get("honey") or 0) + n
	self.store:set("honey", v)
	if self.hud then
		self.hud:setHoney(v)
	end
end

function Ctx:note(text: string)
	self.shell.notebook:addNote(self.id, text)
	local notes = table.clone(self.store:get("notes") or {})
	table.insert(notes, text)
	self.store:set("notes", notes)
end

function Ctx:toast(text: string, color: Color3?)
	if self.spec.panel then
		self.shell:toast(text, color)
	elseif self.hud then
		self.hud:toast(text, color)
	end
end

function Ctx:refresh()
	for _, fv in self.f do
		fv:refresh(self.s)
	end
end

-- ───── переходы ─────

function SceneMachine:_makeCtx(spec)
	return setmetatable({
		id = spec.id, spec = spec, machine = self, store = self.store, shell = self.shell, hud = self.hud,
		MathCore = self.MathCore, Datasets = self.Datasets, Format = Format, Theme = Theme, Strings = Strings, Gui = Gui,
		T = FormulaView.T, Config = Config, f = {}, s = {}, shared = self.shared, conns = {}, keyBinds = {},
	}, Ctx)
end

function SceneMachine:_bindKey(action: string, b)
	ContextActionService:BindActionAtPriority(action, function(_, state)
		if state == Enum.UserInputState.Begin then
			b.fn(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			b.fn(false)
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, table.unpack(b.keys))
end

function SceneMachine:_bindKeys()
	if self.sc then
		for action, b in self.sc.keyBinds do
			self:_bindKey(action, b)
		end
	end
end

function SceneMachine:_releaseKeys()
	if self.sc then
		for action, b in self.sc.keyBinds do
			ContextActionService:UnbindAction(action)
			b.fn(false)
		end
	end
end

function SceneMachine:_exitCurrent()
	local spec, sc = self:current(), self.sc
	if not spec or not sc then
		return
	end
	if spec.exit then
		spec.exit(sc)
	end
	self:_releaseKeys()
	for _, c in sc.conns do
		if typeof(c) == "RBXScriptConnection" or type(c) == "table" then
			c:Disconnect()
		end
	end
	self.shell:clearScene(spec.id, spec.keepMain)
	if self.hud then
		self.hud:setAction("primary", nil)
	end
	self.sc = nil
end

function SceneMachine:goto(id: string)
	local i = table.find(self.order, id)
	assert(i, "SceneMachine: нет сцены " .. tostring(id))
	self:_exitCurrent()
	self.index = i
	local spec = self.byId[id]
	local sc = self:_makeCtx(spec)
	sc.keepFrom = self.shared.keep -- графики, оставленные предыдущей сценой (keepMain)
	self.sc = sc
	self.store:set("scene2d", id)
	self.hintLevel = 0
	self:progress()
	local step = Strings.step[id]
	if self.hud then
		self.hud:setStep(id)
	end
	if spec.panel then
		self.shell:setHeader(id, if step then step.title else id)
		self.shell:setTask(if step then step.task else "")
		self.shell:setNext(false, spec.nextLabel)
		if not self.shell.isOpen then
			self:open()
		end
	else
		if self.shell.isOpen then
			self.shell:close()
			PlayerControls.release("shell")
		end
	end
	spec.enter(sc)
	self:_bindKeys()
	self:_checkUnlocks()
	if self.onSceneChanged then
		self.onSceneChanged(id)
	end
end

function SceneMachine:advance()
	local spec, sc = self:current(), self.sc
	if not spec or not sc or not spec.canAdvance(sc) then
		return
	end
	if spec.milestone and self.onMilestone then
		self.onMilestone(spec.milestone)
	end
	if self.index >= #self.order then
		self:_exitCurrent()
		self.shell:close()
		PlayerControls.release("shell")
		self.finished = true
		if self.onFinished then
			self.onFinished()
		end
		return
	end
	self:goto(self.order[self.index + 1])
end

-- Открыть оболочку (второе табло, NPC); сцена в мире — просто напоминание в HUD
function SceneMachine:open()
	local spec = self:current()
	if spec and not spec.panel then
		return
	end
	self.shell:open()
	PlayerControls.hold("shell")
	self:_bindKeys()
	self:progress()
end

function SceneMachine:start(id: string?)
	self:goto(id or self.order[1])
end

-- ───── открытие строк формул ─────

function SceneMachine:_checkUnlocks()
	local spec, sc = self:current(), self.sc
	if not spec or not sc or not spec.unlocks then
		return
	end
	for _, u in spec.unlocks do
		local fv = sc.f[u.formula]
		if fv and not fv:isUnlocked(u.line) then
			local ok, res = pcall(u.when, sc)
			if ok and res then
				fv:unlock(u.line)
				self:progress()
				if u.onUnlock then
					u.onUnlock(sc)
				end
			elseif not ok then
				warn("unlock " .. u.formula .. "." .. u.line .. ": " .. tostring(res))
			end
		end
	end
end

-- ───── подсказки ─────

function SceneMachine:progress()
	self.lastProgress = os.clock()
end

function SceneMachine:showHint(level: number)
	local spec, sc = self:current(), self.sc
	if not spec or not sc then
		return
	end
	local texts = Strings.hints[spec.id]
	if not texts then
		return
	end
	self.hintLevel = level
	local text = texts[level]
	if spec.hintText then
		text = spec.hintText(sc, level) or text
	end
	local targets = if spec.hintTargets then spec.hintTargets(sc) else {}
	if spec.panel then
		local guiTargets = {}
		for _, t in targets do
			if t:IsA("GuiObject") then
				table.insert(guiTargets, t)
			end
		end
		self.shell:showHint(level, text, guiTargets)
	elseif self.hud then
		self.hud:showHint(level, text)
	end
	local id, shown = spec.id, level
	task.delay(15, function()
		if self.hintLevel == shown and self:sceneId() == id then
			self.shell:hideHint()
			if self.hud then
				self.hud:hideHint()
			end
		end
	end)
end

function SceneMachine:requestHint()
	self:showHint(math.min(self.hintLevel + 1, 3))
	self:progress()
end

-- ───── кадр ─────

function SceneMachine:tick(dt: number)
	local spec, sc = self:current(), self.sc
	if not spec or not sc or self.finished then
		return
	end
	local active = spec.panel and self.shell.isOpen or not spec.panel
	if not active then
		return
	end
	self.acc += dt
	if self.acc >= 1 / Config.UI_HZ then
		local step = self.acc
		self.acc = 0
		if spec.update then
			spec.update(sc, step)
		end
		sc:refresh()
		self:_checkUnlocks()
	end
	local can = spec.canAdvance(sc)
	if can and spec.autoAdvance then
		self:advance()
		return
	end
	if spec.panel then
		if can ~= self.shell.nextEnabled then
			self.shell:setNext(can, spec.nextLabel)
			if can then
				self.shell:flash(self.shell.nextBtn)
			end
		end
	elseif can and spec.autoAdvance ~= false then
		self:advance()
		return
	end
	if os.clock() - self.lastProgress > Config.HINT_IDLE_S and self.hintLevel < 2 then
		self:showHint(self.hintLevel + 1)
		self:progress()
	end
end

return SceneMachine
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="32">
          <Properties>
            <string name="Name">Screens2D</string>
          </Properties>
          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">S2D_1_DerivativeM</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D.1 Минимум параболы — это dL/dm = 0.
-- Парабола игрока из 3D (записи, вершина m*). Действия: «Показать L = n·MSE» (график переходит к сумме L),
-- бегунок с касательной по параболе (перетаскивание, Q/E, кнопки), ставка про наклон касательной в минимуме.
-- Открытие: dL/dm — после первого сдвига бегунка; dL/dm = 0 ⇒ m = ΣΔxΔy / Σ(Δx)² — когда |dL/dm| < 0,3.

local Regression = script.Parent.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)
local Drag = require(Regression.UI.Drag)
local Records = require(Regression.Core.Records)

local S = Strings.s2d["2D.1"]
local M_MIN, M_MAX = -1, 1.5
local RUNNER_SPEED = 0.3 -- м/м в секунду при удержании
local SNAP_TOL = 0.03
local ZERO_TOL = 0.3 -- |dL/dm| < 0,3 — касательная «горизонтальна»

-- Парабола из 3D; если игрок пришёл сюда в обход (отладка) — эталонные записи при h = 1,0
local function parabolaFrom(sc)
	local P = sc.store:get("parabola")
	if P then
		return P
	end
	local fb = sc.Datasets.flowerbed
	local MathCore = sc.MathCore
	local recs = {}
	for _, m in { -0.2, 0.0, 0.2, 0.5, 0.8 } do
		local c = MathCore.lineFromPivot(m, 1.0, fb.pivot_x_m)
		table.insert(recs, { m = m, mse = MathCore.mseLine(fb.x_m, fb.y_m, m, c), h = 1.0 })
	end
	P = Records.fit(MathCore, recs)
	P.h, P.records = 1.0, recs
	return P
end

local scene = { id = "2D.1", panel = true }

function scene.enter(sc)
	local s, T, MathCore = sc.s, sc.T, sc.MathCore
	local fb = sc.Datasets.flowerbed
	local x, y = fb.x_m, fb.y_m
	local P = parabolaFrom(sc)
	local o = MathCore.ols1d(x, y)
	s.P, s.o, s.n = P, o, #x
	s.h = P.h
	s.a, s.b, s.k = MathCore.slopeLoss(x, y, s.h, fb.pivot_x_m)
	s.mStar = o.sxy / o.sxx -- 0,33
	s.mode = "mse"
	s.mr = -0.5
	s.moved = false
	s.held = 0

	local function L(m)
		return s.a * m * m + s.b * m + s.k
	end
	local function dL(m)
		return 2 * s.a * m + s.b
	end
	s.L, s.dL = L, dL
	local function sync()
		s.c = MathCore.lineFromPivot(s.mr, s.h, fb.pivot_x_m)
		s.Lv = L(s.mr)
		s.mse = s.Lv / s.n
		s.deriv = dL(s.mr)
	end
	s.sync = sync
	sync()

	-- ── график ──
	local holder = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -64), Parent = sc.shell.main })
	s.title = Gui.label({ Text = S.plotTitleMse, Font = Theme.fontBold, TextSize = 22, Position = UDim2.fromOffset(64, 0),
		Size = UDim2.new(1, -64, 0, 28), Parent = holder })
	local inner = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26), Parent = holder })
	s.plot = PlotView2D.new(inner, {
		xMin = M_MIN, xMax = M_MAX, yMin = 0, yMax = 2,
		xTicks = { -1, -0.5, 0, 0.5, 1, 1.5 }, yTicks = { 0, 0.5, 1, 1.5, 2 },
		xLabel = Strings.plotX, yLabel = Strings.plotY, padL = 60, padR = 14, padT = 16, padB = 60, fontSize = 18,
		fallbackW = 560, fallbackH = 420,
	})
	s.plot.onResize = function()
		scene.draw(sc)
	end

	-- ── кнопки под графиком: ◀ ▶ (удержание), «Показать L» ──
	local bar = Gui.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 56), Parent = sc.shell.main })
	Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = bar })
	s.showL = Gui.button({ Text = S.showL, Size = UDim2.fromOffset(250, 50), BackgroundColor3 = Theme.color.loss, TextColor3 = Theme.color.bg,
		LayoutOrder = 1, Parent = bar })
	s.showL.Activated:Connect(function()
		scene.switchToL(sc)
	end)
	s.runnerBtns = {}
	for i, spec in { { "◀  m", -1 }, { "m  ▶", 1 } } do
		local b = Gui.button({ Text = spec[1], Size = UDim2.fromOffset(110, 50), LayoutOrder = 1 + i, Visible = false, Parent = bar })
		Gui.stroke(Theme.color.m, 2).Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				s.held = spec[2]
			end
		end)
		b.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				scene.release(sc)
			end
		end)
		s.runnerBtns[i] = b
	end
	s.flagNote = Gui.label({ Text = "", TextSize = 18, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
		TextColor3 = Theme.color.good, LayoutOrder = 9, Parent = bar })

	sc:keys("RunnerUp", { Enum.KeyCode.Q, Enum.KeyCode.Right }, function(down)
		if down then s.held = 1 elseif s.held == 1 then scene.release(sc) end
	end)
	sc:keys("RunnerDown", { Enum.KeyCode.E, Enum.KeyCode.Left }, function(down)
		if down then s.held = -1 elseif s.held == -1 then scene.release(sc) end
	end)

	-- бегунок: перетаскивание по области графика (только по оси m)
	s.drag = Drag.attach(s.plot.area, {
		began = function(p)
			if s.mode ~= "L" then
				return false
			end
			scene.dragTo(sc, p)
			return true
		end,
		moved = function(p)
			scene.dragTo(sc, p)
		end,
		ended = function()
			scene.release(sc)
		end,
	})
	sc:conn({ Disconnect = s.drag.Destroy })

	-- ── формулы ──
	local m, c, nTok = T.sym("m", "m"), T.sym("c", "c"), "n"
	sc:formula({
		id = "LOSS", title = S.lossTitle, toNotebook = true,
		lines = {
			{ id = "def", open = true,
				general = { T.sym("L", "loss"), "(", m, ", ", c, ") = ", T.sum(), "(", T.sub("y", "i"), " − (", m, "·", T.sub("x", "i"), " + ", c, "))", T.sup("", "2") },
				numbers = function(st)
					return { T.sym("L", "loss"), " = ", T.sum(), "(", T.sub("y", "i"), " − (", T.col(Format.coef(st.mr), "m"), "·", T.sub("x", "i"),
						" + ", T.col(Format.num(st.c, 2), "c"), "))", T.sup("", "2") }
				end,
				result = function(st) return Format.area(st.Lv) end },
			{ id = "mse", open = true,
				general = { "MSE = ", T.sym("L", "loss"), " / ", nTok },
				numbers = function(st) return { "MSE = ", T.col(Format.num(st.Lv, 3), "loss"), " / ", tostring(st.n) } end,
				result = function(st) return Format.mse(st.mse) end },
			{ id = "Lm", hint = S.lockLm,
				general = { T.sym("L", "loss"), "(", m, ") = ", T.sum(), "(Δx)²·", m, "² − 2·", T.sum(), "ΔxΔy·", m, " + ", T.sum(), "(Δy)² + n·(",
					T.bar("y", "mean", "mean"), " − ", T.sym("h", "c"), ")²" },
				numbers = function(st)
					return { T.sym("L", "loss"), "(", m, ") = ", Format.num(st.a, 0), "·", m, "² ", Format.MINUS, " ", Format.num(-st.b, 1), "·", m, " + ",
						Format.num(st.o.syy, 2), " + ", tostring(st.n), "·(", Format.num(st.o.yMean, 1), " − ", T.col(Format.num(st.h, 2), "c"), ")²" }
				end,
				result = function(st) return Format.area(st.Lv) end },
		},
	})
	sc:formula({
		id = "DLDM", title = S.derivTitle, toNotebook = true,
		lines = {
			{ id = "deriv", hint = S.lockDeriv,
				general = { T.d("L", "m", "m"), " = 2·", T.sum(), "(Δx)²·", m, " − 2·", T.sum(), "ΔxΔy" },
				numbers = function(st)
					return { T.d("L", "m", "m"), " = ", Format.num(2 * st.a, 0), "·", T.col(Format.coef(st.mr), "m"), " ", Format.MINUS, " ", Format.num(-st.b, 1) }
				end,
				result = function(st) return Format.signed(st.deriv, 2) end },
			{ id = "zero", hint = S.lockZero,
				general = { T.d("L", "m", "m"), " = 0  ⇒  ", m, " = ", T.frac({ T.sum(), "ΔxΔy" }, { T.sum(), "(Δx)²" }) },
				numbers = function(st)
					return { T.d("L", "m", "m"), " = 0  ⇒  ", m, " = ", T.frac({ Format.num(st.o.sxy, 1) }, { Format.num(st.o.sxx, 0) }) }
				end,
				result = function(st) return Format.coef(st.mStar) end },
		},
	})
	sc.shell:setText(S.intro)
	scene.draw(sc)
end

function scene.switchToL(sc)
	local s = sc.s
	if s.mode == "L" then
		return
	end
	s.mode = "L"
	s.showL.Visible = false
	for _, b in s.runnerBtns do
		b.Visible = true
	end
	s.title.Text = S.plotTitleL
	s.plot:setRange(M_MIN, M_MAX, 0, 10, nil, { 0, 2, 4, 6, 8, 10 })
	s.plot.opts.yLabel = S.plotYL
	s.plot:drawGrid()
	sc.shell:setText(S.afterL)
	sc:progress()
	sc.shell:ask(S.bet, function(k)
		s.bet = k
		sc:progress()
	end)
	scene.draw(sc)
end

function scene.dragTo(sc, p: Vector2)
	local s = sc.s
	local px = s.plot:screenToPx(p.X, p.Y)
	local m = s.plot:fromPx(px, 0)
	scene.setRunner(sc, m)
end

function scene.setRunner(sc, m: number)
	local s = sc.s
	m = math.clamp(m, M_MIN, M_MAX)
	if m ~= s.mr then
		s.mr = m
		s.moved = true
		s.sync()
		sc.store:set("runner2d", m) -- для проверки условий открытия
		sc:progress()
		s.dirty = true -- перерисовка — в update, не чаще 30 Гц
	end
end

-- отпускание: прилипание к минимуму
function scene.release(sc)
	local s = sc.s
	s.held = 0
	if math.abs(s.mr - s.mStar) < SNAP_TOL then
		s.mr = s.mStar
		s.sync()
		sc.store:set("runner2d", s.mr)
		scene.draw(sc)
	end
end

function scene.update(sc, dt)
	local s = sc.s
	if s.held ~= 0 and s.mode == "L" then
		scene.setRunner(sc, s.mr + s.held * RUNNER_SPEED * dt)
	end
	if s.dirty then
		s.dirty = false
		scene.draw(sc)
	end
end

function scene.draw(sc)
	local s = sc.s
	local P = s.P
	local scaleY = if s.mode == "L" then s.n else 1
	local hl = sc.store:get("highlight")

	local curve = s.plot:layer("curve", 3)
	curve:begin()
	curve:curve(function(m)
		return (P.a * m * m + P.b * m + P.k) * scaleY
	end, M_MIN, M_MAX, 100, { color = Theme.color.loss, thickness = if hl == "loss" then 5 else 3 })
	curve:finish()

	local pts = s.plot:layer("points", 5)
	pts:begin()
	for _, r in P.records or {} do
		pts:dot(r.m, r.mse * scaleY, { color = Theme.color.loss, size = 14, strokeColor = Theme.color.bg })
	end
	pts:finish()

	local flag = s.plot:layer("flag", 4)
	flag:begin()
	local vStar = P.vStar * scaleY
	flag:dashedV(P.tStar, 0, vStar, { color = Theme.color.flag, thickness = 2 })
	flag:dot(P.tStar, vStar, { color = Theme.color.flag, size = 14 })
	flag:label(P.tStar, vStar, S.flag:format(Format.coef(P.tStar)), { dx = 10, dy = 26, anchor = Vector2.new(0, 0), size = 18, color = Theme.color.flag })
	flag:finish()

	local run = s.plot:layer("runner", 6)
	run:begin()
	if s.mode == "L" then
		local m0, L0, d = s.mr, s.Lv, s.deriv
		local w = 0.35
		local horizontal = math.abs(d) < ZERO_TOL
		run:seg(m0 - w, L0 - d * w, m0 + w, L0 + d * w, { color = if horizontal then Theme.color.good else Theme.color.m, thickness = 4 })
		run:dot(m0, L0, { color = Theme.color.m, size = 22, strokeColor = Theme.color.text })
		run:label(m0, L0, ("m = %s"):format(Format.coef(m0)), { dx = -10, dy = -14, anchor = Vector2.new(1, 1), size = 18, color = Theme.color.mText })
	end
	run:finish()
end

scene.unlocks = {
	{ formula = "LOSS", line = "Lm", when = function(sc) return sc.s.mode == "L" end },
	{ formula = "DLDM", line = "deriv", when = function(sc) return sc.s.moved end },
	{
		formula = "DLDM", line = "zero",
		when = function(sc)
			local s = sc.s
			return s.moved and s.held == 0 and math.abs(s.deriv) < ZERO_TOL
		end,
		onUnlock = function(sc)
			local s = sc.s
			s.flagNote.Text = S.flagMatch:format(Format.coef(s.P.tStar))
			sc.shell:setText(S.done)
			if s.bet then
				local correct = s.bet == 2
				sc.shell:resolve(correct, S.bet.reveal)
				if correct then
					sc:honey(1)
				end
			end
		end,
	},
}

function scene.canAdvance(sc)
	return sc.f.DLDM ~= nil and sc.f.DLDM:isUnlocked("zero")
end

function scene.hintTargets(sc)
	return { if sc.s.mode == "L" then sc.s.plot.area else sc.s.showL }
end

function scene.hintText(sc, level)
	if level == 3 then
		return Strings.hints["2D.1"][3]:format(Format.coef(sc.s.mStar))
	end
	return nil
end

return scene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">S2D_23_Intercept</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D.2 Новый график: ищем свободный член. 2D.3 Минимум по свободному члену — это dL/dc = 0.
-- Одна «лаборатория» на обе сцены (графики остаются при переходе 2D.2 → 2D.3):
--   слева — 5 ульев (пчёлы → мёд), прямая постоянного наклона m = 0,47, точка пересечения с OY, остатки и их квадраты;
--   справа — записи (c, MSE), после пяти — парабола и минимум c* = 6,2.
-- Управление прямой: перетаскивание по графику, Shift/Ctrl (↑/↓), кнопки ▲ ▼ (удержание), R — записать.

local Regression = script.Parent.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)
local Drag = require(Regression.UI.Drag)

local S2, S3 = Strings.s2d["2D.2"], Strings.s2d["2D.3"]
local C_MIN, C_MAX = -2, 14
local C_SPEED = 4 -- кг/с при удержании
local C_GRID = 0.1
local MIN_DC = 1.0 -- записи должны различаться по c хотя бы на 1 кг
local SNAP_TOL = 0.3
local NEED = 5

local function kg(v: number, d: number?): string
	return Format.unit(v, d or 1, "кг")
end

-- ───── лаборатория ─────

local Lab = {}
Lab.__index = Lab

function Lab.new(sc)
	local self = setmetatable({}, Lab)
	local idm = sc.Datasets.intercept_demo
	local MathCore = sc.MathCore
	self.sc = sc
	self.MathCore = MathCore
	self.x, self.y = idm.bees_k, idm.honey_kg
	self.n = #self.x
	self.m = idm.fixed_slope
	self.c = 0
	self.records = {}
	self.held = 0
	self.moved = false
	local o = MathCore.ols1d(self.x, self.y)
	self.o = o
	self.cStar = o.yMean - self.m * o.xMean -- 6,2
	self.recordEnabled = false
	self.sumX, self.sumY = o.xMean * self.n, o.yMean * self.n

	local main = sc.shell.main
	local top = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -62), Parent = main })
	local left = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(0.58, -6, 1, 0), Parent = top })
	local right = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromScale(0.58, 0), Size = UDim2.new(0.42, 0, 1, 0), Parent = top })
	Gui.label({ Text = S2.plotTitle, Font = Theme.fontBold, TextSize = 20, Position = UDim2.fromOffset(56, 0), Size = UDim2.new(1, -56, 0, 26), Parent = left })
	self.rightTitle = Gui.label({ Text = S3.plotTitle, Font = Theme.fontBold, TextSize = 20, Position = UDim2.fromOffset(52, 0),
		Size = UDim2.new(1, -52, 0, 26), Visible = false, Parent = right })
	local li = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 1, -24), Parent = left })
	local ri = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, 0, 1, -24), Visible = false, Parent = right })
	self.rightHolder = ri
	self.plot = PlotView2D.new(li, {
		xMin = 0, xMax = 70, yMin = 0, yMax = 45, xTicks = { 0, 10, 20, 30, 40, 50, 60, 70 }, yTicks = { 0, 10, 20, 30, 40 },
		xLabel = S2.xLabel, yLabel = S2.yLabel, padL = 52, padR = 10, padT = 14, padB = 58, fontSize = 17, fallbackW = 380, fallbackH = 420,
	})
	self.mplot = PlotView2D.new(ri, {
		xMin = C_MIN, xMax = C_MAX, yMin = 0, yMax = 50, xTicks = { 0, 3, 6, 9, 12 }, yTicks = { 0, 10, 20, 30, 40, 50 },
		xLabel = S3.xLabel, yLabel = S3.yLabel, padL = 48, padR = 10, padT = 14, padB = 58, fontSize = 17, fallbackW = 260, fallbackH = 420,
	})
	self.plot.onResize = function() self:draw() end
	self.mplot.onResize = function() self:draw() end

	-- кнопки под графиками
	local bar = Gui.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 56), Parent = main })
	Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = bar })
	for i, spec in { { "▲  c", 1 }, { "▼  c", -1 } } do
		local b = Gui.button({ Text = spec[1], Size = UDim2.fromOffset(96, 50), LayoutOrder = i, Parent = bar })
		Gui.stroke(Theme.color.c, 2).Parent = b
		b.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				self.held = spec[2]
			end
		end)
		b.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				self:release()
			end
		end)
	end
	self.recordBtn = Gui.button({ Text = S3.record, Size = UDim2.fromOffset(170, 50), LayoutOrder = 3, Visible = false,
		BackgroundColor3 = Theme.color.loss, TextColor3 = Theme.color.bg, Parent = bar })
	self.recordBtn.Activated:Connect(function()
		self:record()
	end)
	self.counter = Gui.label({ Text = "", TextSize = 18, TextColor3 = Theme.color.textDim, Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 4, Parent = bar })

	-- перетаскивание прямой (по вертикали, без скачка)
	self.drag = Drag.attach(self.plot.area, {
		began = function(p)
			local _, py = self.plot:screenToPx(p.X, p.Y)
			local _, yd = self.plot:fromPx(0, py)
			self.dragStart = { y = yd, c = self.c }
			return true
		end,
		moved = function(p)
			if not self.dragStart then
				return
			end
			local _, py = self.plot:screenToPx(p.X, p.Y)
			local _, yd = self.plot:fromPx(0, py)
			self:setC(self.dragStart.c + (yd - self.dragStart.y))
		end,
		ended = function()
			self.dragStart = nil
			self:release()
		end,
	})
	self:sync()
	self:draw()
	return self
end

function Lab:bindKeys(sc)
	sc:keys("CUp", { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.Up }, function(down)
		if down then self.held = 1 elseif self.held == 1 then self:release() end
	end)
	sc:keys("CDown", { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl, Enum.KeyCode.Down }, function(down)
		if down then self.held = -1 elseif self.held == -1 then self:release() end
	end)
	sc:keys("CRecord", { Enum.KeyCode.R }, function(down)
		if down then self:record() end
	end)
	self.sc = sc
end

function Lab:sync()
	local MathCore = self.MathCore
	self.mse = MathCore.mseLine(self.x, self.y, self.m, self.c)
	self.L = self.mse * self.n
	self.dldc = MathCore.dLdc(self.x, self.y, self.m, self.c)
end

function Lab:setC(c: number)
	c = math.clamp(c, C_MIN, C_MAX)
	if c == self.c then
		return
	end
	self.c = c
	self.moved = true
	self:sync()
	self.sc.store:set("c2d", c)
	self.sc:progress()
	self.dirty = true -- перерисовка — в update, не чаще 30 Гц
end

function Lab:release()
	self.held = 0
	local c = math.round(self.c / C_GRID) * C_GRID
	c = tonumber(string.format("%.4f", c)) :: number
	if self.parabola and math.abs(c - self.cStar) < SNAP_TOL then
		c = self.cStar
	end
	if c ~= self.c then
		self.c = c
		self:sync()
		self.sc.store:set("c2d", c)
		self:draw()
	end
end

function Lab:update(dt: number)
	if self.held ~= 0 then
		self:setC(self.c + self.held * C_SPEED * dt)
	end
	if self.dirty then
		self.dirty = false
		self:draw()
	end
end

function Lab:record()
	if not self.recordEnabled then
		return
	end
	local sc = self.sc
	if #self.records >= NEED then
		sc:toast(S3.recordFull, Theme.color.c)
		return
	end
	for _, r in self.records do
		if math.abs(r.c - self.c) < MIN_DC - 1e-9 then
			sc:toast(S3.recordTooClose:format(kg(r.c)), Theme.color.c)
			return
		end
	end
	local recs = table.clone(self.records)
	table.insert(recs, { c = self.c, mse = self.mse })
	self.records = recs
	sc.store:set("records2d", recs)
	sc.shell:flash(self.recordBtn)
	sc:toast(S3.recordAdded:format(kg(self.c), Format.num(self.mse, 2)), Theme.color.loss)
	sc:progress()
	if #recs == NEED - 1 then
		local below, above = 0, 0
		for _, r in recs do
			if r.c < self.cStar then below += 1 else above += 1 end
		end
		if below == 0 or above == 0 then
			sc:toast(S3.oneSide, Theme.color.c)
		end
	end
	if #recs == NEED then
		local t, v = {}, {}
		for i, r in recs do
			t[i], v[i] = r.c, r.mse
		end
		self.parabola = self.MathCore.fitParabola(t, v)
		self.recordBtn.Visible = false
		sc.shell:setText(S3.afterRecords:format(Format.num(self.parabola.tStar, 1)))
	end
	self:updateCounter()
	self:draw()
end

function Lab:updateCounter()
	self.counter.Text = if self.recordEnabled then S3.counter:format(#self.records) else ""
end

function Lab:enableRecording()
	self.recordEnabled = true
	self.recordBtn.Visible = true
	self.rightHolder.Visible = true
	self.rightTitle.Visible = true
	self:updateCounter()
	self:draw()
end

function Lab:draw()
	local plot = self.plot
	local hl = self.sc.store:get("highlight")
	local m, c = self.m, self.c

	-- квадраты остатков: сторона |e| в пикселях оси y, вдоль x — в сторону от среднего x
	local sq = plot:layer("squares", 2)
	sq:begin()
	for i = 1, self.n do
		local x, y = self.x[i], self.y[i]
		local yhat = m * x + c
		local px, py = plot:toPx(x, y)
		local _, ph = plot:toPx(x, yhat)
		local side = math.abs(ph - py)
		local dir = if x < self.o.xMean then -1 else 1
		sq:rectPx(px, py, px + dir * side, ph, { color = Theme.color.residual, transparency = if hl == "residual" then 0.35 else 0.6 })
	end
	sq:finish()

	local ln = plot:layer("line", 3)
	ln:begin()
	ln:seg(0, c, 70, m * 70 + c, { color = Theme.color.line, thickness = if hl == "m" then 5 else 3 })
	for i = 1, self.n do
		local x, y = self.x[i], self.y[i]
		ln:seg(x, y, x, m * x + c, { color = Theme.color.residual, thickness = 3 })
	end
	ln:finish()

	local pts = plot:layer("points", 5)
	pts:begin()
	for i = 1, self.n do
		pts:dot(self.x[i], self.y[i], { color = Theme.color.text, size = 12, strokeColor = Theme.color.bg })
	end
	-- точка пересечения с осью OY — свободный член
	pts:dot(0, c, { color = Theme.color.c, size = if hl == "c" then 22 else 18, strokeColor = Theme.color.text })
	pts:label(0, c, "c = " .. Format.num(c, 1), { dx = 14, dy = -6, anchor = Vector2.new(0, 1), size = 18, color = Theme.color.c, font = Theme.fontBold })
	if self.mean then
		pts:seg(0, self.o.yMean, 70, self.o.yMean, { color = Theme.color.mean, thickness = 2, transparency = 0.3 })
	end
	pts:finish()

	-- справа: записи (c, MSE), живая точка, парабола и минимум
	local mp = self.mplot
	local par = mp:layer("parabola", 3)
	par:begin()
	local P = self.parabola
	if P then
		par:curve(function(cc)
			return P.a * cc * cc + P.b * cc + P.k
		end, C_MIN, C_MAX, 90, { color = Theme.color.loss, thickness = 3 })
		par:dashedV(P.tStar, 0, P.vStar, { color = Theme.color.flag, thickness = 2 })
		par:dot(P.tStar, P.vStar, { color = Theme.color.flag, size = 14 })
		par:label(P.tStar, P.vStar, "c* = " .. Format.num(P.tStar, 1), { dx = 8, dy = 22, anchor = Vector2.new(0, 0), size = 18, color = Theme.color.flag, font = Theme.fontBold })
	end
	par:finish()
	local rec = mp:layer("records", 5)
	rec:begin()
	for _, r in self.records do
		rec:dot(r.c, r.mse, { color = Theme.color.loss, size = 14, strokeColor = Theme.color.bg })
	end
	rec:dot(c, math.min(self.mse, 49.5), { color = Theme.color.c, size = 18, hollow = true })
	rec:finish()
end

function Lab:Destroy()
	self.drag.Destroy()
end

-- ───── формулы ─────

local function lineFormula(sc, lab)
	local T = sc.T
	return {
		id = "LINE", title = S2.lineTitle,
		lines = {
			{ id = "eq", open = true,
				general = { T.hat("y"), " = ", T.sym("m", "m"), "·x + ", T.sym("c", "c") },
				numbers = function() return { T.hat("y"), " = ", T.col(Format.coef(lab.m), "m"), "·x + ", T.col(Format.num(lab.c, 1), "c") } end },
		},
	}
end

-- ───── сцены ─────

local scene2 = { id = "2D.2", panel = true, keepMain = true, autoAdvance = true }

function scene2.enter(sc)
	local lab = Lab.new(sc)
	sc.shared.lab = lab
	lab:bindKeys(sc)
	sc:formula(lineFormula(sc, lab))
	sc.shell:setText(S2.intro)
end

function scene2.update(sc, dt)
	sc.shared.lab:update(dt)
end

function scene2.canAdvance(sc)
	local lab = sc.shared.lab
	return lab ~= nil and lab.moved and lab.held == 0
end

function scene2.hintTargets(sc)
	return { sc.shared.lab.plot.area }
end

local scene3 = { id = "2D.3", panel = true }

function scene3.enter(sc)
	local lab = sc.shared.lab
	if not lab then
		lab = Lab.new(sc)
		sc.shared.lab = lab
	end
	lab:bindKeys(sc)
	lab:enableRecording()
	local T = sc.T
	local m, c = T.sym("m", "m"), T.sym("c", "c")
	sc:formula(lineFormula(sc, lab))
	sc:formula({
		id = "MSEC", title = S3.mseTitle, toNotebook = true,
		lines = {
			{ id = "def", open = true,
				general = { "MSE(", c, ") = ", T.frac({ T.sum(), "(", T.sub("y", "i"), " − ", m, "·", T.sub("x", "i"), " − ", c, ")²" }, { "n" }) },
				numbers = function()
					return { "MSE = ", T.frac({ T.sum(), "(", T.sub("y", "i"), " − ", T.col(Format.coef(lab.m), "m"), "·", T.sub("x", "i"), " − ",
						T.col(Format.num(lab.c, 1), "c"), ")²" }, { tostring(lab.n) }) }
				end,
				result = function() return Format.num(lab.mse, 2) end },
		},
	})
	sc:formula({
		id = "DLDC", title = S3.derivTitle, toNotebook = true,
		lines = {
			{ id = "deriv", hint = S3.lockDeriv,
				general = { T.d("L", "c", "c"), " = −2·", T.sum(), "(", T.sub("y", "i"), " − ", m, "·", T.sub("x", "i"), " − ", c, ")" },
				numbers = function()
					return { T.d("L", "c", "c"), " = −2·(", Format.num(lab.sumY, 0), " − ", T.col(Format.coef(lab.m), "m"), "·", Format.num(lab.sumX, 0),
						" − ", tostring(lab.n), "·", T.col(Format.num(lab.c, 1), "c"), ")" }
				end,
				result = function() return Format.signed(lab.dldc, 1) end },
			{ id = "zero", hint = S3.lockZero,
				general = { T.d("L", "c", "c"), " = 0  ⇒  ", c, " = ", T.bar("y", "mean", "mean"), " − ", m, "·", T.bar("x", "mean", "mean") },
				numbers = function()
					return { T.d("L", "c", "c"), " = 0  ⇒  ", c, " = ", Format.num(lab.o.yMean, 0), " − ", T.col(Format.coef(lab.m), "m"), "·", Format.num(lab.o.xMean, 0) }
				end,
				result = function() return Format.unit(lab.cStar, 1, "кг") end },
		},
	})
	sc.shell:setText(S3.intro)
end

function scene3.update(sc, dt)
	sc.shared.lab:update(dt)
end

scene3.unlocks = {
	{ formula = "DLDC", line = "deriv", when = function(sc) return #sc.shared.lab.records >= NEED end },
	{
		formula = "DLDC", line = "zero",
		when = function(sc)
			local lab = sc.shared.lab
			return lab.parabola ~= nil and lab.c == lab.cStar
		end,
		onUnlock = function(sc)
			sc.shell:setText(S3.atMinimum)
			sc.shell:ask(S3.bet, function(k)
				sc.s.bet = k
				local correct = k == 2
				sc.shell:resolve(correct, S3.bet.reveal)
				if correct then
					sc:honey(1)
				end
				sc:note(S3.note)
				sc:progress()
			end)
		end,
	},
}

function scene3.canAdvance(sc)
	return sc.f.DLDC ~= nil and sc.f.DLDC:isUnlocked("zero") and sc.s.bet ~= nil
end

function scene3.exit(sc)
	if sc.shared.lab then
		sc.shared.lab:Destroy()
		sc.shared.lab = nil
	end
end

function scene3.hintTargets(sc)
	local lab = sc.shared.lab
	return { if #lab.records < NEED then lab.recordBtn else lab.plot.area }
end

function scene3.hintText(sc, level)
	local lab = sc.shared.lab
	if level == 3 and #lab.records >= NEED then
		return Strings.hints["2D.3"].final:format(Format.num(lab.cStar, 1))
	end
	return nil
end

return { scene2, scene3 }
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">S2D_4_SmallSample</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D.4 Мало данных — коэффициенты «пляшут» (интерактивный 3D).
-- 15 точек (пчёлы, температура → мёд), первые 5 — малая выборка (залитые шары), остальные 10 — кольца.
-- Действия: повернуть облако ≥ 90°, ставка → «Проверить на остальных 10», переключить «на 5 / на 15»,
-- тапнуть 2 точки из остальных (карточка: прогноз и ошибка). После всех действий — строка-итог про Ridge и Lasso.

local Regression = script.Parent.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local Viewport3D = require(Regression.UI.Viewport3D)

local S = Strings.s2d["2D.4"]
local NEED_YAW = 90
local NEED_TAPS = 2
local PICK_PX = 18

-- данные → мир вьюпорта
local function toWorld(bees: number, temp: number, honey: number): Vector3
	return Vector3.new((bees - 35) / 4, (honey - 10) / 4, -(temp - 21) / 2.5)
end

local scene = { id = "2D.4", panel = true }

local function fitModel(MathCore, X, y)
	local Z, mu, sd = MathCore.standardize(X)
	local b0, b = MathCore.ols(Z, y)
	local a0, a = MathCore.toRawUnits(b0, b, mu, sd)
	return { b0 = b0, b = b, a0 = a0, a = a, mu = mu, sd = sd }
end

local function predict(model, bees: number, temp: number): number
	return model.a0 + model.a[1] * bees + model.a[2] * temp
end

function scene.enter(sc)
	local s, MathCore = sc.s, sc.MathCore
	local rows = sc.Datasets.small_sample.rows
	s.rows = rows
	local X5, y5, Xall, yall, yrest = {}, {}, {}, {}, {}
	for _, r in rows do
		table.insert(Xall, { r.bees_k, r.temperature_C })
		table.insert(yall, r.honey_kg)
		if r.sample == "first5" then
			table.insert(X5, { r.bees_k, r.temperature_C })
			table.insert(y5, r.honey_kg)
		else
			table.insert(yrest, r.honey_kg)
		end
	end
	s.m5 = fitModel(MathCore, X5, y5)
	s.m15 = fitModel(MathCore, Xall, yall)
	local function preds(model, filter)
		local out = {}
		for _, r in rows do
			if filter == nil or r.sample == filter then
				table.insert(out, predict(model, r.bees_k, r.temperature_C))
			end
		end
		return out
	end
	s.r2first5 = MathCore.r2(y5, preds(s.m5, "first5"))
	s.r2rest = MathCore.r2(yrest, preds(s.m5, "rest"))
	s.r2all = MathCore.r2(yall, preds(s.m15, nil))
	s.corr = nil
	s.on = 5
	s.checked, s.toggled15, s.tapped, s.nTapped = false, false, {}, 0
	s.model = s.m5

	-- ── вьюпорт ──
	local vp = Viewport3D.new(sc.shell.main, { center = Vector3.new(0, 3, 0), radius = 17, yaw = math.rad(30), pitch = math.rad(20) })
	s.vp = vp
	sc:conn({ Disconnect = function() vp:Destroy() end })
	-- оси
	local o = toWorld(15, 12, 10)
	s.axisEnds = {
		{ toWorld(58, 12, 10), S.axisBees },
		{ toWorld(15, 32, 10), S.axisTemp },
		{ toWorld(15, 12, 37), S.axisHoney },
	}
	for _, e in s.axisEnds do
		vp:segment(nil, o, e[1], 0.08, Theme.color.axis)
	end
	-- точки
	s.balls, s.resid = {}, {}
	for i, r in rows do
		local first = r.sample == "first5"
		local p = toWorld(r.bees_k, r.temperature_C, r.honey_kg)
		s.balls[i] = vp:part({ Name = "Point" .. i, Shape = Enum.PartType.Ball, Size = Vector3.one * (if first then 0.6 else 0.22),
			CFrame = CFrame.new(p), Color = if first then Theme.color.loss else Theme.color.text, Material = Enum.Material.SmoothPlastic })
		s.resid[i] = vp:part({ Name = "Resid" .. i, Color = Theme.color.residual, Transparency = 1 })
	end
	-- плоскость модели — сетка из линий (линейная функция на прямоугольнике — параллелограмм, одним Part не нарисовать)
	s.net = {}
	for k = 1, 12 do
		s.net[k] = vp:part({ Name = "Net" .. k, Color = Theme.color.m, Transparency = 0.25 })
	end
	-- оверлей: подписи осей, кольца остальных точек, карточка
	s.axisLabels = {}
	for i, e in s.axisEnds do
		s.axisLabels[i] = Gui.label({ Text = e[2], TextSize = 16, TextColor3 = Theme.color.textDim, AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0), TextWrapped = false, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 6, Parent = vp.overlay })
	end
	s.rings = {}
	for i, r in rows do
		if r.sample == "rest" then
			local ring = Gui.frame({ Size = UDim2.fromOffset(18, 18), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 6, Parent = vp.overlay })
			Gui.corner(UDim.new(0.5, 0)).Parent = ring
			Gui.stroke(Theme.color.loss, 2).Parent = ring
			s.rings[i] = ring
		end
	end
	s.card = Gui.label({ Size = UDim2.fromOffset(250, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.color.bg,
		BackgroundTransparency = 0.05, TextSize = 16, Visible = false, ZIndex = 8, Parent = vp.overlay })
	Gui.corner().Parent = s.card
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = s.card })
	s.legend = Gui.label({ Text = S.legend, TextSize = 15, TextColor3 = Theme.color.textDim, Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -20, 0, 20), ZIndex = 6, Parent = vp.overlay })
	s.rotLabel = Gui.label({ Text = "", TextSize = 15, TextColor3 = Theme.color.textDim, AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 10, 1, -6), Size = UDim2.new(1, -20, 0, 20), ZIndex = 6, Parent = vp.overlay })

	vp.onCamera = function()
		scene.overlay(sc)
		sc:progress()
	end
	vp.onTap = function(pos)
		scene.tap(sc, pos)
	end

	-- ── управление ──
	s.toggleBtn = sc.shell:button(S.train15, { order = 1, onClick = function() scene.toggle(sc) end })
	Gui.stroke(Theme.color.m, 2).Parent = s.toggleBtn
	s.checkBtn = sc.shell:button(S.check, { order = 2, color = Theme.color.loss, textColor = Theme.color.bg, onClick = function()
		scene.check(sc)
	end })
	sc.shell:button(S.resetView, { order = 3, onClick = function() vp:reset() end })

	-- ── формулы ──
	local T = sc.T
	sc:formula({
		id = "PLANE", title = S.planeTitle, toNotebook = true,
		lines = {
			{ id = "eq", open = true,
				general = { T.hat("y"), " = ", T.sub("b", "0"), " + ", T.sub("b", "1", "m"), "·", T.sub("z", "пчёлы"), " + ",
					T.sub("b", "2", "m_temp"), "·", T.sub("z", "темп") },
				numbers = function(st)
					local b = st.model.b
					return { T.hat("y"), " = ", Format.num(st.model.b0, 2), " + ", T.col(Format.num(b[1], 2), "m"), "·", T.sub("z", "1"),
						" " .. (if b[2] < 0 then Format.MINUS else "+") .. " ", T.col(Format.num(math.abs(b[2]), 2), "m_temp"), "·", T.sub("z", "2") }
				end },
		},
	})
	sc:formula({
		id = "R2", title = S.r2Title, toNotebook = true,
		lines = {
			{ id = "first5", open = true, general = { S.r2first5 }, result = function(st) return Format.num(st.r2first5, 3) end },
			{ id = "rest", hint = S.lockRest, general = { S.r2rest }, result = function(st) return Format.num(st.r2rest, 3) end },
			{ id = "all", hint = S.lockAll, general = { S.r2all }, result = function(st) return Format.num(st.r2all, 3) end },
		},
	})
	sc.shell:setText(S.intro:format(Format.num(s.m5.b[2], 2)))
	scene.applyModel(sc)
	scene.overlay(sc)
end

function scene.applyModel(sc)
	local s = sc.s
	local model = s.model
	local vp = s.vp
	local k = 0
	for _, bees in { 15, 25, 35, 45, 55 } do
		k += 1
		vp:segment(s.net[k], toWorld(bees, 12, predict(model, bees, 12)), toWorld(bees, 31, predict(model, bees, 31)), 0.06, Theme.color.m)
	end
	for _, temp in { 12, 16.75, 21.5, 26.25, 31 } do
		k += 1
		vp:segment(s.net[k], toWorld(15, temp, predict(model, 15, temp)), toWorld(55, temp, predict(model, 55, temp)), 0.06, Theme.color.m)
	end
	for j = k + 1, #s.net do
		s.net[j].Transparency = 1
	end
	for i, r in s.rows do
		local show = s.checked and (r.sample == "rest" or s.on == 15)
		local part = s.resid[i]
		if show then
			local yhat = predict(model, r.bees_k, r.temperature_C)
			vp:segment(part, toWorld(r.bees_k, r.temperature_C, r.honey_kg), toWorld(r.bees_k, r.temperature_C, yhat), 0.07, Theme.color.residual)
		else
			part.Transparency = 1
		end
	end
	scene.overlay(sc)
end

function scene.overlay(sc)
	local s = sc.s
	local vp = s.vp
	for i, e in s.axisEnds do
		local x, y, vis = vp:project(e[1])
		s.axisLabels[i].Visible = vis
		s.axisLabels[i].Position = UDim2.fromOffset(x, y)
	end
	for i, ring in s.rings do
		local r = s.rows[i]
		local x, y, vis = vp:project(toWorld(r.bees_k, r.temperature_C, r.honey_kg))
		ring.Visible = vis
		ring.Position = UDim2.fromOffset(x, y)
		local st = ring:FindFirstChildOfClass("UIStroke")
		st.Color = if s.selected == i then Theme.color.c else Theme.color.loss
	end
	if s.selected then
		local r = s.rows[s.selected]
		local x, y, vis = vp:project(toWorld(r.bees_k, r.temperature_C, r.honey_kg))
		s.card.Visible = vis
		s.card.Position = UDim2.fromOffset(x + 14, y - 10)
	else
		s.card.Visible = false
	end
	s.rotLabel.Text = if vp.totalYaw < NEED_YAW then S.rotate:format(math.floor(vp.totalYaw)) else S.rotated
	s.rotated = vp.totalYaw >= NEED_YAW
end

function scene.tap(sc, pos: Vector2)
	local s = sc.s
	local best, bestD = nil, PICK_PX
	for i, r in s.rows do
		local x, y, vis = s.vp:project(toWorld(r.bees_k, r.temperature_C, r.honey_kg))
		if vis then
			local d = (Vector2.new(x, y) - pos).Magnitude
			if d < bestD then
				best, bestD = i, d
			end
		end
	end
	if best == nil or best == s.selected then
		s.selected = nil
		scene.overlay(sc)
		return
	end
	s.selected = best
	local r = s.rows[best]
	local yhat = predict(s.model, r.bees_k, r.temperature_C)
	s.card.Text = S.card:format(best, Format.num(r.bees_k, 1), Format.num(r.temperature_C, 1), Format.unit(r.honey_kg, 1, "кг"),
		Format.unit(yhat, 1, "кг"), Format.signed(r.honey_kg - yhat, 1), if r.sample == "first5" then S.cardFirst5 else S.cardRest)
	if r.sample == "rest" and not s.tapped[best] then
		s.tapped[best] = true
		s.nTapped += 1
	end
	sc:progress()
	scene.overlay(sc)
	scene.checkFinal(sc)
end

function scene.check(sc)
	local s = sc.s
	if s.checked or s.asking then
		return
	end
	s.asking = true
	sc.shell:ask(S.bet, function(k)
		s.checked = true
		s.checkBtn.Visible = false
		scene.applyModel(sc)
		local correct = k == 2
		sc.shell:resolve(correct, S.bet.reveal:format(Format.num(s.r2rest, 2)))
		if correct then
			sc:honey(1)
		end
		sc:progress()
		scene.checkFinal(sc)
	end)
end

function scene.toggle(sc)
	local s = sc.s
	s.on = if s.on == 5 then 15 else 5
	s.model = if s.on == 5 then s.m5 else s.m15
	s.toggleBtn.Text = if s.on == 5 then S.train15 else S.train5
	if s.on == 15 and not s.toggled15 then
		s.toggled15 = true
		sc.shell:toast(S.after15, Theme.color.good)
	end
	if s.selected then
		scene.tap(sc, Vector2.new(-1000, -1000)) -- закрыть карточку (прогноз изменился)
	end
	scene.applyModel(sc)
	sc:progress()
	scene.checkFinal(sc)
end

function scene.checkFinal(sc)
	local s = sc.s
	if s.final then
		return
	end
	if s.rotated and s.checked and s.toggled15 and s.nTapped >= NEED_TAPS then
		s.final = true
		sc.shell:setText(S.final)
		sc:note(S.final)
	end
end

function scene.update(sc)
	local s = sc.s
	if not s.final and s.rotated then
		scene.checkFinal(sc)
	end
end

-- Строки R² открываются действиями: проверка на остальных 10 и переключение на 15 точек
scene.unlocks = {
	{ formula = "R2", line = "rest", when = function(sc) return sc.s.checked end },
	{ formula = "R2", line = "all", when = function(sc) return sc.s.toggled15 end },
}

function scene.canAdvance(sc)
	return sc.s.final == true
end

function scene.hintTargets(sc)
	local s = sc.s
	if not s.rotated then
		return { s.vp.frame }
	elseif not s.checked then
		return { s.checkBtn }
	elseif not s.toggled15 then
		return { s.toggleBtn }
	end
	return { s.vp.frame }
end

function scene.hintText(sc, level)
	local s = sc.s
	local key = if not s.rotated then "rotate" elseif not s.checked then "check" elseif not s.toggled15 then "toggle" else "tap"
	return Strings.hints["2D.4"][key][level]
end

return scene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">S2D_5_RidgeLasso</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D.5 L2 и L1: ограничение коэффициентов.
-- Слева L2 (Ridge, круг), справа L1 (Lasso, ромб). Плоскость коэффициентов (m_пчёлы, m_темп) малой выборки
-- (признаки стандартизованы по первым 5 точкам), эллипсы уровня Σe², точка OLS, область ограничения
-- размера t = ‖m(λ)‖ — решение всегда на границе, в точке касания самого низкого эллипса.
-- Общий ползунок λ ∈ [0; 20]. Пояснения открываются действием: L1 впервые «защёлкнулась» в вершину ромба;
-- L2 доведена до λ = 20 и всё ещё не ноль. Пути коэффициентов считаются один раз при входе (сетка 401 значение).

local Regression = script.Parent.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)
local Slider = require(Regression.UI.Slider)

local S = Strings.s2d["2D.5"]
local LAMBDA_MAX = 20
local GRID = 400
local LEVELS = { 4, 20, 60, 140 } -- фоновые эллипсы: SSE − SSE(OLS)

local scene = { id = "2D.5", panel = true }

function scene.enter(sc)
	local s, MathCore = sc.s, sc.MathCore
	sc.shell:setMainShare(0.68)
	local rows = sc.Datasets.small_sample.rows
	local X5, y5, Xr, yr = {}, {}, {}, {}
	for _, r in rows do
		if r.sample == "first5" then
			table.insert(X5, { r.bees_k, r.temperature_C }); table.insert(y5, r.honey_kg)
		else
			table.insert(Xr, { r.bees_k, r.temperature_C }); table.insert(yr, r.honey_kg)
		end
	end
	local Z5, mu, sd = MathCore.standardize(X5)
	local Zr = MathCore.standardize(Xr, mu, sd)
	s.Z5, s.y5, s.Zr, s.yr = Z5, y5, Zr, yr
	s.G = MathCore.gram(Z5)
	local b0, bOls = MathCore.ols(Z5, y5)
	s.bOls, s.b0 = bOls, b0
	s.sseOls = MathCore.sseCoef(Z5, y5, bOls)
	s.paths = { l2 = MathCore.path("l2", Z5, y5, LAMBDA_MAX, GRID), l1 = MathCore.path("l1", Z5, y5, LAMBDA_MAX, GRID) }
	local function r2rest(kind, lam)
		local c0, c = MathCore.pathAt(s.paths[kind], lam)
		return (MathCore.r2(yr, MathCore.predict(c0, c, Zr)))
	end
	s.r2rest = r2rest
	s.r2Ols = (MathCore.r2(yr, MathCore.predict(b0, bOls, Zr)))
	s.bonus = { ridge1 = r2rest("l2", 1), lasso15 = r2rest("l1", 1.5) }
	s.lambda = 0
	s.l1Snap, s.l2Max = false, false

	-- ── две половины ──
	local main = sc.shell.main
	local top = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -66), Parent = main })
	s.half = {}
	for i, kind in { "l2", "l1" } do
		local col = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromScale((i - 1) * 0.5, 0), Size = UDim2.new(0.5, -6, 1, 0), Parent = top })
		Gui.label({ Text = S.title[kind], Font = Theme.fontBold, TextSize = 20, TextColor3 = Theme.color.penalty, Size = UDim2.new(1, 0, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Center, Parent = col })
		local inner = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -96), Parent = col })
		local caption = Gui.label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 68),
			TextSize = 16, TextYAlignment = Enum.TextYAlignment.Top, Text = S.waiting[kind], TextColor3 = Theme.color.textDim, Parent = col })
		local plot = PlotView2D.new(inner, {
			xMin = -6, xMax = 18, yMin = -12, yMax = 12, equalAspect = true, equalCenterY = -1,
			xTicks = { -5, 0, 5, 10, 15 }, yTicks = { -20, -15, -10, -5, 0, 5, 10, 15, 20 },
			xLabel = S.xLabel, yLabel = S.yLabel, padL = 40, padR = 8, padT = 18, padB = 52, fontSize = 15, fallbackW = 300, fallbackH = 300,
		})
		s.half[kind] = { plot = plot, caption = caption }
		plot.onResize = function()
			scene.drawStatic(sc, kind)
			scene.draw(sc)
		end
	end

	-- ── ползунок λ под графиками ──
	local sliderHolder = Gui.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 60), Parent = main })
	s.slider = Slider.new(sliderHolder, {
		min = 0, max = LAMBDA_MAX, step = 0.05, buttonStep = 0.5, value = 0, label = "λ", color = Theme.color.penalty,
		format = function(v) return Format.num(v, 2) end,
		onChanged = function(v)
			s.lambda = v
			sc.store:set("lambda2d", v)
			sc:progress()
			s.dirty = true -- перерисовка — в update, не чаще 30 Гц
		end,
	})
	sc:conn({ Disconnect = function() s.slider:Destroy() end })
	sc:keys("LambdaUp", { Enum.KeyCode.E, Enum.KeyCode.Right }, function(down)
		s.keyDir = if down then 1 else 0
	end)
	sc:keys("LambdaDown", { Enum.KeyCode.Q, Enum.KeyCode.Left }, function(down)
		s.keyDir = if down then -1 else 0
	end)

	-- ── формулы ──
	local T = sc.T
	local m1, m2, lam = T.sub("m", "1", "m", "m"), T.sub("m", "2", "m_temp", "m_temp"), T.sym("λ", "penalty")
	local function sse(st, kind)
		local _, b = MathCore.pathAt(st.paths[kind], st.lambda)
		return MathCore.sseCoef(st.Z5, st.y5, b), b
	end
	sc:formula({
		id = "RIDGE", title = S.ridgeTitle, toNotebook = true,
		lines = { { id = "def", open = true,
			general = { T.sub("L", "ridge"), " = ", T.sum(), "e² + ", lam, "·(", m1, "² + ", m2, "²)" },
			numbers = function(st)
				local e2, b = sse(st, "l2")
				return { T.sub("L", "ridge"), " = ", T.col(Format.num(e2, 2), "residual"), " + ", T.col(Format.num(st.lambda, 2), "penalty"), "·(",
					T.col(Format.num(b[1], 2), "m"), "² + ", T.col(Format.num(b[2], 2), "m_temp"), "²)" }
			end,
			result = function(st)
				local e2, b = sse(st, "l2")
				return Format.num(e2 + st.lambda * (b[1] ^ 2 + b[2] ^ 2), 2)
			end } },
	})
	sc:formula({
		id = "LASSO", title = S.lassoTitle, toNotebook = true,
		lines = { { id = "def", open = true,
			general = { T.sub("L", "lasso"), " = ", T.sum(), "e² + ", lam, "·(|", m1, "| + |", m2, "|)" },
			numbers = function(st)
				local e2, b = sse(st, "l1")
				return { T.sub("L", "lasso"), " = ", T.col(Format.num(e2, 2), "residual"), " + ", T.col(Format.num(st.lambda, 2), "penalty"), "·(|",
					T.col(Format.num(b[1], 2), "m"), "| + |", T.col(Format.num(b[2], 2), "m_temp"), "|)" }
			end,
			result = function(st)
				local e2, b = sse(st, "l1")
				return Format.num(e2 + st.lambda * (math.abs(b[1]) + math.abs(b[2])), 2)
			end } },
	})
	sc:formula({
		id = "R2REST", title = S.r2Title, toNotebook = true,
		lines = {
			{ id = "now", open = true,
				general = { S.r2now },
				numbers = function(st)
					return { S.r2nowRidge, T.col(Format.num(st.r2rest("l2", st.lambda), 3), "penalty"), " · ", S.r2nowLasso,
						T.col(Format.num(st.r2rest("l1", st.lambda), 3), "penalty") }
				end },
			{ id = "bonus", hint = S.lockBonus,
				general = { S.bonus:format(Format.num(s.r2Ols, 3), Format.num(s.bonus.ridge1, 3), Format.num(s.bonus.lasso15, 3)) } },
		},
	})
	sc.shell:setText(S.intro)
	sc.shell:ask(S.bet, function(k)
		s.bet = k
		sc:progress()
	end)
	for _, kind in { "l2", "l1" } do
		scene.drawStatic(sc, kind)
	end
	scene.draw(sc)
end

local function ellipse(sc, center, level)
	local pts = {}
	for k = 0, 72 do
		local p = sc.MathCore.ellipsePoint(sc.s.G, center, level, k / 72 * 2 * math.pi)
		pts[k + 1] = { p[1], p[2] }
	end
	return pts
end

function scene.drawStatic(sc, kind)
	local s = sc.s
	local plot = s.half[kind].plot
	local L = plot:layer("static", 2)
	L:begin()
	for _, lv in LEVELS do
		L:polyline(ellipse(sc, s.bOls, lv), { color = Theme.color.loss, thickness = 1, transparency = 0.6 })
	end
	L:dot(s.bOls[1], s.bOls[2], { color = Theme.color.loss, size = 14, hollow = true })
	L:label(s.bOls[1], s.bOls[2], "OLS", { dx = 8, dy = -6, anchor = Vector2.new(0, 1), size = 15, color = Theme.color.loss })
	L:finish()
end

function scene.draw(sc)
	local s = sc.s
	local MathCore = sc.MathCore
	for _, kind in { "l2", "l1" } do
		local h = s.half[kind]
		local _, b = MathCore.pathAt(s.paths[kind], s.lambda)
		h.b = b
		local plot = h.plot
		local L = plot:layer("dynamic", 3)
		L:begin()
		-- область ограничения
		if kind == "l2" then
			local r = math.sqrt(b[1] ^ 2 + b[2] ^ 2)
			local pts = {}
			for k = 0, 72 do
				local a = k / 72 * 2 * math.pi
				pts[k + 1] = { r * math.cos(a), r * math.sin(a) }
			end
			L:polyline(pts, { color = Theme.color.penalty, thickness = 3 })
		else
			local t = math.abs(b[1]) + math.abs(b[2])
			L:polyline({ { t, 0 }, { 0, t }, { -t, 0 }, { 0, -t } }, { color = Theme.color.penalty, thickness = 3 }, true)
			if s.l1Snap and b[2] == 0 then
				L:dot(t, 0, { color = Theme.color.c, size = 22, hollow = true })
			end
		end
		-- самый низкий эллипс, касающийся области
		local lvl = MathCore.sseCoef(s.Z5, s.y5, b) - s.sseOls
		if lvl > 1e-6 then
			L:polyline(ellipse(sc, s.bOls, lvl), { color = Theme.color.loss, thickness = 3 })
		end
		L:dot(b[1], b[2], { color = Theme.color.penalty, size = 16, strokeColor = Theme.color.text })
		L:label(b[1], b[2], ("(%s; %s)"):format(Format.num(b[1], 2), Format.num(b[2], 2)), {
			dx = 10, dy = 6, anchor = Vector2.new(0, 0), size = 16, color = Theme.color.text, font = Theme.fontBold })
		L:finish()
	end
	-- события-действия
	local b1 = s.half.l1.b
	if not s.l1Snap and b1 and b1[2] == 0 and s.lambda > 0 then
		s.l1Snap = true
		s.half.l1.caption.Text = S.captionL1
		s.half.l1.caption.TextColor3 = Theme.color.text
		sc:toast(S.snapToast, Theme.color.penalty)
		if s.bet then
			local correct = s.bet == 2
			sc.shell:resolve(correct, S.bet.reveal)
			if correct then
				sc:honey(1)
			end
		end
		sc:progress()
	end
	if not s.l2Max and s.lambda >= LAMBDA_MAX - 1e-9 then
		s.l2Max = true
		local b2 = s.half.l2.b
		s.half.l2.caption.Text = S.captionL2:format(Format.num(b2[1], 2), Format.num(b2[2], 2))
		s.half.l2.caption.TextColor3 = Theme.color.text
		sc:progress()
	end
end

function scene.update(sc, dt)
	local s = sc.s
	if s.keyDir and s.keyDir ~= 0 then
		s.slider:set(s.slider.value + s.keyDir * 4 * dt)
	end
	if s.dirty then
		s.dirty = false
		scene.draw(sc)
	end
end

scene.unlocks = {
	{ formula = "R2REST", line = "bonus", when = function(sc) return sc.s.l1Snap and sc.s.l2Max end },
}

function scene.canAdvance(sc)
	return sc.s.l1Snap and sc.s.l2Max
end

function scene.hintTargets(sc)
	return { sc.s.slider.frame }
end

return scene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">S2D_6_PenaltyCurves</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D.6 Сумма ошибки от наклона при разных λ (данные клумбы, один признак — без стандартизации).
-- Два графика: L2 — L(m) + λ·m², L1 — L(m) + λ·|m|; L(m) — сумма квадратов при оптимальном c.
-- Ползунок λ ∈ [0; 10]; при отпускании текущая кривая остаётся бледным следом.
-- Игрок отмечает «где минимум» тапом по графику → игра показывает точный минимум.
-- Задание: найти λ, при котором минимум L1 впервые становится нулём (λ = 2·ΣΔxΔy = 6,6) — «излом в нуле».

local Regression = script.Parent.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)
local Slider = require(Regression.UI.Slider)
local Drag = require(Regression.UI.Drag)

local S = Strings.s2d["2D.6"]
local M_MIN, M_MAX = -0.2, 0.6
local LAMBDA_MAX = 10
local MAX_TRAILS = 4
local FIRST_ZERO_TOL = 0.3 -- λ из [6,6; 6,9] — «впервые ноль»
local GUESS_GOOD = 0.03

local scene = { id = "2D.6", panel = true }

function scene.enter(sc)
	local s, MathCore = sc.s, sc.MathCore
	sc.shell:setMainShare(0.66)
	local fb = sc.Datasets.flowerbed
	s.x, s.y = fb.x_m, fb.y_m
	s.o = MathCore.ols1d(s.x, s.y)
	s.lambda = 0
	s.trails = {}
	s.guess = {}
	s.exactShown = {}
	s.task = false
	s.zeroLambda = 2 * s.o.sxy -- 6,6

	local main = sc.shell.main
	local top = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -66), Parent = main })
	s.half = {}
	for i, kind in { "l2", "l1" } do
		local col = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromScale((i - 1) * 0.5, 0), Size = UDim2.new(0.5, -6, 1, 0), Parent = top })
		Gui.label({ Text = S.title[kind], Font = Theme.fontBold, TextSize = 19, Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Center, Parent = col })
		local inner = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 1, -26), Parent = col })
		local plot = PlotView2D.new(inner, {
			xMin = M_MIN, xMax = M_MAX, yMin = 0, yMax = 4, xTicks = { -0.2, 0, 0.2, 0.4, 0.6 }, yTicks = { 0, 1, 2, 3, 4 },
			xLabel = Strings.plotX, yLabel = S.yLabel, padL = 40, padR = 8, padT = 14, padB = 56, fontSize = 15, fallbackW = 300, fallbackH = 380,
		})
		local h = { plot = plot, kind = kind }
		s.half[kind] = h
		plot.onResize = function()
			scene.draw(sc)
		end
		-- тап по графику — «здесь минимум»
		h.drag = Drag.attach(plot.area, {
			began = function(p)
				local px = plot:screenToPx(p.X, p.Y)
				local m = plot:fromPx(px, 0)
				scene.mark(sc, kind, m)
				return false
			end,
		})
		sc:conn({ Disconnect = h.drag.Destroy })
	end

	local sliderHolder = Gui.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 60), Parent = main })
	s.slider = Slider.new(sliderHolder, {
		min = 0, max = LAMBDA_MAX, step = 0.1, buttonStep = 0.1, value = 0, label = "λ", color = Theme.color.penalty, format = Format.lambda,
		onChanged = function(v)
			s.lambda = v
			s.exactShown = {}
			sc.store:set("lambda2d", v)
			sc:progress()
			s.dirty = true -- перерисовка — в update, не чаще 30 Гц
		end,
		onReleased = function(v)
			scene.released(sc, v)
		end,
	})
	sc:conn({ Disconnect = function() s.slider:Destroy() end })

	local T = sc.T
	local m, lam = T.sym("m", "m"), T.sym("λ", "penalty")
	sc:formula({
		id = "CURVES", title = S.curvesTitle,
		lines = {
			{ id = "l2", open = true, general = { T.sym("L", "loss"), "(", m, ") + ", lam, "·", m, "²" },
				numbers = function(st) return { Format.num(st.o.sxx, 0), "·", m, "² − ", Format.num(2 * st.o.sxy, 1), "·", m, " + ", Format.num(st.o.syy, 2),
					" + ", T.col(Format.lambda(st.lambda), "penalty"), "·", m, "²" } end },
			{ id = "l1", open = true, general = { T.sym("L", "loss"), "(", m, ") + ", lam, "·|", m, "|" },
				numbers = function(st) return { Format.num(st.o.sxx, 0), "·", m, "² − ", Format.num(2 * st.o.sxy, 1), "·", m, " + ", Format.num(st.o.syy, 2),
					" + ", T.col(Format.lambda(st.lambda), "penalty"), "·|", m, "|" } end },
		},
	})
	sc:formula({
		id = "MIN2", title = S.min2Title, toNotebook = true,
		lines = { { id = "eq", hint = S.lockMin,
			general = { m, "* = ", T.frac({ T.sum(), "ΔxΔy" }, { T.sum(), "(Δx)² + ", lam }) },
			numbers = function(st) return { m, "* = ", T.frac({ Format.num(st.o.sxy, 1) }, { Format.num(st.o.sxx, 0), " + ", T.col(Format.lambda(st.lambda), "penalty") }) } end,
			result = function(st) return Format.num(sc.MathCore.penalizedMin1d(st.x, st.y, st.lambda, "l2"), 3) end } },
	})
	sc:formula({
		id = "MIN1", title = S.min1Title, toNotebook = true,
		lines = {
			{ id = "eq", hint = S.lockMin,
				general = { m, "* = ", T.frac({ "2·", T.sum(), "ΔxΔy − ", lam }, { "2·", T.sum(), "(Δx)²" }) },
				numbers = function(st) return { m, "* = ", T.frac({ Format.num(2 * st.o.sxy, 1), " − ", T.col(Format.lambda(st.lambda), "penalty") }, { Format.num(2 * st.o.sxx, 0) }) } end,
				result = function(st) return Format.num(sc.MathCore.penalizedMin1d(st.x, st.y, st.lambda, "l1"), 3) end },
			{ id = "kink", hint = S.lockKink,
				general = { lam, " ≥ 2·", T.sum(), "ΔxΔy  ⇒  ", m, "* = 0" },
				numbers = function(st) return { lam, " ≥ ", Format.num(st.zeroLambda, 1), "  ⇒  ", m, "* = 0" } end },
		},
	})
	sc.shell:setText(S.intro)
	sc.shell:setTask(S.task)
	scene.draw(sc)
end

function scene.lossAt(sc, kind: string, m: number, lam: number): number
	return sc.MathCore.penalizedLoss1d(sc.s.x, sc.s.y, m, lam, kind)
end

function scene.mark(sc, kind: string, m: number)
	local s = sc.s
	s.guess[kind] = math.clamp(m, M_MIN, M_MAX)
	s.exactShown[kind] = true
	s.anyGuess = true
	s.guessed = s.guessed or {}
	s.guessed[kind] = true
	local exact = sc.MathCore.penalizedMin1d(s.x, s.y, s.lambda, kind)
	local d = math.abs(s.guess[kind] - exact)
	if d < GUESS_GOOD then
		sc:toast(S.guessGood:format(Format.num(exact, 3)), Theme.color.good)
		s.goodGuess = s.goodGuess or {}
		if not s.goodGuess[kind] then
			s.goodGuess[kind] = true
			sc:honey(1)
		end
	else
		sc:toast(S.guessOff:format(Format.num(exact, 3), Format.num(d, 2)), Theme.color.c)
	end
	sc.store:set("guess2d", os.clock())
	sc:progress()
	scene.draw(sc)
end

function scene.released(sc, v: number)
	local s = sc.s
	-- след: прошлые λ остаются бледными кривыми
	local last = s.trails[#s.trails]
	if last == nil or math.abs(last - v) >= 0.5 then
		table.insert(s.trails, v)
		if #s.trails > MAX_TRAILS then
			table.remove(s.trails, 1)
		end
	end
	local m1 = sc.MathCore.penalizedMin1d(s.x, s.y, v, "l1")
	if not s.task and m1 == 0 and v - s.zeroLambda < FIRST_ZERO_TOL - 1e-9 then
		s.task = true
		sc.store:set("task2d6", true)
		sc.shell:setText(S.kink:format(Format.num(s.zeroLambda, 1)))
		sc:toast(S.taskDone, Theme.color.good)
		sc:note(S.note)
		sc:honey(1)
	elseif not s.task and m1 == 0 then
		sc:toast(S.tooFar, Theme.color.c)
	end
	sc:progress()
	scene.draw(sc)
end

function scene.draw(sc)
	local s = sc.s
	for _, kind in { "l2", "l1" } do
		local h = s.half[kind]
		local plot = h.plot
		local tr = plot:layer("trails", 2)
		tr:begin()
		for _, lam in s.trails do
			if math.abs(lam - s.lambda) > 1e-9 then
				tr:curve(function(m) return scene.lossAt(sc, kind, m, lam) end, M_MIN, M_MAX, 60, { color = Theme.color.penalty, thickness = 2, transparency = 0.65 })
				local mm = sc.MathCore.penalizedMin1d(s.x, s.y, lam, kind)
				tr:label(M_MAX, scene.lossAt(sc, kind, M_MAX, lam), "λ=" .. Format.lambda(lam), { dx = -4, anchor = Vector2.new(1, 1), size = 13, color = Theme.color.textDim })
				tr:dot(mm, scene.lossAt(sc, kind, mm, lam), { color = Theme.color.penalty, size = 8, transparency = 0.5 })
			end
		end
		tr:finish()

		local cur = plot:layer("current", 3)
		cur:begin()
		-- без штрафа — тонкая базовая кривая L(m)
		cur:curve(function(m) return scene.lossAt(sc, kind, m, 0) end, M_MIN, M_MAX, 60, { color = Theme.color.loss, thickness = 1, transparency = 0.5 })
		cur:curve(function(m) return scene.lossAt(sc, kind, m, s.lambda) end, M_MIN, M_MAX, 100, { color = Theme.color.penalty, thickness = 3 })
		cur:finish()

		local mk = plot:layer("marks", 5)
		mk:begin()
		local g = s.guess[kind]
		if g then
			mk:dashedV(g, 0, 4, { color = Theme.color.c, thickness = 2 })
			mk:label(g, 3.9, S.yourGuess, { dx = 4, anchor = Vector2.new(0, 0), size = 14, color = Theme.color.c })
		end
		if s.exactShown[kind] then
			local mm = sc.MathCore.penalizedMin1d(s.x, s.y, s.lambda, kind)
			local v = scene.lossAt(sc, kind, mm, s.lambda)
			mk:dot(mm, v, { color = Theme.color.flag, size = 14 })
			mk:label(mm, v, "m* = " .. Format.num(mm, 3), { dx = 6, dy = 20, anchor = Vector2.new(0, 0), size = 16, color = Theme.color.flag, font = Theme.fontBold })
		end
		mk:finish()
	end
end

scene.unlocks = {
	{ formula = "MIN2", line = "eq", when = function(sc) return sc.s.guessed ~= nil and sc.s.guessed.l2 == true end },
	{ formula = "MIN1", line = "eq", when = function(sc) return sc.s.guessed ~= nil and sc.s.guessed.l1 == true end },
	{ formula = "MIN1", line = "kink", when = function(sc) return sc.s.task end },
}

function scene.update(sc)
	local s = sc.s
	if s.dirty then
		s.dirty = false
		scene.draw(sc)
	end
end

function scene.canAdvance(sc)
	return sc.s.task and sc.s.anyGuess == true
end

function scene.hintTargets(sc)
	local s = sc.s
	if not s.anyGuess then
		return { s.half.l1.plot.area }
	end
	return { s.slider.frame }
end

return scene
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">S2D_7_R2</string>
              <string name="Source"><![CDATA[--!nonstrict
-- 2D.7 R². График из 2D.2 с оптимальной прямой (m = 0,47, c = 6,2).
-- Действие 1: собрать квадраты остатков в столбик — SS_res = Σ(yᵢ − ŷᵢ)² = 21,1.
-- Действие 2: поставить горизонтальную прямую на среднее (прилипание у ȳ = 25) и собрать квадраты — SS_tot = 242.
-- Открытие: R² = 1 − SS_res / SS_tot = 0,913, столбики в одном масштабе. Дальше — лор-задача.

local Regression = script.Parent.Parent.Parent
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local R2View = require(Regression.UI.R2View)

local S = Strings.s2d["2D.7"]

local scene = { id = "2D.7", panel = true, milestone = "regression_2d" }
scene.nextLabel = S.next

-- Общие формулы R² (используются и в лор-задаче)
function scene.formulas(sc, view)
	local T = sc.T
	local yi, yh, yb = T.sub("y", "i"), T.sub(T.hat("y"), "i"), T.bar("y", "mean", "mean")
	sc:formula({
		id = "SSRES", title = Strings.r2.ssResTitle, toNotebook = true,
		lines = { { id = "eq", hint = Strings.r2.lockRes,
			general = { T.sym("SS", "residual", "residual"), T.sub("", "res"), " = ", T.sum(), "(", yi, " − ", yh, ")²" },
			result = function() return Format.num(view:ssRes(), 1) end } },
	})
	sc:formula({
		id = "SSTOT", title = Strings.r2.ssTotTitle, toNotebook = true,
		lines = { { id = "eq", hint = Strings.r2.lockTot,
			general = { T.sym("SS", "mean", "mean"), T.sub("", "tot"), " = ", T.sum(), "(", yi, " − ", yb, ")²" },
			result = function() return Format.num(view:ssTot(), 1) end } },
	})
	sc:formula({
		id = "R2", title = Strings.r2.r2Title, toNotebook = true,
		lines = { { id = "eq", hint = Strings.r2.lockR2,
			general = { "R² = 1 − ", T.frac({ T.col("SS", "residual"), T.sub("", "res") }, { T.col("SS", "mean"), T.sub("", "tot") }) },
			numbers = function()
				return { "R² = 1 − ", T.frac({ T.col(Format.num(view:ssRes(), 1), "residual") }, { T.col(Format.num(view:ssTot(), 1), "mean") }) }
			end,
			result = function() return Format.num(1 - view:ssRes() / view:ssTot(), 3) end } },
	})
end

scene.r2Unlocks = {
	{ formula = "SSRES", line = "eq", when = function(sc) return sc.s.view.nRes == sc.s.view.n end },
	{ formula = "SSTOT", line = "eq", when = function(sc) return sc.s.view.nTot == sc.s.view.n end },
	{ formula = "R2", line = "eq", when = function(sc) return sc.s.view.phase == "done" end },
}
scene.unlocks = {
	scene.r2Unlocks[1], scene.r2Unlocks[2],
	{ formula = "R2", line = "eq", when = scene.r2Unlocks[3].when, onUnlock = function(sc)
		sc.shell:setText(S.done)
		sc:note(S.meaning)
	end },
}

function scene.enter(sc)
	local s = sc.s
	local idm = sc.Datasets.intercept_demo
	local o = sc.MathCore.ols1d(idm.bees_k, idm.honey_kg)
	local yhat = {}
	for i, x in idm.bees_k do
		yhat[i] = o.b1 * x + o.b0
	end
	s.view = R2View.new(sc.shell.main, {
		x = idm.bees_k, y = idm.honey_kg, yhat = yhat, line = { m = o.b1, c = o.b0 },
		xMin = 0, xMax = 70, xTicks = { 0, 10, 20, 30, 40, 50, 60, 70 }, yMin = 0, yMax = 45, yTicks = { 0, 10, 20, 30, 40 },
		xLabel = Strings.s2d["2D.2"].xLabel, yLabel = Strings.s2d["2D.2"].yLabel, unit = "кг²", meanStart = 8, snapTol = 1.5,
		store = sc.store,
		onPhase = function(phase)
			sc.shell:setText(S.phase[phase] or "")
			sc:progress()
		end,
		onChanged = function()
			sc:progress()
		end,
	})
	sc:conn({ Disconnect = function() s.view:Destroy() end })
	sc:keys("MeanUp", { Enum.KeyCode.LeftShift, Enum.KeyCode.Up }, function(down) s.meanDir = if down then 1 else 0 end)
	sc:keys("MeanDown", { Enum.KeyCode.LeftControl, Enum.KeyCode.Down }, function(down)
		s.meanDir = if down then -1 else 0
		if not down then s.view:_releaseMean() end
	end)
	scene.formulas(sc, s.view)
	sc.shell:setText(S.phase.res)
end

function scene.update(sc, dt)
	local s = sc.s
	if s.meanDir and s.meanDir ~= 0 then
		s.view:nudgeMean(s.meanDir * 8 * dt)
	elseif s.view.phase == "mean" and s.meanDir == 0 then
		s.meanDir = nil
		s.view:_releaseMean()
	end
end

function scene.canAdvance(sc)
	return sc.f.R2 ~= nil and sc.f.R2:isUnlocked("eq")
end

function scene.hintTargets(sc)
	local v = sc.s.view
	if v.phase == "res" then
		return { v.plot.area }
	elseif v.phase == "tot" then
		return { v.totBtn }
	end
	return { v.plot.area }
end

function scene.hintText(sc, level)
	local v = sc.s.view
	return Strings.hints["2D.7"][v.phase] and Strings.hints["2D.7"][v.phase][level] or nil
end

return scene
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="Folder" referent="39">
        <Properties>
          <string name="Name">Tests</string>
        </Properties>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LogicSpec</string>
            <string name="Source"><![CDATA[-- Автотест логики 3D experience: Format, BedGeometry, Records, LineModel, Store.
-- Контрольные числа — из раскадровки 3D (references/3d-experience.md).
-- run(mods) → checks, fails; mods = { MathCore, Datasets, Format, BedGeometry, Records, LineModel, Store }
return function(mods)
	local MathCore, D = mods.MathCore, mods.Datasets
	local Format, Geo, Records, LineModel, Store = mods.Format, mods.BedGeometry, mods.Records, mods.LineModel, mods.Store

	local checks, fails = 0, 0
	local function ok(name: string, cond: boolean)
		checks += 1
		if not cond then
			fails += 1
			print("FAIL " .. name)
		end
	end
	local function near(name: string, got: number?, want: number, tol: number?)
		ok(name .. (" (got %s, want %s)"):format(tostring(got), tostring(want)), got ~= nil and math.abs(got - want) <= (tol or 1e-4))
	end
	local function eq(name: string, got: any, want: any)
		ok(name .. (" (got %q, want %q)"):format(tostring(got), tostring(want)), got == want)
	end

	local NB, MINUS = "\u{00A0}", "\u{2212}"

	-- Format
	eq("num 0.566", Format.num(0.566, 3), "0,566")
	eq("signed +", Format.signed(0.26), "+0,26")
	eq("signed −", Format.signed(-0.37), MINUS .. "0,37")
	eq("signed −0", Format.signed(-0.001), "0,00")
	eq("mse unit", Format.mse(0.0982), "0,098" .. NB .. "м²")
	eq("len", Format.len(1), "1,00" .. NB .. "м")
	eq("percent", Format.percent(0.04 / 0.491), "8,1" .. NB .. "%")
	eq("lambda 0", Format.lambda(0), "0")

	-- LineModel: контрольные MSE
	local fb = D.flowerbed
	local lm = LineModel.new(MathCore, fb)
	near("mOpt", lm.mOpt, 0.33, 1e-12)
	near("hOpt = ȳ", lm.hOpt, 1.5, 1e-12)
	near("start MSE (m=0, h=1)", lm:compute(0, 1).mse, 0.566, 1e-9)
	near("best MSE (m=0.33, h=1.5)", lm:compute(0.33, 1.5).mse, 0.0982, 1e-9)
	local best = lm:compute(0.33, 1.5)
	for i, e in { 0.26, -0.37, -0.20, 0.47, -0.16 } do
		near("residual " .. i, best.e[i], e, 1e-9)
	end
	near("L at optimum", best.L, 0.491, 1e-9)
	for _, mh in { { -0.7, 0.3 }, { 0.1, 2.4 }, { 1.2, 1.0 }, { 0.33, 0 } } do
		local m, h = mh[1], mh[2]
		near(("closed form m=%g h=%g"):format(m, h), lm:compute(m, h).mse, 2 * m * m - 1.32 * m + 0.316 + (1.5 - h) ^ 2, 1e-9)
	end

	-- Records: пример записей из раскадровки (h = 1,0)
	local list = {}
	for _, m in { -0.2, 0.0, 0.2, 0.5, 0.8 } do
		local v = Records.validate(list, m, 1.0)
		ok("validate m=" .. m, v)
		list = Records.add(list, { m = m, mse = lm:compute(m, 1.0).mse, h = 1.0 })
	end
	local wantMse = { 0.910, 0.566, 0.382, 0.406, 0.790 }
	for i, r in list do
		near("record mse " .. i, r.mse, wantMse[i], 1e-9)
	end
	local P = Records.fit(MathCore, list)
	near("parabola a", P.a, 2.0, 1e-9)
	near("parabola m*", P.tStar, 0.33, 1e-9)
	near("parabola MSE*", P.vStar, 0.3482, 1e-9)
	local full, why = Records.validate(list, 1.2, 1.0)
	ok("full after 5", not full and why == "full")

	local l2 = { { m = 0.2, mse = 0, h = 1.0 } }
	local v1, r1, other = Records.validate(l2, 0.25, 1.0)
	ok("too close", not v1 and r1 == "too_close" and other == l2[1])
	ok("exactly 0.1 is fine", (Records.validate(l2, 0.3, 1.0)))
	ok("other height is free", (Records.validate(l2, 0.2, 1.05)))
	eq("atHeight filters", #Records.atHeight({ { m = 0, mse = 0, h = 1 }, { m = 0, mse = 0, h = 1.05 } }, 1.05), 1)
	ok("oneSide below", Records.oneSide({ { m = 0, mse = 0, h = 1 }, { m = 0.2, mse = 0, h = 1 } }, 0.33))
	ok("not oneSide", not Records.oneSide({ { m = 0, mse = 0, h = 1 }, { m = 0.5, mse = 0, h = 1 } }, 0.33))
	local big = {}
	for i = 1, 25 do
		big = Records.add(big, { m = i * 0.1, mse = 0, h = if i <= 22 then 2.0 else 1.0 })
	end
	ok("cap keeps current height", #big == Records.MAX_TOTAL and #Records.atHeight(big, 1.0) == 3)

	-- BedGeometry
	local x0, y0, x1, y1 = Geo.clipLine(0, 1, 5, 3)
	ok("clip flat", x0 == 0 and y0 == 1 and x1 == 5 and y1 == 1)
	x0, y0, x1, y1 = Geo.clipLine(1.5, 1 - 2.5 * 1.5, 5, 3)
	near("clip steep x0", x0, 1.8333333, 1e-6)
	near("clip steep y0", y0, 0, 1e-9)
	near("clip steep x1", x1, 3.8333333, 1e-6)
	near("clip steep y1", y1, 3, 1e-9)
	ok("clip outside", Geo.clipLine(0, 3.5, 5, 3) == nil)
	local cx, cy, side = Geo.square(0.5, 1.1, 0.84, 2.5, 1)
	near("square1 cx", cx, 0.37, 1e-9)
	near("square1 cy", cy, 0.97, 1e-9)
	near("square1 side", side, 0.26, 1e-9)
	cx = Geo.square(4.5, 2.0, 2.16, 2.5, 1)
	near("square5 goes right", cx, 4.58, 1e-9)
	local _, ty0, _, ty1 = Geo.thread(2.5, 1.3, 1.5, 0.5)
	ok("thread half", ty0 == 1.3 and math.abs(ty1 - 1.4) < 1e-12)
	local a, b, c, d = Geo.clipSegment(-2, 1, 2, 1, -1, 1.5, 0, 2)
	ok("clipSegment", a == -1 and b == 1 and c == 1.5 and d == 1)
	ok("clipSegment outside", Geo.clipSegment(-2, 3, 2, 3, -1, 1.5, 0, 2) == nil)
	near("distToRect inside", Geo.distToRect(3, -2, 10, 6), 0, 1e-12)
	near("distToRect corner", Geo.distToRect(13, 10, 10, 6), 5, 1e-12)

	-- Store
	local st = Store.new({ m = 0, records = {} })
	local seen, any = nil, 0
	local conn = st.Changed:Connect("m", function(v)
		seen = v
	end)
	st.Changed:Connect("*", function()
		any += 1
	end)
	st:set("m", 0.5)
	st:set("m", 0.5) -- без изменений — без события
	eq("store changed", seen, 0.5)
	eq("store * count", any, 1)
	conn.Disconnect()
	st:set("m", 0.7)
	eq("store disconnect", seen, 0.5)
	st:patch({ h = 1.5, honey = 2 })
	local ser = st:serialize()
	ok("serialize", ser.m == 0.7 and ser.h == 1.5 and ser.honey == 2 and ser.records ~= st:get("records"))

	print(("Logic3D: %d/%d проверок пройдено"):format(checks - fails, checks))
	return checks, fails
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">MathCoreSpec</string>
            <string name="Source"><![CDATA[-- Автотест MathCore против эталона scripts/export_expected.py (110 проверок).
-- Модуль возвращает функцию: run(MathCore, Datasets, ExpectedValues) → checks, fails.
-- Standalone: luau tests/run.luau · Studio: Script RegressionTests в ServerScriptService.
return function(MathCore, D, E)

	local fails, checks = 0, 0
	local function near(name: string, got: number, want: number, tol: number?)
		checks += 1
		if math.abs(got - want) > (tol or 1e-5) then
			fails += 1
			print(("FAIL %s: got %.6f want %.6f"):format(name, got, want))
		end
	end
	local function col(v)
		local X = {}
		for i, a in v do X[i] = { a } end
		return X
	end

	-- 3D-клумба
	local fb, Efb = D.flowerbed, E.flowerbed
	local x, y = fb.x_m, fb.y_m
	local o = MathCore.ols1d(x, y)
	near("fb m", o.b1, Efb.ols.m); near("fb c", o.b0, Efb.ols.c); near("fb L", MathCore.sse1d(x, y, o.b0, o.b1), Efb.ols.L)
	near("fb mse", MathCore.mseLine(x, y, o.b1, o.b0), Efb.ols.mse)
	for _, ex in Efb.mse_examples do
		local c = MathCore.lineFromPivot(ex.m, ex.h, fb.pivot_x_m)
		near(("fb mse m=%g h=%g"):format(ex.m, ex.h), MathCore.mseLine(x, y, ex.m, c), ex.mse)
	end
	local rec = Efb.recording_example
	local vs = {}
	for i, mm in rec.m do vs[i] = MathCore.mseLine(x, y, mm, MathCore.lineFromPivot(mm, rec.h, fb.pivot_x_m)); near("fb rec " .. i, vs[i], rec.mse[i]) end
	local P = MathCore.fitParabola(rec.m, vs)
	near("fb parabola a", P.a, rec.parabola.a); near("fb parabola m*", P.tStar, rec.parabola.m_star); near("fb parabola mse*", P.vStar, rec.parabola.mse_star)
	for i, e in Efb.residuals_at_ols do near("fb resid " .. i, y[i] - (o.b1 * x[i] + o.b0), e) end
	for lam, want in Efb.ridge_m do local _, b = MathCore.ridge(col(x), y, tonumber(lam)); near("fb ridge " .. lam, b[1], want) end
	for lam, want in Efb.lasso_m do local _, b = MathCore.lasso(col(x), y, tonumber(lam)); near("fb lasso " .. lam, b[1], want) end
	for key, want in Efb.penalized_loss do
		local kind, lam, mm = key:match("^(l%d)_([%d%.]+)_([%d%.%-]+)$")
		near("fb pen " .. key, MathCore.penalizedLoss1d(x, y, tonumber(mm), tonumber(lam), kind), want)
	end

	-- Свободный член и R²
	local idm, Eid = D.intercept_demo, E.intercept_demo
	local o2 = MathCore.ols1d(idm.bees_k, idm.honey_kg)
	near("id m", o2.b1, Eid.ols.m); near("id c", o2.b0, Eid.ols.c)
	local v2 = {}
	for i, cc in Eid.recording_example.c do v2[i] = MathCore.mseLine(idm.bees_k, idm.honey_kg, idm.fixed_slope, cc); near("id rec " .. i, v2[i], Eid.recording_example.mse[i]) end
	local P2 = MathCore.fitParabola(Eid.recording_example.c, v2)
	near("id c*", P2.tStar, Eid.recording_example.c_star); near("id mse*", P2.vStar, Eid.recording_example.mse_star)
	local yhat = {}
	for i, xi in idm.bees_k do yhat[i] = o2.b0 + o2.b1 * xi end
	local r, res, tot = MathCore.r2(idm.honey_kg, yhat)
	near("id r2", r, Eid.r2.r2); near("id ss_res", res, Eid.r2.ss_res); near("id ss_tot", tot, Eid.r2.ss_tot)

	-- Малая выборка
	local Es = E.small_sample
	local Xtr, ytr, Xte, yte, Xall, yall = {}, {}, {}, {}, {}, {}
	for _, row0 in D.small_sample.rows do
		local row = { row0.bees_k, row0.temperature_C }
		table.insert(Xall, row); table.insert(yall, row0.honey_kg)
		if row0.sample == "first5" then table.insert(Xtr, row); table.insert(ytr, row0.honey_kg)
		else table.insert(Xte, row); table.insert(yte, row0.honey_kg) end
	end
	local Ztr, mu, sd = MathCore.standardize(Xtr)
	local Zte = MathCore.standardize(Xte, mu, sd)
	local function chk(name, fn, lam, ex)
		local b0, b = fn(Ztr, ytr, lam)
		near(name .. " b0", b0, ex.b0)
		for j = 1, #b do near(name .. " coef" .. j, b[j], ex.coefs[j]) end
		near(name .. " r2 first5", (MathCore.r2(ytr, MathCore.predict(b0, b, Ztr))), ex.r2_first5)
		near(name .. " r2 rest", (MathCore.r2(yte, MathCore.predict(b0, b, Zte))), ex.r2_rest)
	end
	chk("ss ols", MathCore.ridge, 0, Es.ols_first5)
	for lam, ex in Es.ridge do chk("ss ridge " .. lam, MathCore.ridge, tonumber(lam), ex) end
	for lam, ex in Es.lasso do chk("ss lasso " .. lam, MathCore.lasso, tonumber(lam), ex) end
	local Za = MathCore.standardize(Xall); local a0, ab = MathCore.ols(Za, yall)
	near("ss ols all15", (MathCore.r2(yall, MathCore.predict(a0, ab, Za))), Es.ols_all15_r2)

	-- 2D experience и лор: новые функции ядра
	for hk, ex in Efb.slope_loss do
		local a, b, k = MathCore.slopeLoss(x, y, tonumber(hk), fb.pivot_x_m)
		near("slopeLoss a h=" .. hk, a, ex.a); near("slopeLoss b h=" .. hk, b, ex.b); near("slopeLoss k h=" .. hk, k, ex.k)
	end
	for kind, t in Efb.penalized_min do
		for lam, ex in t do
			near(("penalizedMin1d %s λ=%s"):format(kind, lam), MathCore.penalizedMin1d(x, y, tonumber(lam), kind), ex)
		end
	end
	local idm2, Eid2 = D.intercept_demo, E.intercept_demo
	for cc, ex in Eid2.dldc do
		near("dLdc c=" .. cc, MathCore.dLdc(idm2.bees_k, idm2.honey_kg, idm2.fixed_slope, tonumber(cc)), ex)
	end
	do
		local rows = D.small_sample.rows
		local X5, y5 = {}, {}
		for _, r in rows do
			if r.sample == "first5" then
				table.insert(X5, { r.bees_k, r.temperature_C }); table.insert(y5, r.honey_kg)
			end
		end
		local Z5, mu5, sd5 = MathCore.standardize(X5)
		local G = MathCore.gram(Z5)
		for a = 1, 2 do for b = 1, 2 do near(("gram %d%d"):format(a, b), G[a][b], Es.gram[a][b]) end end
		local _, bo = MathCore.ols(Z5, y5)
		near("sse ols", MathCore.sseCoef(Z5, y5, bo), Es.sse_ols)
		local ec = Es.ellipse_check
		local pt = MathCore.ellipsePoint(G, bo, ec.level, ec.t)
		-- знак собственных векторов произволен (numpy и Luau могут дать разные точки), проверяем само свойство:
		-- точка лежит на эллипсе уровня — SSE = SSE(b̂) + level
		near("ellipse sse", MathCore.sseCoef(Z5, y5, pt), ec.sse, 1e-4)
		for _, t in { 0, 1.3, 2.9, 4.4 } do
			near("ellipse sse t=" .. t, MathCore.sseCoef(Z5, y5, MathCore.ellipsePoint(G, bo, ec.level, t)), ec.sse, 1e-4)
		end
		local a0, araw = MathCore.toRawUnits(Es.ols_first5.b0, bo, mu5, sd5)
		near("raw a0 ss", a0, Es.ols_first5.raw.a0); near("raw a1 ss", araw[1], Es.ols_first5.raw.a[1]); near("raw a2 ss", araw[2], Es.ols_first5.raw.a[2])
		local path = MathCore.path("l1", Z5, y5, 20, 400)
		local _, bz = MathCore.pathAt(path, 1.5)
		near("lasso path λ=1.5 bees", bz[1], Es.lasso["1.5"].coefs[1], 1e-4)
		checks += 1
		if bz[2] ~= 0 then fails += 1; print("FAIL lasso path λ=1.5: температура не ровно 0") end
		local _, bnz = MathCore.pathAt(path, Es.lasso_zero_lambda - 0.01)
		checks += 1
		if bnz[2] == 0 then fails += 1; print("FAIL lasso path: температура обнулилась раньше λ*") end
		local rpath = MathCore.path("l2", Z5, y5, 20, 400)
		local _, br = MathCore.pathAt(rpath, 1)
		near("ridge path λ=1", br[1], Es.ridge["1"].coefs[1], 1e-6); near("ridge path λ=1 t", br[2], Es.ridge["1"].coefs[2], 1e-6)
	end

	-- Лор
	local L, El = D.lore, E.lore
	local function mat(rows)
		local X, yy = {}, {}
		for i, r in rows do
			local row = {}
			for j, f in L.features do row[j] = r[f] end
			X[i] = row; yy[i] = r.honey_kg
		end
		return X, yy
	end
	local Xl, hl = mat(L.train_apiaries); local Xp, hp = mat(L.player_hives)
	local Zl, ml, sl = MathCore.standardize(Xl); local Zp = MathCore.standardize(Xp, ml, sl)
	local lb0, lb = MathCore.lasso(Zl, hl, L.lambda_given)
	near("lore b0", lb0, El.lasso.b0)
	for j = 1, 3 do near("lore coef" .. j, lb[j], El.lasso.coefs[j]) end
	local pr = MathCore.predict(lb0, lb, Zp)
	for i = 1, #pr do near("lore pred" .. i, pr[i], El.lasso.predictions[i]) end
	near("lore r2", (MathCore.r2(hp, pr)), El.lasso.r2_player)
	local ob0, ob = MathCore.ols(Zl, hl)
	near("lore ols r2", (MathCore.r2(hp, MathCore.predict(ob0, ob, Zp))), El.ols.r2_player)
	near("lore corr bees-temp", MathCore.corr(MathCore.column(Xl, 2), MathCore.column(Xl, 3)), El.corr_bees_temp)
	near("ss corr first5", MathCore.corr(MathCore.column(Xtr, 1), MathCore.column(Xtr, 2)), Es.corr_first5)
	local ra0, ra = MathCore.toRawUnits(lb0, lb, ml, sl)
	near("lore raw intercept", ra0, El.lasso.raw_intercept)
	for j = 1, 3 do near("lore raw coef" .. j, ra[j], El.lasso.coefs_raw_units[j]) end
	local opr = MathCore.predict(ob0, ob, Zp)
	for i = 1, #opr do near("lore ols pred" .. i, opr[i], El.ols.predictions[i]) end

	print(("MathCore: %d/%d проверок пройдено"):format(checks - fails, checks))
	return checks, fails
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Drag</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Drag: перетаскивание мышью и пальцем по GuiObject.
--   local d = Drag.attach(frame, { began = fn(pos) -> boolean?, moved = fn(pos), ended = fn(pos) })
--   pos — Vector2 в экранных координатах GUI (та же система, что AbsolutePosition).
--   began может вернуть false — тогда это касание не перехватывается. d:Destroy() отключает всё.

local UserInputService = game:GetService("UserInputService")

local Drag = {}

local function isPress(t: Enum.UserInputType): boolean
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

function Drag.attach(gui: GuiObject, h)
	local active: InputObject? = nil
	local conns = {}
	local function pos(input: InputObject): Vector2
		return Vector2.new(input.Position.X, input.Position.Y)
	end
	table.insert(conns, gui.InputBegan:Connect(function(input)
		if active or not isPress(input.UserInputType) then
			return
		end
		if h.began and h.began(pos(input)) == false then
			return
		end
		active = input
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input)
		if not active then
			return
		end
		local t = input.UserInputType
		local same = (t == Enum.UserInputType.MouseMovement and active.UserInputType == Enum.UserInputType.MouseButton1)
			or (t == Enum.UserInputType.Touch and input == active)
		if same and h.moved then
			h.moved(pos(input))
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if active and (input == active or (isPress(input.UserInputType) and input.UserInputType == active.UserInputType)) then
			active = nil
			if h.ended then
				h.ended(pos(input))
			end
		end
	end))
	return {
		Destroy = function()
			for _, c in conns do
				c:Disconnect()
			end
			table.clear(conns)
			active = nil
		end,
		isActive = function()
			return active ~= nil
		end,
	}
end

return Drag
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">FormulaView</string>
            <string name="Source"><![CDATA[--!nonstrict
-- FormulaView: формула как данные (ui-system.md §2).
--   Три слоя: общий вид · с числами (по умолчанию) · результат (всегда справа). Тап по формуле — смена слоя.
--   Строки раскрываются по одной: закрытая строка — «🔒 подсказка», открытие ≤ 0,4 с.
--   Токен с bind ↔ объект: наведение/тап ставит store.highlight = bind; подсвеченный токен получает фон цвета объекта.
--   Обновление чисел не пересоздаёт Instance, если структура формулы не изменилась.
--   Размеры фиксированные, чтобы рамки не «дышали» при изменении чисел: у строки постоянная высота
--   (выше — только если в ней дробь), у токена с цифрами ширина берётся с запасом и только растёт,
--   масштаб длинной строки пересчитывается лишь при смене структуры формулы или ширины панели.
--
--   local T = FormulaView.T
--   local fv = FormulaView.new(parent, {
--       id = "DLDC", title = "Производная по c", toNotebook = true,
--       lines = {
--           { id = "deriv", general = { T.d("L", "c"), " = −2·", T.sum(), "(", T.sub("y", "i"), " − ", T.sym("m", "m"), "·", T.sub("x", "i"), " − ", T.sym("c", "c"), ")" },
--             numbers = function(s) return { ... } end, result = function(s) return Format.num(s.dldc, 2) end,
--             hint = "сделай 5 записей" },
--       } }, { store = store })
--   fv:unlock("deriv"); fv:refresh(state); fv:snapshot() → { title, lines = { "строка", ... } }

local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)

local FormulaView = {}
FormulaView.__index = FormulaView

-- ───── токены ─────

local T = {}
FormulaView.T = T

-- Символ объекта: цвет из Theme.color[color], bind — id объекта на графике
function T.sym(text: string, color: string?, bind: string?)
	return { k = "sym", text = text, color = color, bind = bind or color }
end
-- Число или текст цветом объекта, без привязки
function T.col(text: string, color: string)
	return { k = "sym", text = text, color = color }
end
-- Черта над буквой (x̄, ȳ) — Frame над токеном
function T.bar(text: string, color: string?, bind: string?)
	return { k = "bar", text = text, color = color, bind = bind }
end
-- «Шляпка» (ŷ) — маленький символ над токеном
function T.hat(text: string, color: string?, bind: string?)
	return { k = "hat", text = text, color = color, bind = bind }
end
function T.sub(base: any, sub: string, color: string?, bind: string?)
	return { k = "sub", base = base, small = sub, color = color, bind = bind }
end
function T.sup(base: any, sup: string, color: string?, bind: string?)
	return { k = "sup", base = base, small = sup, color = color, bind = bind }
end
function T.frac(num: { any }, den: { any })
	return { k = "frac", num = num, den = den }
end
-- Σ, крупнее текста
function T.sum()
	return { k = "big", text = "Σ" }
end
-- dL/dm как дробь
function T.d(f: string, v: string, color: string?)
	return T.frac({ "d" .. f }, { { k = "sym", text = "d" .. v, color = color } })
end
function T.res(text: string, color: string?)
	return { k = "res", text = text, color = color }
end

local function colorOf(name: string?): Color3
	if not name then
		return Theme.color.text
	end
	if name == "m" then
		return Theme.color.mText -- на тёмном фоне — светлый тон синего
	end
	return Theme.color[name] or Theme.color.text
end

-- ───── построение ─────

local function textWidth(text: string, size: number, font: Enum.Font): number
	if text == "" then
		return 0
	end
	return math.ceil(TextService:GetTextSize(text, size, font, Vector2.new(10000, 1000)).X) + 2
end

-- Запас для чисел: все цифры как «0», плюс знак и ещё одна цифра — тогда рамка почти никогда не растёт
local function reserveText(text: string): string
	if not text:find("%d") then
		return text
	end
	local r = text:gsub("%d", "0")
	if not r:find("\u{2212}") and not r:find("^%s*%-") then
		r = "\u{2212}" .. r
	end
	return r .. "0"
end

local function hasFrac(tokens): boolean
	for _, t in tokens or {} do
		if type(t) == "table" then
			if t.k == "frac" then
				return true
			end
			if (t.k == "sub" or t.k == "sup") and type(t.base) == "table" and hasFrac({ t.base }) then
				return true
			end
		end
	end
	return false
end

local function signature(tokens): string
	local parts = {}
	for _, t in tokens do
		if type(t) == "string" then
			table.insert(parts, "s")
		elseif t.k == "frac" then
			table.insert(parts, "f(" .. signature(t.num) .. "/" .. signature(t.den) .. ")")
		elseif t.k == "sub" or t.k == "sup" then
			table.insert(parts, t.k .. "(" .. signature({ t.base }) .. ")" .. (t.bind or ""))
		else
			table.insert(parts, t.k .. (t.bind or "") .. (t.color or ""))
		end
	end
	return table.concat(parts, ",")
end

function FormulaView.new(parent: GuiObject, spec, ctx)
	local self = setmetatable({}, FormulaView)
	ctx = ctx or {}
	self.spec = spec
	self.id = spec.id
	self.store = ctx.store
	self.size = ctx.textSize or 22
	self.layer = "numbers"
	self.unlocked = {}
	self.rows = {}
	self.bound = {} -- bind → { GuiObject }
	self.conns = {}
	self.state = ctx.state or {}

	self.root = Gui.frame({ Name = "Formula_" .. spec.id, BackgroundColor3 = Theme.color.panel, BackgroundTransparency = 0.05,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = ctx.layoutOrder or 0, Parent = parent })
	Gui.corner().Parent = self.root
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 8), Parent = self.root })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = self.root })

	local head = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, Parent = self.root })
	self.title = Gui.label({ Size = UDim2.new(1, -90, 1, 0), TextSize = 16, TextColor3 = Theme.color.textDim, Text = spec.title or "",
		Parent = head })
	-- переключатель слоёв: «Σ» — общий вид, «12» — с числами
	self.layerBtns = {}
	for i, l in { { "general", "Σ" }, { "numbers", "12" } } do
		local b = Gui.button({ Text = l[2], TextSize = 15, Size = UDim2.fromOffset(40, 22), AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -(2 - i) * 44, 0, 0), Parent = head })
		b.Activated:Connect(function()
			self:setLayer(l[1])
		end)
		self.layerBtns[l[1]] = b
	end
	self:_paintLayerBtns()

	for i, line in spec.lines do
		self:_buildRow(line, i)
		if line.open then
			self.unlocked[line.id] = true
		end
	end
	if self.store then
		table.insert(self.conns, self.store.Changed:Connect("highlight", function(v)
			self:_paintHighlight(v)
		end))
	end
	self:refresh(self.state)
	return self
end

function FormulaView:_paintLayerBtns()
	for name, b in self.layerBtns do
		b.BackgroundColor3 = if name == self.layer then Theme.color.loss else Theme.color.panel2
		b.TextColor3 = if name == self.layer then Theme.color.bg else Theme.color.text
	end
end

function FormulaView:setLayer(layer: string)
	self.layer = layer
	self:_paintLayerBtns()
	for _, row in self.rows do
		row.sig = nil -- перестроить
	end
	self:refresh(self.state)
end

function FormulaView:_buildRow(line, order: number)
	-- высота строки фиксированная: одна строка текста или две (если в формуле есть дробь)
	local general = if type(line.general) == "table" then line.general else nil
	if not general and type(line.general) == "function" then
		local ok, res = pcall(line.general, self.state)
		general = if ok then res else nil
	end
	local h = self:_rowHeight(hasFrac(general))
	local row = Gui.frame({ Name = "Line_" .. line.id, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h),
		LayoutOrder = order, Parent = self.root })
	-- тап по строке — смена слоя (кнопка поверх, под токенами)
	local tap = Gui.make("TextButton", { Text = "", BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromScale(1, 1),
		ZIndex = 1, Parent = row })
	tap.Activated:Connect(function()
		self:setLayer(if self.layer == "numbers" then "general" else "numbers")
	end)
	local content = Gui.frame({ Name = "Content", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0),
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5),
		AutomaticSize = Enum.AutomaticSize.XY, ZIndex = 2, Parent = row })
	Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 1), Parent = content })
	local scale = Gui.make("UIScale", { Scale = 1, Parent = content })
	local lock = Gui.label({ Name = "Locked", Size = UDim2.fromScale(1, 1), TextSize = self.size - 4,
		TextColor3 = Theme.color.textDim, Visible = false, ZIndex = 2, Parent = row })
	local r = { line = line, frame = row, content = content, scale = scale, lock = lock, leaves = {}, sig = nil, h = h }
	-- длинная строка ужимается под ширину панели; пересчёт — только при новой структуре или ширине панели,
	-- а не при каждом изменении чисел (иначе строка «дышит»)
	function r.fit()
		local avail = row.AbsoluteSize.X
		local w = content.AbsoluteSize.X / math.max(scale.Scale, 0.01)
		scale.Scale = if w > 1 and avail > 1 then math.clamp(avail / w, 0.55, 1) else 1
	end
	table.insert(self.conns, row:GetPropertyChangedSignal("AbsoluteSize"):Connect(r.fit))
	self.rows[line.id] = r
	self.rows[order] = r
end

function FormulaView:_rowHeight(tall: boolean): number
	return if tall then 2 * (self.size + 8) + 4 else self.size + 10
end

-- Лист: TextLabel / TextButton (если есть bind)
function FormulaView:_leaf(parent: Instance, text: string, opts): TextLabel
	opts = opts or {}
	local size = opts.size or self.size
	local cls = if opts.bind then "TextButton" else "TextLabel"
	local font = opts.font or Theme.fontMedium
	-- ширина фиксированная (с запасом для чисел), без AutomaticSize — иначе соседние токены прыгают
	local l = Gui.make(cls, {
		BackgroundTransparency = 1, BackgroundColor3 = colorOf(opts.color), BorderSizePixel = 0,
		Size = UDim2.fromOffset(textWidth(reserveText(text), size, font), opts.height or (size + 8)),
		Font = font, TextSize = size, TextColor3 = colorOf(opts.color), Text = text,
		RichText = false, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = opts.order or 0, ZIndex = 3, Parent = parent,
	})
	if cls == "TextButton" then
		(l :: any).AutoButtonColor = false
		Gui.corner(UDim.new(0, 4)).Parent = l
		local bind = opts.bind
		self.bound[bind] = self.bound[bind] or {}
		table.insert(self.bound[bind], l)
		l.MouseEnter:Connect(function()
			if self.store then self.store:set("highlight", bind) end
		end)
		l.MouseLeave:Connect(function()
			if self.store and self.store:get("highlight") == bind then self.store:set("highlight", nil) end
		end)
		;(l :: any).Activated:Connect(function()
			if self.store then
				self.store:set("highlight", if self.store:get("highlight") == bind then nil else bind)
			end
		end)
	end
	return l
end

function FormulaView:_build(parent: Instance, tokens, leaves, order0: number?)
	local order = order0 or 0
	for _, t in tokens do
		order += 1
		if type(t) == "string" then
			table.insert(leaves, self:_leaf(parent, t, { order = order }))
		elseif t.k == "sym" or t.k == "res" or t.k == "big" then
			table.insert(leaves, self:_leaf(parent, t.text, {
				order = order, color = t.color, bind = t.bind,
				font = if t.k == "res" then Theme.fontBold else nil,
				size = if t.k == "big" then math.floor(self.size * 1.3) else nil, height = self.size + 8,
			}))
		elseif t.k == "bar" or t.k == "hat" then
			local l = self:_leaf(parent, t.text, { order = order, color = t.color, bind = t.bind })
			table.insert(leaves, l)
			if t.k == "bar" then
				Gui.frame({ Name = "Bar", BackgroundColor3 = colorOf(t.color), AnchorPoint = Vector2.new(0.5, 0),
					Position = UDim2.new(0.5, 0, 0, 2), Size = UDim2.new(0.75, 0, 0, 2), ZIndex = 4, Parent = l })
			else
				Gui.label({ Name = "Hat", Text = "ˆ", TextSize = math.floor(self.size * 0.8), TextColor3 = colorOf(t.color),
					AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -math.floor(self.size * 0.35)),
					Size = UDim2.fromOffset(10, self.size), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4, Parent = l })
			end
		elseif t.k == "sub" or t.k == "sup" then
			local box = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(0, self.size + 8), AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = order, ZIndex = 3, Parent = parent })
			Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Parent = box })
			local base = t.base
			if type(base) == "string" then
				base = { k = "sym", text = base, color = t.color, bind = t.bind }
			end
			self:_build(box, { base }, leaves, 0)
			local smallSize = math.floor(self.size * 0.65)
			local holder = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(0, self.size + 8), AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = 10, ZIndex = 3, Parent = box })
			local sl = self:_leaf(holder, t.small, { size = smallSize, color = t.color, height = smallSize + 2 })
			sl.Position = UDim2.fromOffset(0, if t.k == "sub" then math.floor(self.size * 0.5) else 0)
			table.insert(leaves, sl)
		elseif t.k == "frac" then
			local box = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY,
				LayoutOrder = order, ZIndex = 3, Parent = parent })
			Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder, Parent = box })
			for i, part in { t.num, t.den } do
				local rowf = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY,
					LayoutOrder = i * 2 - 1, ZIndex = 3, Parent = box })
				Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder, Parent = rowf })
				self:_build(rowf, part, leaves, 0)
				if i == 1 then
					Gui.frame({ Name = "FracBar", BackgroundColor3 = Theme.color.text, Size = UDim2.new(1, 0, 0, 2), LayoutOrder = 2, ZIndex = 3, Parent = box })
				end
			end
		end
	end
end

-- Тексты листьев в том же порядке, что _build (для обновления на месте)
local function leafTexts(tokens, out)
	for _, t in tokens do
		if type(t) == "string" then
			table.insert(out, t)
		elseif t.k == "frac" then
			leafTexts(t.num, out)
			leafTexts(t.den, out)
		elseif t.k == "sub" or t.k == "sup" then
			local base = if type(t.base) == "string" then t.base else t.base.text
			table.insert(out, base)
			table.insert(out, t.small)
		else
			table.insert(out, t.text)
		end
	end
	return out
end

function FormulaView:_tokensFor(line, s)
	local tokens
	if self.layer == "general" or not line.numbers then
		tokens = if type(line.general) == "function" then line.general(s) else line.general
	else
		tokens = line.numbers(s)
	end
	tokens = table.clone(tokens or {})
	local res = line.result and line.result(s)
	if res then
		table.insert(tokens, T.res(" = " .. res, line.resultColor))
	end
	return tokens
end

-- Перерисовать числа (не чаще 30 Гц — троттлит вызывающий)
function FormulaView:refresh(s)
	self.state = s or self.state
	for i = 1, #self.spec.lines do
		local r = self.rows[i]
		local line = r.line
		local open = self.unlocked[line.id] == true
		r.content.Visible = open
		r.lock.Visible = not open
		if not open then
			r.lock.Text = "🔒 " .. (line.hint or "…")
			continue
		end
		local ok, tokens = pcall(self._tokensFor, self, line, self.state)
		if not ok then
			warn("FormulaView " .. self.id .. "." .. line.id .. ": " .. tostring(tokens))
			continue
		end
		local sig = signature(tokens)
		if sig == r.sig then
			local texts = leafTexts(tokens, {})
			local grew = false
			for k, l in r.leaves do
				if texts[k] and l.Text ~= texts[k] then
					l.Text = texts[k]
					-- ширина только растёт (редко: запас уже заложен), никогда не сжимается
					local need = textWidth(texts[k], l.TextSize, l.Font)
					if need > l.Size.X.Offset then
						l.Size = UDim2.fromOffset(need, l.Size.Y.Offset)
						grew = true
					end
				end
			end
			if grew then
				task.defer(r.fit)
			end
		else
			for _, c in r.content:GetChildren() do
				if not c:IsA("UIListLayout") and not c:IsA("UIScale") then
					c:Destroy()
				end
			end
			for b, list in self.bound do
				for k = #list, 1, -1 do
					if list[k]:IsDescendantOf(r.content) or list[k].Parent == nil then
						table.remove(list, k)
					end
				end
			end
			r.leaves = {}
			self:_build(r.content, tokens, r.leaves)
			r.sig = sig
			-- высота строки только растёт (дробь появилась в слое «с числами»)
			local need = self:_rowHeight(hasFrac(tokens))
			if need > r.h then
				r.h = need
				r.frame.Size = UDim2.new(1, 0, 0, need)
			end
			task.defer(r.fit)
			self:_paintHighlight(self.store and self.store:get("highlight"))
		end
	end
end

function FormulaView:isUnlocked(lineId: string): boolean
	return self.unlocked[lineId] == true
end

-- Открыть строку (≤ 0,4 с: вспышка фона)
function FormulaView:unlock(lineId: string)
	if self.unlocked[lineId] then
		return false
	end
	self.unlocked[lineId] = true
	self:refresh(self.state)
	local r = self.rows[lineId]
	if r then
		r.frame.BackgroundColor3 = Theme.color.loss
		r.frame.BackgroundTransparency = 0.6
		TweenService:Create(r.frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	end
	return true
end

function FormulaView:_paintHighlight(bind: string?)
	for b, list in self.bound do
		for _, l in list do
			l.BackgroundTransparency = if b == bind then 0.75 else 1
		end
	end
end

-- Для блокнота: открытые строки в виде с числами (токены, статичные — последние значения)
function FormulaView:snapshot()
	local lines = {}
	for i = 1, #self.spec.lines do
		local line = self.spec.lines[i]
		if self.unlocked[line.id] then
			local saved = self.layer
			self.layer = "numbers"
			local ok, tokens = pcall(self._tokensFor, self, line, self.state)
			self.layer = saved
			if ok then
				table.insert(lines, tokens)
			end
		end
	end
	return { id = self.id, title = self.spec.title or self.id, lines = lines }
end

function FormulaView:Destroy()
	for _, c in self.conns do
		c:Disconnect()
	end
	self.conns = {}
	self.root:Destroy()
end

return FormulaView
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Gui</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Gui: короткие фабрики Instance для UI и мира. Parent всегда ставится последним.

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)

local Gui = {}

function Gui.make(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			else
				inst[k] = v
			end
		end
	end
	if children then
		for _, c in children do
			c.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function merge(defaults: { [string]: any }, props: { [string]: any }?): { [string]: any }
	local t = table.clone(defaults)
	if props then
		for k, v in props do
			t[k] = v
		end
	end
	return t
end

function Gui.corner(radius: UDim?): UICorner
	return Gui.make("UICorner", { CornerRadius = radius or UDim.new(0, 10) })
end

function Gui.stroke(color: Color3, thickness: number?, transparency: number?): UIStroke
	return Gui.make("UIStroke", {
		Color = color,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Gui.label(props: { [string]: any }?): TextLabel
	return Gui.make("TextLabel", merge({
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = Theme.font,
		TextColor3 = Theme.color.text,
		TextSize = Theme.size.hudText,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		RichText = true,
		TextWrapped = true,
		Text = "",
	}, props))
end

function Gui.button(props: { [string]: any }?): TextButton
	local b = Gui.make("TextButton", merge({
		BackgroundColor3 = Theme.color.panel2,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Font = Theme.fontBold,
		TextColor3 = Theme.color.text,
		TextSize = Theme.size.hudText,
		RichText = true,
		Text = "",
	}, props))
	Gui.corner().Parent = b
	return b
end

function Gui.frame(props: { [string]: any }?): Frame
	return Gui.make("Frame", merge({
		BackgroundColor3 = Theme.color.panel,
		BorderSizePixel = 0,
	}, props))
end

-- Part для мира: закреплён, не мешает персонажу и лучам, без теней
function Gui.part(props: { [string]: any }?): Part
	return Gui.make("Part", merge({
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
		Material = Enum.Material.SmoothPlastic,
		TopSurface = Enum.SurfaceType.Smooth,
		BottomSurface = Enum.SurfaceType.Smooth,
	}, props))
end

-- Надпись над объектом в мире (размер в пикселях — читается с любого расстояния)
function Gui.billboard(adornee: Instance, text: string, props: { [string]: any }?): (BillboardGui, TextLabel)
	local bb = Gui.make("BillboardGui", merge({
		Adornee = adornee,
		Size = UDim2.fromOffset(150, 34),
		StudsOffsetWorldSpace = Vector3.new(0, 1.2, 0),
		AlwaysOnTop = false,
		LightInfluence = 0,
		MaxDistance = 60,
		ResetOnSpawn = false,
	}, props))
	local lbl = Gui.label({
		Size = UDim2.fromScale(1, 1),
		Text = text,
		TextSize = 22,
		Font = Theme.fontBold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.4,
		Parent = bb,
	})
	bb.Parent = adornee
	return bb, lbl
end

return Gui
]]></string>
          </Properties>
