        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Hud: экранный слой 3D experience (ScreenGui):
--   баннер шага · мёд · «?» и панель подсказки · всплывающие сообщения · ставки ·
--   кнопки действий (с телефона всё доступно тапом) · пульт управления прямой (удержание = непрерывно).

local TweenService = game:GetService("TweenService")

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)

local Hud = {}
Hud.__index = Hud

function Hud.new(playerGui: PlayerGui)
	local self = setmetatable({}, Hud)
	self.gui = Gui.make("ScreenGui", {
		Name = "RegressionHud", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui,
	})
	self.actions = {}
	self.pad = {}
	self.padHandlers = {} -- name → function(down: boolean)
	self.onHintRequest = nil :: (() -> ())?
	self:_buildBanner()
	self:_buildTopRight()
	self:_buildToast()
	self:_buildPrediction()
	self:_buildActions()
	self:_buildPad()
	return self
end

-- ───── баннер шага ─────

function Hud:_buildBanner()
	-- слева сверху: справа сверху в SkRob живёт HUD тайкуна (MainUI.HUD)
	local b = Gui.frame({ AnchorPoint = Vector2.new(0, 0), Position = UDim2.new(0, 12, 0, 8), Size = UDim2.new(0.5, 0, 0, 70),
		BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.15, Parent = self.gui })
	Gui.corner().Parent = b
	Gui.make("UISizeConstraint", { MaxSize = Vector2.new(600, 70), MinSize = Vector2.new(300, 70), Parent = b })
	self.bannerStep = Gui.label({ Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, 22), TextSize = Theme.size.hudSmall,
		TextColor3 = Theme.color.textDim, Parent = b })
	self.bannerTask = Gui.label({ Position = UDim2.fromOffset(14, 28), Size = UDim2.new(1, -28, 0, 38), TextSize = Theme.size.hudText,
		Font = Theme.fontBold, TextScaled = true, Parent = b })
	Gui.make("UITextSizeConstraint", { MaxTextSize = Theme.size.hudText, Parent = self.bannerTask })
end

-- HUD модуля виден только рядом с клумбой / пасекой или во время заданий модуля
function Hud:setVisible(on: boolean)
	if self.gui.Enabled ~= on then
		self.gui.Enabled = on
	end
end

function Hud:setStep(id: string)
	local s = Strings.step[id]
	if not s then
		return
	end
	self.bannerStep.Text = Strings.hud.stepLabel:format(id, s.title)
	self.bannerTask.Text = s.task
end

-- ───── мёд и подсказки ─────

function Hud:_buildTopRight()
	self.hintBtn = Gui.button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 56), Size = UDim2.fromOffset(52, 52),
		Text = Strings.hud.hintBtn, TextSize = 30, BackgroundColor3 = Theme.color.panel2, Parent = self.gui })
	self.hintBtn.Activated:Connect(function()
		if self.onHintRequest then
			self.onHintRequest()
		end
	end)
	self.honey = Gui.label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -74, 0, 56), Size = UDim2.fromOffset(120, 52),
		BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.15, Font = Theme.fontBold, TextColor3 = Theme.color.c,
		TextXAlignment = Enum.TextXAlignment.Center, Parent = self.gui })
	Gui.corner().Parent = self.honey
	self:setHoney(0)

	self.hint = Gui.frame({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 116), Size = UDim2.fromOffset(330, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.1, Visible = false, Parent = self.gui })
	Gui.corner().Parent = self.hint
	Gui.stroke(Theme.color.loss, 2).Parent = self.hint
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), Parent = self.hint })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = self.hint })
	self.hintTitle = Gui.label({ Size = UDim2.new(1, 0, 0, 22), TextSize = Theme.size.hudSmall, TextColor3 = Theme.color.loss, LayoutOrder = 1, Parent = self.hint })
	self.hintText = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = self.hint })
end

function Hud:setHoney(n: number)
	self.honey.Text = Strings.hud.honey:format(n)
end

function Hud:showHint(level: number, text: string)
	self.hintTitle.Text = Strings.hud.hintTitle:format(level)
	self.hintText.Text = text
	self.hint.Visible = true
end

function Hud:hideHint()
	self.hint.Visible = false
end

-- ───── всплывающие сообщения ─────

function Hud:_buildToast()
	self.toastLabel = Gui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 90), Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.1, Font = Theme.fontBold,
		TextWrapped = false, Visible = false, Parent = self.gui })
	Gui.corner().Parent = self.toastLabel
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = self.toastLabel })
	self.toastId = 0
end

function Hud:toast(text: string, color: Color3?)
	self.toastId += 1
	local id = self.toastId
	local l = self.toastLabel
	l.Text = text
	l.TextColor3 = color or Theme.color.text
	l.Visible = true
	task.delay(Config.TOAST_S, function()
		if self.toastId == id then
			l.Visible = false
		end
	end)
end

-- ───── ставки ─────

function Hud:_buildPrediction()
	local p = Gui.frame({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(330, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.08, Visible = false, Parent = self.gui })
	Gui.corner().Parent = p
	Gui.stroke(Theme.color.c, 2).Parent = p
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 12), Parent = p })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = p })
	Gui.label({ Text = Strings.hud.predictionTitle, TextColor3 = Theme.color.c, TextSize = Theme.size.hudSmall, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = p })
	self.predQuestion = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Theme.fontBold, LayoutOrder = 2, Parent = p })
	self.predButtons = {}
	for i = 1, 4 do
		local b = Gui.button({ Size = UDim2.new(1, 0, 0, Theme.size.touch), LayoutOrder = 2 + i, Visible = false, Parent = p })
		b.Activated:Connect(function()
			if self.predPick then
				local fn = self.predPick
				self.predPick = nil
				self.predChosen = i
				for k, other in self.predButtons do
					other.BackgroundColor3 = if k == i then Theme.color.c else Theme.color.panel2
					other.AutoButtonColor = false
				end
				fn(i)
			end
		end)
		self.predButtons[i] = b
	end
	self.predResult = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10, Visible = false, Parent = p })
	self.pred = p
end

-- Показать ставку; onPick(i) вызывается один раз
function Hud:ask(spec, onPick: (number) -> ())
	self.predQuestion.Text = spec.question
	for i, b in self.predButtons do
		local opt = spec.options[i]
		b.Visible = opt ~= nil
		b.Text = opt or ""
		b.BackgroundColor3 = Theme.color.panel2
		b.AutoButtonColor = true
	end
	self.predResult.Visible = false
	self.predPick = onPick
	self.pred.Visible = true
end

-- Ответ после действия игрока; панель закрывается сама
function Hud:resolve(correct: boolean, explanation: string)
	self.predResult.Text = (if correct then Theme.tok("good", Strings.hud.predictionOk) else Strings.hud.predictionWrong) .. "\n" .. explanation
	self.predResult.Visible = true
	self.pred.Visible = true
	self.predPick = nil
	task.delay(6, function()
		self.pred.Visible = false
	end)
end

function Hud:closePrediction()
	self.pred.Visible = false
	self.predPick = nil
end

-- ───── кнопки действий ─────

function Hud:_buildActions()
	local col = Gui.frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = self.gui })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom, Parent = col })
	for order, slot in { "primary", "control" } do
		local b = Gui.button({ Size = UDim2.fromOffset(300, 54), LayoutOrder = order, Visible = false, TextSize = 22,
			BackgroundColor3 = if slot == "primary" then Theme.color.loss else Theme.color.panel2,
			TextColor3 = if slot == "primary" then Theme.color.bg else Theme.color.text, Parent = col })
		b.Activated:Connect(function()
			local a = self.actions[slot]
			if a and a.callback then
				a.callback()
			end
		end)
		self.actions[slot] = { button = b, callback = nil }
	end
	self.actionColumn = col
end

-- slot: "primary" | "control"; text = nil прячет кнопку
function Hud:setAction(slot: string, text: string?, callback: (() -> ())?)
	local a = self.actions[slot]
	a.callback = callback
	a.button.Visible = text ~= nil
	if text then
		a.button.Text = text
	end
end

-- ───── пульт управления прямой ─────

function Hud:_buildPad()
	local h = Strings.hud
	local pad = Gui.frame({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(2 * 128 + 8, 3 * 62 + 16),
		BackgroundTransparency = 1, Visible = false, Parent = self.gui })
	Gui.make("UIGridLayout", { CellSize = UDim2.fromOffset(128, 62), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = pad })
	local spec = {
		{ "slopeUp", h.slopeUp, h.keyQ, Theme.color.m, true },
		{ "up", h.up, h.keyShift, Theme.color.c, true },
		{ "slopeDown", h.slopeDown, h.keyE, Theme.color.m, true },
		{ "down", h.down, h.keyCtrl, Theme.color.c, true },
		{ "record", h.record, h.keyR, Theme.color.loss, false },
		{ "exit", h.exit, h.keyX, Theme.color.panel2, false },
	}
	for order, s in spec do
		local name, text, key, color, hold = s[1], s[2], s[3], s[4], s[5]
		local b = Gui.button({ LayoutOrder = order, BackgroundColor3 = Theme.color.panel2, TextSize = 20,
			Text = ("%s\n<font size=\"14\" color=\"%s\">%s</font>"):format(text, Theme.hex.textDim, key), Parent = pad })
		Gui.stroke(color, 2).Parent = b
		if hold then
			local function set(down: boolean)
				local fn = self.padHandlers[name]
				if fn then
					fn(down)
				end
			end
			b.InputBegan:Connect(function(input)
				local t = input.UserInputType
				if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
					set(true)
				end
			end)
			b.InputEnded:Connect(function(input)
				local t = input.UserInputType
				if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
					set(false)
				end
			end)
			b.MouseLeave:Connect(function()
				set(false)
			end)
		else
			b.Activated:Connect(function()
				local fn = self.padHandlers[name]
				if fn then
					fn(true)
				end
			end)
		end
		self.pad[name] = b
	end
	self.padFrame = pad

	self.keysBar = Gui.label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -90), Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.15, TextWrapped = false,
		Text = h.keysBar, TextSize = 18, Visible = false, Parent = self.gui })
	Gui.corner().Parent = self.keysBar
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6), Parent = self.keysBar })
end

function Hud:showPad(on: boolean, keyboard: boolean, recordEnabled: boolean)
	self.padFrame.Visible = on
	self.keysBar.Visible = on and keyboard
	self.pad.record.Visible = recordEnabled
end

-- Короткая вспышка кнопки (подтверждение действия ≤ 0,6 с)
function Hud:flash(gui: GuiObject)
	local old = gui.BackgroundColor3
	gui.BackgroundColor3 = Theme.color.good
	TweenService:Create(gui, TweenInfo.new(0.5), { BackgroundColor3 = old }):Play()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Notebook</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Notebook: «Блокнот пасечника» — формулы прошлых сцен (статичные, последние значения) и заметки,
-- сгруппированные по сценам. Прокручиваемый список поверх экрана 2D.
--   nb:addFormula(sceneId, snapshot) · nb:addNote(sceneId, text) · nb:setVisible(on) · nb.entries (для Store.serialize)

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)
local FormulaView = require(Regression.UI.FormulaView)

local Notebook = {}
Notebook.__index = Notebook

function Notebook.new(parent: GuiObject)
	local self = setmetatable({}, Notebook)
	self.entries = {}
	self.groups = {}
	self.frame = Gui.frame({ Name = "Notebook", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 60),
		Size = UDim2.new(0.5, 0, 1, -130), BackgroundColor3 = Theme.color.bg, Visible = false, ZIndex = 40, Parent = parent })
	Gui.corner().Parent = self.frame
	Gui.stroke(Theme.color.c, 2).Parent = self.frame
	Gui.make("UISizeConstraint", { MinSize = Vector2.new(300, 200), Parent = self.frame })
	Gui.label({ Text = Strings.s2d.notebookTitle, Font = Theme.fontBold, TextSize = 22, Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -80, 0, 30), ZIndex = 41, Parent = self.frame })
	local close = Gui.button({ Text = "✕", Size = UDim2.fromOffset(44, 36), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 6),
		ZIndex = 41, Parent = self.frame })
	close.Activated:Connect(function()
		self:setVisible(false)
	end)
	self.list = Gui.make("ScrollingFrame", {
		Position = UDim2.fromOffset(10, 46), Size = UDim2.new(1, -20, 1, -56), BackgroundTransparency = 1, BorderSizePixel = 0,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 6, ZIndex = 41, Parent = self.frame,
	})
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = self.list })
	self.empty = Gui.label({ Text = Strings.s2d.notebookEmpty, TextColor3 = Theme.color.textDim, Size = UDim2.new(1, 0, 0, 30),
		ZIndex = 41, Parent = self.list })
	return self
end

function Notebook:_group(sceneId: string)
	local g = self.groups[sceneId]
	if g then
		return g
	end
	local order = 0
	for _ in self.groups do
		order += 1
	end
	g = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order + 1, ZIndex = 41, Parent = self.list })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = g })
	local step = Strings.step[sceneId]
	Gui.label({ Text = ("%s · %s"):format(sceneId, if step then step.title else ""), Font = Theme.fontBold, TextSize = 18,
		TextColor3 = Theme.color.c, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 0, ZIndex = 41, Parent = g })
	self.groups[sceneId] = g
	self.empty.Visible = false
	return g
end

-- snapshot — результат FormulaView:snapshot()
function Notebook:addFormula(sceneId: string, snap)
	if not snap or #snap.lines == 0 then
		return
	end
	table.insert(self.entries, { scene = sceneId, kind = "formula", title = snap.title, lines = snap.lines })
	local g = self:_group(sceneId)
	local lines = {}
	for i, tokens in snap.lines do
		lines[i] = { id = "l" .. i, general = tokens, open = true }
	end
	local fv = FormulaView.new(g, { id = snap.id .. "_nb", title = snap.title, lines = lines }, { textSize = 18, layoutOrder = #self.entries })
	fv.root.BackgroundColor3 = Theme.color.panel
end

function Notebook:addNote(sceneId: string, text: string)
	for _, e in self.entries do
		if e.kind == "note" and e.text == text then
			return
		end
	end
	table.insert(self.entries, { scene = sceneId, kind = "note", text = text })
	local g = self:_group(sceneId)
	Gui.label({ Text = "✎ " .. text, TextSize = 18, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = #self.entries, ZIndex = 41, Parent = g })
end

function Notebook:setVisible(on: boolean)
	self.frame.Visible = on
end

function Notebook:toggle()
	self:setVisible(not self.frame.Visible)
end

return Notebook
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">PlotView2D</string>
            <string name="Source"><![CDATA[--!nonstrict
-- PlotView2D: 2D-график из Frame'ов. Работает и в ScreenGui, и в SurfaceGui (табло).
-- Слои с пулами объектов: каждый кадр layer:begin() → dot/seg/curve/label → layer:finish().
-- Instance.new только при первом заполнении пула. Отрезки обрезаются аналитически
-- (ClipsDescendants не обрезает повёрнутые Frame).
--
--   local plot = PlotView2D.new(frame, { xMin=-1, xMax=1.5, yMin=0, yMax=2,
--       xTicks={...}, yTicks={...}, xLabel="m", yLabel="MSE", fallbackW=500, fallbackH=380 })
--   local L = plot:layer("records", 5); L:begin(); L:dot(0.2, 0.38, {color=...}); L:finish()

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local BedGeometry = require(Regression.Core.BedGeometry)

local PlotView2D = {}
PlotView2D.__index = PlotView2D

local Layer = {}
Layer.__index = Layer

local function defaultFormat(v: number): string
	local s = string.format("%g", v)
	s = (s:gsub("%.", ","))
	return (s:gsub("^%-", "\u{2212}"))
end

-- Шаг делений 1, 2, 5 × 10ⁿ, чтобы делений было около target
function PlotView2D.niceStep(span: number, target: number?): number
	local raw = span / (target or 5)
	local p = 10 ^ math.floor(math.log10(raw))
	for _, k in { 1, 2, 5, 10 } do
		if raw <= k * p + 1e-12 then
			return k * p
		end
	end
	return 10 * p
end

-- Деления от a до b с «красивым» шагом
function PlotView2D.ticks(a: number, b: number, target: number?): { number }
	local step = PlotView2D.niceStep(b - a, target)
	local out = {}
	local v = math.ceil(a / step - 1e-9) * step
	while v <= b + 1e-9 do
		table.insert(out, tonumber(string.format("%.6f", v)))
		v += step
	end
	return out
end

function PlotView2D.new(parent: GuiObject, opts)
	local self = setmetatable({}, PlotView2D)
	opts.padL = opts.padL or 64
	opts.padR = opts.padR or 16
	opts.padT = opts.padT or 40
	opts.padB = opts.padB or 64
	opts.fontSize = opts.fontSize or 22
	opts.formatX = opts.formatX or defaultFormat
	opts.formatY = opts.formatY or defaultFormat
	self.opts = opts
	self.root = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = parent })
	self.area = Gui.frame({
		BackgroundColor3 = opts.bg or Theme.color.panel,
		Position = UDim2.fromOffset(opts.padL, opts.padT),
		Size = UDim2.new(1, -(opts.padL + opts.padR), 1, -(opts.padT + opts.padB)),
		Parent = self.root,
	})
	self.layers = {}
	self.onResize = nil :: (() -> ())?
	self.area:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:drawGrid()
		if self.onResize then
			self.onResize()
		end
	end)
	self:drawGrid()
	return self
end

function PlotView2D:size(): (number, number)
	local s = self.area.AbsoluteSize
	if s.X < 2 or s.Y < 2 then
		return self.opts.fallbackW or 400, self.opts.fallbackH or 300
	end
	return s.X, s.Y
end

function PlotView2D:toPx(x: number, y: number): (number, number)
	local o = self.opts
	local w, h = self:size()
	return (x - o.xMin) / (o.xMax - o.xMin) * w, (1 - (y - o.yMin) / (o.yMax - o.yMin)) * h
end

-- Пиксели области графика → координаты данных
function PlotView2D:fromPx(px: number, py: number): (number, number)
	local o = self.opts
	local w, h = self:size()
	return o.xMin + px / w * (o.xMax - o.xMin), o.yMin + (1 - py / h) * (o.yMax - o.yMin)
end

-- Экранная точка (InputObject.Position / AbsolutePosition) → пиксели области
function PlotView2D:screenToPx(sx: number, sy: number): (number, number)
	local a = self.area.AbsolutePosition
	return sx - a.X, sy - a.Y
end

-- Пикселей на единицу данных по осям
function PlotView2D:scale(): (number, number)
	local o = self.opts
	local w, h = self:size()
	return w / (o.xMax - o.xMin), h / (o.yMax - o.yMin)
end

-- Новый диапазон осей (деления — опционально); сетка перерисовывается сразу
function PlotView2D:setRange(xMin: number, xMax: number, yMin: number, yMax: number, xTicks: { number }?, yTicks: { number }?)
	local o = self.opts
	o.xMin, o.xMax, o.yMin, o.yMax = xMin, xMax, yMin, yMax
	if xTicks then o.xTicks = xTicks end
	if yTicks then o.yTicks = yTicks end
	self:drawGrid()
end

-- Равный масштаб осей (круг остаётся кругом): ось y подстраивается под пропорции области вокруг центра
function PlotView2D:_applyEqualAspect()
	local o = self.opts
	if not o.equalAspect then
		return
	end
	local w, h = self:size()
	local cy = o.equalCenterY or (o.yMin + o.yMax) / 2
	o.equalCenterY = cy
	local half = (o.xMax - o.xMin) * h / w / 2
	o.yMin, o.yMax = cy - half, cy + half
end

function PlotView2D:inRange(x: number, y: number): boolean
	local o = self.opts
	return x >= o.xMin and x <= o.xMax and y >= o.yMin and y <= o.yMax
end

function PlotView2D:layer(name: string, z: number?)
	local L = self.layers[name]
	if L then
		return L
	end
	L = setmetatable({
		plot = self,
		holder = Gui.frame({
			Name = name,
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			ZIndex = z or 2,
			Parent = self.area,
		}),
		dots = {}, segs = {}, labels = {}, rects = {},
		nd = 0, ns = 0, nl = 0, nr = 0,
	}, Layer)
	self.layers[name] = L
	return L
end

function PlotView2D:drawGrid()
	self:_applyEqualAspect()
	local o = self.opts
	local L = self:layer("grid", 1)
	local w, h = self:size()
	L:begin()
	for _, xt in o.xTicks do
		if xt < o.xMin or xt > o.xMax then
			continue
		end
		L:seg(xt, o.yMin, xt, o.yMax, { color = if xt == 0 then Theme.color.axis else Theme.color.grid, thickness = if xt == 0 then 2 else 1 })
		local px = self:toPx(xt, o.yMin)
		L:labelPx(px, h + 6, o.formatX(xt), { anchor = Vector2.new(0.5, 0), size = o.fontSize, color = Theme.color.textDim })
	end
	for _, yt in o.yTicks do
		if yt < o.yMin or yt > o.yMax then
			continue
		end
		L:seg(o.xMin, yt, o.xMax, yt, { color = if yt == 0 then Theme.color.axis else Theme.color.grid, thickness = if yt == 0 then 2 else 1 })
		local _, py = self:toPx(o.xMin, yt)
		L:labelPx(-8, py, o.formatY(yt), { anchor = Vector2.new(1, 0.5), size = o.fontSize, color = Theme.color.textDim })
	end
	if o.xLabel then
		L:labelPx(w / 2, h + o.fontSize + 14, o.xLabel, { anchor = Vector2.new(0.5, 0), size = o.fontSize, color = Theme.color.text })
	end
	if o.yLabel then
		L:labelPx(0, -8, o.yLabel, { anchor = Vector2.new(0, 1), size = o.fontSize, color = Theme.color.text })
	end
	L:finish()
end

-- ───── Layer ─────

function Layer:begin()
	self.nd, self.ns, self.nl, self.nr = 0, 0, 0, 0
end

function Layer:finish()
	for i = self.nd + 1, #self.dots do self.dots[i].Visible = false end
	for i = self.ns + 1, #self.segs do self.segs[i].Visible = false end
	for i = self.nl + 1, #self.labels do self.labels[i].Visible = false end
	for i = self.nr + 1, #self.rects do self.rects[i].Visible = false end
end

function Layer:setVisible(on: boolean)
	self.holder.Visible = on
end

-- Прямоугольник в пикселях области (оси экрана), обрезанный по области графика.
-- style: color, transparency, strokeColor, strokeTransparency
function Layer:rectPx(x0: number, y0: number, x1: number, y1: number, style)
	style = style or {}
	local w, h = self.plot:size()
	local ax, bx = math.max(math.min(x0, x1), 0), math.min(math.max(x0, x1), w)
	local ay, by = math.max(math.min(y0, y1), 0), math.min(math.max(y0, y1), h)
	if bx - ax < 0.5 or by - ay < 0.5 then
		return nil
	end
	self.nr += 1
	local f = self.rects[self.nr]
	if not f then
		f = Gui.frame({ ZIndex = 1, Parent = self.holder })
		Gui.stroke(Theme.color.text, 1).Parent = f
		self.rects[self.nr] = f
	end
	f.Visible = true
	f.Position = UDim2.fromOffset(ax, ay)
	f.Size = UDim2.fromOffset(bx - ax, by - ay)
	f.BackgroundColor3 = style.color or Theme.color.residual
	f.BackgroundTransparency = style.transparency or 0.6
	local st = f:FindFirstChildOfClass("UIStroke")
	st.Enabled = style.strokeColor ~= nil
	st.Color = style.strokeColor or Theme.color.text
	st.Transparency = style.strokeTransparency or 0
	return f
end

-- Прямоугольник в координатах данных
function Layer:rect(x0: number, y0: number, x1: number, y1: number, style)
	local ax, ay = self.plot:toPx(x0, y0)
	local bx, by = self.plot:toPx(x1, y1)
	return self:rectPx(ax, ay, bx, by, style)
end

-- Ломаная по точкам данных { {x, y}, ... }; closed — замкнуть
function Layer:polyline(points: { { number } }, style, closed: boolean?)
	local n = #points
	for i = 1, n - 1 do
		self:seg(points[i][1], points[i][2], points[i + 1][1], points[i + 1][2], style)
	end
	if closed and n > 2 then
		self:seg(points[n][1], points[n][2], points[1][1], points[1][2], style)
	end
end

-- style: color, size (px), hollow, transparency, strokeColor
function Layer:dot(x: number, y: number, style)
	style = style or {}
	if not self.plot:inRange(x, y) then
		return
	end
	local px, py = self.plot:toPx(x, y)
	self.nd += 1
	local f = self.dots[self.nd]
	if not f then
		f = Gui.frame({ AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3, Parent = self.holder })
		Gui.corner(UDim.new(0.5, 0)).Parent = f
		Gui.stroke(Theme.color.text, 3).Parent = f
		self.dots[self.nd] = f
	end
	local size = style.size or 12
	local tr = style.transparency or 0
	local color = style.color or Theme.color.text
	f.Visible = true
	f.Size = UDim2.fromOffset(size, size)
	f.Position = UDim2.fromOffset(px, py)
	f.BackgroundColor3 = color
	f.BackgroundTransparency = if style.hollow then 1 else tr
	local st = f:FindFirstChildOfClass("UIStroke")
	st.Enabled = style.hollow == true or style.strokeColor ~= nil
	st.Color = style.strokeColor or color
	st.Transparency = tr
	return f
end

-- Отрезок в пикселях области графика
function Layer:segPx(ax: number, ay: number, bx: number, by: number, style)
	style = style or {}
	local dx, dy = bx - ax, by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 0.5 then
		return
	end
	self.ns += 1
	local f = self.segs[self.ns]
	if not f then
		f = Gui.frame({ AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 2, Parent = self.holder })
		self.segs[self.ns] = f
	end
	f.Visible = true
	f.Position = UDim2.fromOffset((ax + bx) / 2, (ay + by) / 2)
	f.Size = UDim2.fromOffset(len + 1, style.thickness or 3)
	f.Rotation = math.deg(math.atan2(dy, dx))
	f.BackgroundColor3 = style.color or Theme.color.text
	f.BackgroundTransparency = style.transparency or 0
end

-- Отрезок в координатах данных, обрезанный по области графика
function Layer:seg(x0: number, y0: number, x1: number, y1: number, style)
	local o = self.plot.opts
	local a, b, c, d = BedGeometry.clipSegment(x0, y0, x1, y1, o.xMin, o.xMax, o.yMin, o.yMax)
	if not a then
		return
	end
	local ax, ay = self.plot:toPx(a, b)
	local bx, by = self.plot:toPx(c, d)
	self:segPx(ax, ay, bx, by, style)
end

-- Кривая y = fn(x) ломаной из steps отрезков
function Layer:curve(fn: (number) -> number, xFrom: number, xTo: number, steps: number, style)
	local px, py = xFrom, fn(xFrom)
	for i = 1, steps do
		local x = xFrom + (xTo - xFrom) * i / steps
		local y = fn(x)
		self:seg(px, py, x, y, style)
		px, py = x, y
	end
end

-- Пунктирная вертикаль x = const от y0 до y1
function Layer:dashedV(x: number, y0: number, y1: number, style)
	local o = self.plot.opts
	if x < o.xMin or x > o.xMax then
		return
	end
	local _, pa = self.plot:toPx(x, math.clamp(y0, o.yMin, o.yMax))
	local px, pb = self.plot:toPx(x, math.clamp(y1, o.yMin, o.yMax))
	local top, bottom = math.min(pa, pb), math.max(pa, pb)
	local dash, gap = 8, 6
	local y = top
	while y < bottom do
		self:segPx(px, y, px, math.min(y + dash, bottom), style)
		y += dash + gap
	end
end

-- Подпись в пикселях; style: anchor, size, color, font, transparency
function Layer:labelPx(px: number, py: number, text: string, style)
	style = style or {}
	self.nl += 1
	local l = self.labels[self.nl]
	if not l then
		l = Gui.label({
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			TextWrapped = false,
			ZIndex = 4,
			Parent = self.holder,
		})
		self.labels[self.nl] = l
	end
	l.Visible = true
	l.AnchorPoint = style.anchor or Vector2.new(0, 1)
	l.Position = UDim2.fromOffset(px, py)
	l.TextSize = style.size or self.plot.opts.fontSize
	l.TextColor3 = style.color or Theme.color.text
	l.Font = style.font or Theme.font
	l.TextTransparency = style.transparency or 0
	l.Text = text
end

function Layer:label(x: number, y: number, text: string, style)
	style = style or {}
	local px, py = self.plot:toPx(x, y)
	self:labelPx(px + (style.dx or 0), py + (style.dy or 0), text, style)
end

return PlotView2D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">R2View</string>
            <string name="Source"><![CDATA[--!nonstrict
-- R2View: «собери R² руками» — 2D.7 и проверка прогноза в лор-задаче.
--   Фаза res:  на графике квадраты остатков (yᵢ − ŷᵢ)²; тап по квадрату — он улетает в столбик SS_res (≤ 0,6 с);
--              после 2 ручных — кнопка «Собрать остальные».
--   Фаза mean: игрок тянет горизонтальную прямую (прилипание у ȳ) — появляются квадраты отклонений от среднего.
--   Фаза tot:  кнопка «Собрать в столбик» — квадраты улетают в SS_tot. Столбики в одном масштабе.
--   Фаза done: onDone(ssRes, ssTot).
-- opts: x, y, yhat, line = { m, c }?, xMin/xMax/xTicks, yMin/yMax/yTicks, xLabel, yLabel, unit, meanStart, snapTol,
--       markers (true — показывать прогноз точками-кольцами), onPhase(phase), onDone(ssRes, ssTot), store

local TweenService = game:GetService("TweenService")

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Format = require(Regression.Core.Format)
local Strings = require(Regression.UI.Strings)
local PlotView2D = require(Regression.UI.PlotView2D)
local Drag = require(Regression.UI.Drag)

local R2View = {}
R2View.__index = R2View

local MANUAL_BEFORE_AUTO = 2
local FLY_S = 0.5
local HIT_MIN = 32

function R2View.new(parent: GuiObject, opts)
	local self = setmetatable({}, R2View)
	self.opts = opts
	self.x, self.y, self.yhat = opts.x, opts.y, opts.yhat
	self.n = #opts.x
	local mean = 0
	for _, v in self.y do mean += v end
	self.mean = mean / self.n
	self.phase = "res"
	self.res, self.tot = {}, {}
	self.nRes, self.nTot, self.manual = 0, 0, 0
	self.meanY = opts.meanStart or (opts.yMin + (opts.yMax - opts.yMin) * 0.12)
	self.meanSet = false
	self.ssResFull, self.ssTotFull = 0, 0
	for i = 1, self.n do
		self.ssResFull += (self.y[i] - self.yhat[i]) ^ 2
		self.ssTotFull += (self.y[i] - self.mean) ^ 2
	end
	self.flying = 0
	self.conns = {}

	self.root = Gui.frame({ Name = "R2View", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = parent })
	local top = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -62), Parent = self.root })
	local left = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(0.66, -6, 1, 0), Parent = top })
	local right = Gui.frame({ BackgroundTransparency = 1, Position = UDim2.fromScale(0.66, 0), Size = UDim2.new(0.34, 0, 1, 0), Parent = top })
	self.plot = PlotView2D.new(left, {
		xMin = opts.xMin, xMax = opts.xMax, yMin = opts.yMin, yMax = opts.yMax, xTicks = opts.xTicks, yTicks = opts.yTicks,
		xLabel = opts.xLabel, yLabel = opts.yLabel, padL = 50, padR = 10, padT = 16, padB = 58, fontSize = 16, fallbackW = 420, fallbackH = 420,
		formatX = opts.formatX,
	})
	local colMax = math.max(self.ssTotFull, self.ssResFull) * 1.18
	local ticks = PlotView2D.ticks(0, colMax, 5)
	self.cols = PlotView2D.new(right, {
		xMin = 0, xMax = 3, yMin = 0, yMax = colMax, xTicks = {}, yTicks = ticks, yLabel = Strings.r2.colsLabel:format(opts.unit or ""),
		padL = 52, padR = 8, padT = 16, padB = 58, fontSize = 15, fallbackW = 200, fallbackH = 420,
	})
	self.plot.onResize = function() self:draw() end
	self.cols.onResize = function() self:draw() end

	-- кнопки-попадания по квадратам остатков
	self.hits = {}
	for i = 1, self.n do
		local b = Gui.make("TextButton", { Name = "Hit" .. i, Text = "", BackgroundTransparency = 1, AutoButtonColor = false, ZIndex = 8, Parent = self.plot.area })
		b.Activated:Connect(function()
			if self.phase == "res" and not self.res[i] then
				self.manual += 1
				self:collect("res", i, 0)
			end
		end)
		self.hits[i] = b
	end

	local bar = Gui.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 56), Parent = self.root })
	Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center, Parent = bar })
	self.restBtn = Gui.button({ Text = Strings.r2.collectRest, Size = UDim2.fromOffset(220, 50), Visible = false, LayoutOrder = 1, Parent = bar })
	self.restBtn.Activated:Connect(function()
		local k = 0
		for i = 1, self.n do
			if not self.res[i] then
				self:collect("res", i, k * 0.08)
				k += 1
			end
		end
		self.restBtn.Visible = false
	end)
	self.totBtn = Gui.button({ Text = Strings.r2.collectTot, Size = UDim2.fromOffset(220, 50), Visible = false, LayoutOrder = 2,
		BackgroundColor3 = Theme.color.mean, Parent = bar })
	self.totBtn.Activated:Connect(function()
		if self.phase ~= "tot" then
			return
		end
		for i = 1, self.n do
			self:collect("tot", i, (i - 1) * 0.08)
		end
		self.totBtn.Visible = false
	end)
	self.status = Gui.label({ Text = Strings.r2.tapSquares, TextSize = 17, TextColor3 = Theme.color.textDim, Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 3, Parent = bar })

	-- прямая среднего: тянуть по вертикали
	self.drag = Drag.attach(self.plot.area, {
		began = function(p)
			if self.phase ~= "mean" then
				return false
			end
			self:_dragMean(p)
			return true
		end,
		moved = function(p)
			self:_dragMean(p)
		end,
		ended = function()
			self:_releaseMean()
		end,
	})
	self:draw()
	return self
end

function R2View:_dragMean(p: Vector2)
	local _, py = self.plot:screenToPx(p.X, p.Y)
	local _, y = self.plot:fromPx(0, py)
	self.meanY = math.clamp(y, self.opts.yMin, self.opts.yMax)
	if self.opts.onChanged then
		self.opts.onChanged()
	end
	self:draw()
end

-- Сдвиг прямой среднего кнопками/клавишами (для телефона и клавиатуры)
function R2View:nudgeMean(dy: number)
	if self.phase ~= "mean" then
		return
	end
	self.meanY = math.clamp(self.meanY + dy, self.opts.yMin, self.opts.yMax)
	self:draw()
end

function R2View:_releaseMean()
	if self.phase ~= "mean" then
		return
	end
	local tol = self.opts.snapTol or 1.5
	if math.abs(self.meanY - self.mean) < tol then
		self.meanY = self.mean
		self.meanSet = true
		self:setPhase("tot")
	end
	self:draw()
end

function R2View:setPhase(phase: string)
	self.phase = phase
	self.status.Text = Strings.r2.status[phase] or ""
	self.totBtn.Visible = phase == "tot"
	if self.opts.onPhase then
		self.opts.onPhase(phase)
	end
end

-- Полёт квадрата в столбик (≤ 0,6 с), потом — столбик растёт
function R2View:collect(kind: string, i: number, delay: number)
	local set = if kind == "res" then self.res else self.tot
	if set[i] then
		return
	end
	set[i] = "flying"
	self.flying += 1
	task.delay(delay, function()
		local r = self:_squareRect(kind, i)
		local tx, ty = self:_columnTop(kind)
		local fly = nil
		if r then
			local origin = self.root.AbsolutePosition
			fly = Gui.frame({ BackgroundColor3 = if kind == "res" then Theme.color.residual else Theme.color.mean, BackgroundTransparency = 0.3,
				Position = UDim2.fromOffset(r.x - origin.X, r.y - origin.Y), Size = UDim2.fromOffset(r.w, r.h), ZIndex = 20, Parent = self.root })
			local tw = TweenService:Create(fly, TweenInfo.new(FLY_S, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(tx - origin.X - 10, ty - origin.Y - 10), Size = UDim2.fromOffset(20, 20), BackgroundTransparency = 0.6 })
			tw:Play()
		end
		task.delay(FLY_S, function()
			if fly then
				fly:Destroy()
			end
			set[i] = true
			self.flying -= 1
			if kind == "res" then
				self.nRes += 1
				if self.manual >= MANUAL_BEFORE_AUTO and self.nRes < self.n then
					self.restBtn.Visible = true
				end
				if self.nRes == self.n then
					self.restBtn.Visible = false
					self:setPhase("mean")
				end
			else
				self.nTot += 1
				if self.nTot == self.n then
					self:setPhase("done")
					if self.opts.onDone then
						self.opts.onDone(self:ssRes(), self:ssTot())
					end
				end
			end
			if self.opts.onChanged then
				self.opts.onChanged()
			end
			self:draw()
		end)
	end)
end

function R2View:ssRes(): number
	local s = 0
	for i = 1, self.n do
		if self.res[i] == true then s += (self.y[i] - self.yhat[i]) ^ 2 end
	end
	return s
end

function R2View:ssTot(): number
	local s = 0
	for i = 1, self.n do
		if self.tot[i] == true then s += (self.y[i] - self.mean) ^ 2 end
	end
	return s
end

-- Абсолютный прямоугольник квадрата на экране
function R2View:_squareRect(kind: string, i: number)
	local plot = self.plot
	local x, y = self.x[i], self.y[i]
	local base = if kind == "res" then self.yhat[i] else self.meanY
	local px, py = plot:toPx(x, y)
	local _, pb = plot:toPx(x, base)
	local side = math.abs(pb - py)
	local xm = 0
	for _, v in self.x do xm += v end
	xm /= self.n
	local dir = if x < xm then -1 else 1
	local x0, x1 = math.min(px, px + dir * side), math.max(px, px + dir * side)
	local y0, y1 = math.min(py, pb), math.max(py, pb)
	local a = plot.area.AbsolutePosition
	return { x = a.X + x0, y = a.Y + y0, w = x1 - x0, h = y1 - y0, lx0 = x0, ly0 = y0, lx1 = x1, ly1 = y1 }
end

function R2View:_columnTop(kind: string): (number, number)
	local cx = if kind == "res" then 1 else 2
	local h = if kind == "res" then self:ssRes() else self:ssTot()
	local px, py = self.cols:toPx(cx, h)
	local a = self.cols.area.AbsolutePosition
	return a.X + px, a.Y + py
end

function R2View:draw()
	local plot = self.plot
	local o = self.opts
	local hl = o.store and o.store:get("highlight")

	local sq = plot:layer("squares", 2)
	sq:begin()
	for i = 1, self.n do
		local hit = self.hits[i]
		if not self.res[i] then
			local r = self:_squareRect("res", i)
			sq:rectPx(r.lx0, r.ly0, r.lx1, r.ly1, { color = Theme.color.residual, transparency = if hl == "residual" then 0.3 else 0.5, strokeColor = Theme.color.residual })
			local w, h = math.max(r.lx1 - r.lx0, HIT_MIN), math.max(r.ly1 - r.ly0, HIT_MIN)
			hit.Visible = self.phase == "res"
			hit.Position = UDim2.fromOffset((r.lx0 + r.lx1) / 2 - w / 2, (r.ly0 + r.ly1) / 2 - h / 2)
			hit.Size = UDim2.fromOffset(w, h)
		else
			hit.Visible = false
		end
		if self.meanSet and not self.tot[i] then
			local r = self:_squareRect("tot", i)
			sq:rectPx(r.lx0, r.ly0, r.lx1, r.ly1, { color = Theme.color.mean, transparency = if hl == "mean" then 0.3 else 0.55, strokeColor = Theme.color.mean })
		end
	end
	sq:finish()

	local ln = plot:layer("model", 3)
	ln:begin()
	if o.line then
		ln:seg(o.xMin, o.line.m * o.xMin + o.line.c, o.xMax, o.line.m * o.xMax + o.line.c, { color = Theme.color.line, thickness = 3 })
	end
	for i = 1, self.n do
		ln:seg(self.x[i], self.y[i], self.x[i], self.yhat[i], { color = Theme.color.residual, thickness = 2 })
	end
	if self.phase ~= "res" then
		ln:seg(o.xMin, self.meanY, o.xMax, self.meanY, { color = Theme.color.mean, thickness = if self.meanSet then 3 else 4 })
		ln:label(o.xMax, self.meanY, if self.meanSet then "ȳ = " .. Format.num(self.mean, 1) else Strings.r2.dragMean,
			{ dx = -6, dy = -4, anchor = Vector2.new(1, 1), size = 16, color = Theme.color.text, font = Theme.fontBold })
		if self.meanSet then
			for i = 1, self.n do
				ln:seg(self.x[i] + (o.xMax - o.xMin) * 0.006, self.y[i], self.x[i] + (o.xMax - o.xMin) * 0.006, self.mean, { color = Theme.color.mean, thickness = 2 })
			end
		end
	end
	ln:finish()

	local pts = plot:layer("points", 5)
	pts:begin()
	for i = 1, self.n do
		if o.markers then
			pts:dot(self.x[i], self.yhat[i], { color = Theme.color.m, size = 14, hollow = true })
		end
		pts:dot(self.x[i], self.y[i], { color = Theme.color.text, size = 12, strokeColor = Theme.color.bg })
	end
	pts:finish()

	-- столбики: стопки квадратов, общий масштаб
	local cols = self.cols
	local L = cols:layer("columns", 3)
	L:begin()
	for k, kind in { "res", "tot" } do
		local acc = 0
		local set = if kind == "res" then self.res else self.tot
		for i = 1, self.n do
			if set[i] == true then
				local v = if kind == "res" then (self.y[i] - self.yhat[i]) ^ 2 else (self.y[i] - self.mean) ^ 2
				L:rect(k - 0.35, acc, k + 0.35, acc + v, { color = if kind == "res" then Theme.color.residual else Theme.color.mean, transparency = 0.15,
					strokeColor = Theme.color.bg, strokeTransparency = 0 })
				acc += v
			end
		end
		local name = if kind == "res" then "SS_res" else "SS_tot"
		local px, _ = cols:toPx(k, 0)
		local _, ph = cols:size()
		L:labelPx(px, ph + 6, name, { anchor = Vector2.new(0.5, 0), size = 16, color = if kind == "res" then Theme.color.residual else Theme.color.mean, font = Theme.fontBold })
		if acc > 0 then
			L:label(k, acc, Format.num(acc, 1), { anchor = Vector2.new(0.5, 1), dy = -2, size = 16, color = Theme.color.text, font = Theme.fontBold })
		end
	end
	L:finish()
end

function R2View:Destroy()
	self.drag.Destroy()
	self.root:Destroy()
end

return R2View
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Shell2D</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Shell2D: оболочка экранов 2D experience и панелей лор-задачи (ScreenGui поверх мира).
--   ┌ шапка: шаг · заголовок ·········· [Формулы] [Блокнот] [?] [Закрыть] ┐
--   │ main (графики сцены)          │ side: полоса формул (≤ 3), текст, управление │
--   └ подвал: задание ······································· [Дальше →] ┘
-- На узком экране (< 820 px) side уезжает в выдвижную панель (кнопка «Формулы»).
-- Ставки, подсказки и всплывающие сообщения — внутри оболочки, поверх сцены.

local TweenService = game:GetService("TweenService")

local Regression = script.Parent.Parent
local Config = require(Regression.Core.Config)
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Strings = require(Regression.UI.Strings)
local FormulaView = require(Regression.UI.FormulaView)
local Notebook = require(Regression.UI.Notebook)

local Shell2D = {}
Shell2D.__index = Shell2D

local MAX_FORMULAS = 3
local COMPACT_W = 820

function Shell2D.new(playerGui: PlayerGui, store)
	local self = setmetatable({}, Shell2D)
	self.store = store
	self.formulas = {}
	self.onClose = nil :: (() -> ())?
	self.onNext = nil :: (() -> ())?
	self.onHint = nil :: (() -> ())?
	self.isOpen = false
	self.compact = false
	self.sideOpen = false

	self.gui = Gui.make("ScreenGui", {
		Name = "Regression2D", ResetOnSpawn = false, Enabled = false, DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = playerGui,
	})
	local dim = Gui.frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.35, Parent = self.gui })
	local panel = Gui.frame({ Name = "Panel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.96, 0.94),
		BackgroundColor3 = Theme.color.bg, Parent = dim })
	Gui.corner(UDim.new(0, 14)).Parent = panel
	Gui.make("UISizeConstraint", { MaxSize = Vector2.new(1240, 720), Parent = panel })
	self.panel = panel

	self:_buildHeader()
	self:_buildBody()
	self:_buildFooter()
	self:_buildOverlays()
	self.notebook = Notebook.new(panel)

	panel:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_layout()
	end)
	self:_layout()
	return self
end

-- ───── каркас ─────

function Shell2D:_buildHeader()
	local p = self.panel
	self.stepLabel = Gui.label({ Position = UDim2.fromOffset(18, 6), Size = UDim2.new(1, -440, 0, 20), TextSize = 16,
		TextColor3 = Theme.color.textDim, Parent = p })
	self.titleLabel = Gui.label({ Position = UDim2.fromOffset(18, 24), Size = UDim2.new(1, -440, 0, 30), TextSize = 26,
		Font = Theme.fontBold, TextScaled = true, Parent = p })
	Gui.make("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 16, Parent = self.titleLabel })

	local bar = Gui.frame({ BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(420, 46), Parent = p })
	Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = bar })
	local h = Strings.s2d
	self.sideBtn = Gui.button({ Text = h.formulasBtn, Size = UDim2.fromOffset(100, 44), LayoutOrder = 1, Visible = false, TextSize = 18, Parent = bar })
	self.sideBtn.Activated:Connect(function()
		self:setSideOpen(not self.sideOpen)
	end)
	self.notebookBtn = Gui.button({ Text = h.notebookBtn, Size = UDim2.fromOffset(100, 44), LayoutOrder = 2, TextSize = 18, Parent = bar })
	self.notebookBtn.Activated:Connect(function()
		self.notebook:toggle()
	end)
	self.hintBtn = Gui.button({ Text = "?", Size = UDim2.fromOffset(44, 44), LayoutOrder = 3, TextSize = 26, Parent = bar })
	self.hintBtn.Activated:Connect(function()
		if self.onHint then
			self.onHint()
		end
	end)
	self.closeBtn = Gui.button({ Text = h.close, Size = UDim2.fromOffset(110, 44), LayoutOrder = 4, TextSize = 18, Parent = bar })
	self.closeBtn.Activated:Connect(function()
		self:close()
		if self.onClose then
			self.onClose()
		end
	end)
end

function Shell2D:_buildBody()
	local p = self.panel
	self.body = Gui.frame({ Name = "Body", BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 60), Size = UDim2.new(1, -20, 1, -128), Parent = p })
	self.main = Gui.frame({ Name = "Main", BackgroundTransparency = 1, ClipsDescendants = false, Parent = self.body })
	self.side = Gui.frame({ Name = "Side", BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0, ZIndex = 5, Parent = self.body })
	Gui.corner().Parent = self.side
	self.sideScroll = Gui.make("ScrollingFrame", {
		Name = "SideScroll", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5, ZIndex = 5, Parent = self.side,
	})
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), Parent = self.sideScroll })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = self.sideScroll })
	self.formulaHolder = Gui.frame({ Name = "Formulas", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, ZIndex = 5, Parent = self.sideScroll })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = self.formulaHolder })
	self.text = Gui.label({ Name = "Text", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 19,
		TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, ZIndex = 5, Parent = self.sideScroll })
	self.controls = Gui.frame({ Name = "Controls", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, ZIndex = 5, Parent = self.sideScroll })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = self.controls })
end

function Shell2D:_buildFooter()
	local p = self.panel
	self.taskLabel = Gui.label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 18, 1, -10), Size = UDim2.new(1, -250, 0, 48),
		TextSize = 20, TextColor3 = Theme.color.text, TextScaled = true, Parent = p })
	Gui.make("UITextSizeConstraint", { MaxTextSize = 20, MinTextSize = 14, Parent = self.taskLabel })
	self.nextBtn = Gui.button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -10), Size = UDim2.fromOffset(210, 50),
		Text = Strings.s2d.next, TextSize = 22, Parent = p })
	self.nextBtn.Activated:Connect(function()
		if self.nextEnabled and self.onNext then
			self.onNext()
		end
	end)
	self:setNext(false)
end

function Shell2D:_buildOverlays()
	local p = self.panel
	-- всплывающее сообщение
	self.toastLabel = Gui.label({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 64), Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY, BackgroundColor3 = Theme.color.panel2, BackgroundTransparency = 0.05, Font = Theme.fontBold,
		TextWrapped = false, Visible = false, ZIndex = 30, Parent = p })
	Gui.corner().Parent = self.toastLabel
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), Parent = self.toastLabel })
	self.toastId = 0

	-- ставка
	local pr = Gui.frame({ Name = "Prediction", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(380, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.02, Visible = false, ZIndex = 35, Parent = p })
	Gui.corner().Parent = pr
	Gui.stroke(Theme.color.c, 2).Parent = pr
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 12), Parent = pr })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8), Parent = pr })
	Gui.label({ Text = Strings.hud.predictionTitle, TextColor3 = Theme.color.c, TextSize = 16, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, ZIndex = 36, Parent = pr })
	self.predQuestion = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Font = Theme.fontBold, LayoutOrder = 2, ZIndex = 36, Parent = pr })
	self.predButtons = {}
	for i = 1, 4 do
		local b = Gui.button({ Size = UDim2.new(1, 0, 0, Theme.size.touch), LayoutOrder = 2 + i, Visible = false, ZIndex = 36, TextWrapped = true, Parent = pr })
		b.Activated:Connect(function()
			if self.predPick then
				local fn = self.predPick
				self.predPick = nil
				for k, other in self.predButtons do
					other.BackgroundColor3 = if k == i then Theme.color.c else Theme.color.panel2
					other.AutoButtonColor = false
				end
				-- после выбора панель уходит в сторону, чтобы не закрывать эксперимент
				self.pred.AnchorPoint = Vector2.new(1, 1)
				self.pred.Position = UDim2.new(1, -12, 1, -70)
				for _, other in self.predButtons do
					other.Visible = false
				end
				self.predChosen.Text = Strings.s2d.yourBet:format(self.predSpec.options[i])
				self.predChosen.Visible = true
				fn(i)
			end
		end)
		self.predButtons[i] = b
	end
	self.predChosen = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextColor3 = Theme.color.c,
		LayoutOrder = 9, Visible = false, ZIndex = 36, Parent = pr })
	self.predResult = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10, Visible = false, ZIndex = 36, Parent = pr })
	self.pred = pr

	-- подсказка
	local hint = Gui.frame({ Name = "Hint", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 60), Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Theme.color.bg, BackgroundTransparency = 0.02, Visible = false, ZIndex = 32, Parent = p })
	Gui.corner().Parent = hint
	Gui.stroke(Theme.color.loss, 2).Parent = hint
	Gui.make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 10), Parent = hint })
	Gui.make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = hint })
	self.hintTitle = Gui.label({ Size = UDim2.new(1, 0, 0, 22), TextSize = 16, TextColor3 = Theme.color.loss, LayoutOrder = 1, ZIndex = 33, Parent = hint })
	self.hintText = Gui.label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, ZIndex = 33, Parent = hint })
	self.hint = hint
	self.pulses = {}
end

-- ───── раскладка ─────

function Shell2D:_layout()
	local w = self.panel.AbsoluteSize.X
	local compact = w > 0 and w < COMPACT_W
	self.compact = compact
	self.sideBtn.Visible = compact
	if compact then
		self.main.Position = UDim2.fromScale(0, 0)
		self.main.Size = UDim2.fromScale(1, 1)
		self.side.AnchorPoint = Vector2.new(1, 0)
		self.side.Position = UDim2.fromScale(1, 0)
		self.side.Size = UDim2.fromScale(0.86, 1)
		self.side.Visible = self.sideOpen
		self.side.BackgroundTransparency = 0.03
	else
		self.main.Position = UDim2.fromScale(0, 0)
		self.main.Size = UDim2.new(self.mainShare or 0.6, -8, 1, 0)
		self.side.AnchorPoint = Vector2.new(0, 0)
		self.side.Position = UDim2.fromScale(self.mainShare or 0.6, 0)
		self.side.Size = UDim2.fromScale(1 - (self.mainShare or 0.6), 1)
		self.side.Visible = true
		self.side.BackgroundTransparency = 1
	end
end

-- Доля ширины под графики (сцене с двумя графиками нужно больше места)
function Shell2D:setMainShare(share: number)
	self.mainShare = share
	self:_layout()
end

function Shell2D:setSideOpen(on: boolean)
	self.sideOpen = on
	self:_layout()
end

-- ───── API сцен ─────

function Shell2D:open()
	self.gui.Enabled = true
	self.isOpen = true
end

function Shell2D:close()
	self.gui.Enabled = false
	self.isOpen = false
	self.notebook:setVisible(false)
end

function Shell2D:setHeader(id: string, title: string)
	self.stepLabel.Text = Strings.s2d.stepLabel:format(id)
	self.titleLabel.Text = title
end

function Shell2D:setTask(text: string)
	self.taskLabel.Text = text
end

function Shell2D:setText(text: string)
	self.text.Text = text
end

function Shell2D:setNext(enabled: boolean, label: string?)
	self.nextEnabled = enabled
	self.nextBtn.Text = label or Strings.s2d.next
	self.nextBtn.BackgroundColor3 = if enabled then Theme.color.good else Theme.color.panel2
	self.nextBtn.TextColor3 = if enabled then Theme.color.bg else Theme.color.textDim
	self.nextBtn.AutoButtonColor = enabled
end

-- Новая формула в полосе (не больше 3 на экране)
function Shell2D:addFormula(spec, state)
	assert(#self.formulas < MAX_FORMULAS, "Shell2D: больше 3 формул на экране — перенеси старые в блокнот")
	local fv = FormulaView.new(self.formulaHolder, spec, { store = self.store, layoutOrder = #self.formulas + 1, state = state })
	table.insert(self.formulas, fv)
	return fv
end

-- Кнопка в колонке управления
function Shell2D:button(text: string, opts)
	opts = opts or {}
	local b = Gui.button({ Text = text, Size = opts.size or UDim2.new(1, 0, 0, 48), LayoutOrder = opts.order or 10, TextSize = opts.textSize or 20,
		BackgroundColor3 = opts.color or Theme.color.panel2, TextColor3 = opts.textColor or Theme.color.text, ZIndex = 6,
		Visible = opts.visible ~= false, Parent = opts.parent or self.controls })
	if opts.onClick then
		b.Activated:Connect(opts.onClick)
	end
	return b
end

-- Ряд кнопок в колонке управления
function Shell2D:row(order: number?, height: number?)
	local f = Gui.frame({ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 48), LayoutOrder = order or 10, ZIndex = 6, Parent = self.controls })
	Gui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = f })
	return f
end

-- Убрать всё сценовое; формулы с toNotebook уходят в блокнот
function Shell2D:clearScene(sceneId: string?, keepMain: boolean?)
	for _, fv in self.formulas do
		if sceneId and fv.spec.toNotebook then
			self.notebook:addFormula(sceneId, fv:snapshot())
		end
		fv:Destroy()
	end
	self.formulas = {}
	if not keepMain then
		for _, c in self.main:GetChildren() do
			c:Destroy()
		end
	end
	for _, c in self.controls:GetChildren() do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
	self.text.Text = ""
	self:closePrediction()
	self:hideHint()
	self:setNext(false)
	self:setMainShare(0.6)
end

function Shell2D:toast(text: string, color: Color3?)
	self.toastId += 1
	local id = self.toastId
	self.toastLabel.Text = text
	self.toastLabel.TextColor3 = color or Theme.color.text
	self.toastLabel.Visible = true
	task.delay(Config.TOAST_S, function()
		if self.toastId == id then
			self.toastLabel.Visible = false
		end
	end)
end

-- Ставка: 2–4 варианта; onPick(i) один раз. Ответ — resolve() после действия игрока.
function Shell2D:ask(spec, onPick: (number) -> ())
	self.predSpec = spec
	self.predQuestion.Text = spec.question
	for i, b in self.predButtons do
		local opt = spec.options[i]
		b.Visible = opt ~= nil
		b.Text = opt or ""
		b.BackgroundColor3 = Theme.color.panel2
		b.AutoButtonColor = true
	end
	self.pred.AnchorPoint = Vector2.new(0.5, 0.5)
	self.pred.Position = UDim2.fromScale(0.5, 0.5)
	self.predResult.Visible = false
	self.predChosen.Visible = false
	self.predPick = onPick
	self.pred.Visible = true
end

function Shell2D:resolve(correct: boolean, explanation: string)
	self.predResult.Text = (if correct then Theme.tok("good", Strings.hud.predictionOk) else Strings.hud.predictionWrong) .. "\n" .. explanation
	self.predResult.Visible = true
	self.pred.Visible = true
	self.predPick = nil
	local token = {}
	self.predToken = token
	task.delay(8, function()
		if self.predToken == token then
			self.pred.Visible = false
		end
	end)
end

function Shell2D:closePrediction()
	self.pred.Visible = false
	self.predPick = nil
	self.predToken = nil
end

function Shell2D:showHint(level: number, text: string, targets: { GuiObject }?)
	self.hintTitle.Text = Strings.hud.hintTitle:format(level)
	self.hintText.Text = text
	self.hint.Visible = true
	self:_clearPulses()
	for _, t in targets or {} do
		local st = Gui.stroke(Theme.color.loss, 4)
		st.Name = "HintPulse"
		st.Parent = t
		table.insert(self.pulses, st)
		TweenService:Create(st, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Transparency = 0.8 }):Play()
	end
end

function Shell2D:_clearPulses()
	for _, p in self.pulses do
		p:Destroy()
	end
	self.pulses = {}
end

function Shell2D:hideHint()
	self.hint.Visible = false
	self:_clearPulses()
end

-- Подтверждение действия (≤ 0,6 с)
function Shell2D:flash(gui: GuiObject)
	local old = gui.BackgroundColor3
	gui.BackgroundColor3 = Theme.color.good
	TweenService:Create(gui, TweenInfo.new(0.5), { BackgroundColor3 = old }):Play()
end

return Shell2D
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">Slider</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Slider: горизонтальный ползунок (мышь, палец, кнопки −/+ для точного шага; зона касания ≥ 44 px).
--   local s = Slider.new(parent, { min = 0, max = 20, step = 0.1, value = 0, label = "λ", color = Theme.color.penalty,
--       format = Format.lambda, onChanged = fn(v), onReleased = fn(v) })
--   s:set(v, silent?), s.value, s.frame, s:Destroy()

local Regression = script.Parent.Parent
local Theme = require(Regression.UI.Theme)
local Gui = require(Regression.UI.Gui)
local Drag = require(Regression.UI.Drag)

local Slider = {}
Slider.__index = Slider

function Slider.new(parent: GuiObject, opts)
	local self = setmetatable({}, Slider)
	self.opts = opts
	self.value = opts.value or opts.min
	local color = opts.color or Theme.color.loss
	self.frame = Gui.frame({ Name = opts.name or "Slider", BackgroundTransparency = 1, Size = opts.size or UDim2.new(1, 0, 0, 56),
		LayoutOrder = opts.layoutOrder or 0, Parent = parent })
	self.caption = Gui.label({ Size = UDim2.new(0, 110, 1, 0), TextSize = 20, Font = Theme.fontBold, Parent = self.frame })
	local minus = Gui.button({ Text = "−", TextSize = 24, Size = UDim2.fromOffset(44, 44), Position = UDim2.new(0, 112, 0.5, -22), Parent = self.frame })
	local plus = Gui.button({ Text = "+", TextSize = 24, Size = UDim2.fromOffset(44, 44), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0.5, -22), Parent = self.frame })
	self.track = Gui.frame({ BackgroundColor3 = Theme.color.panel2, Position = UDim2.new(0, 170, 0.5, -4), Size = UDim2.new(1, -230, 0, 8),
		Parent = self.frame })
	Gui.corner(UDim.new(0, 4)).Parent = self.track
	self.fill = Gui.frame({ BackgroundColor3 = color, Size = UDim2.fromScale(0, 1), Parent = self.track })
	Gui.corner(UDim.new(0, 4)).Parent = self.fill
	self.knob = Gui.frame({ AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color, Size = UDim2.fromOffset(26, 26),
		Position = UDim2.fromScale(0, 0.5), ZIndex = 3, Parent = self.track })
	Gui.corner(UDim.new(0.5, 0)).Parent = self.knob
	Gui.stroke(Theme.color.text, 2).Parent = self.knob
	-- невидимая широкая зона касания поверх дорожки
	self.hit = Gui.make("TextButton", { Text = "", BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.new(1, 24, 0, 48),
		Position = UDim2.new(0, -12, 0.5, -24), ZIndex = 4, Parent = self.track })

	local function fromScreen(p: Vector2)
		local a, s = self.track.AbsolutePosition, self.track.AbsoluteSize
		local t = if s.X > 0 then math.clamp((p.X - a.X) / s.X, 0, 1) else 0
		self:set(opts.min + t * (opts.max - opts.min))
	end
	self.drag = Drag.attach(self.hit, {
		began = function(p)
			fromScreen(p)
		end,
		moved = fromScreen,
		ended = function()
			if opts.onReleased then
				opts.onReleased(self.value)
			end
		end,
	})
	local stepBtn = opts.buttonStep or opts.step or (opts.max - opts.min) / 100
	minus.Activated:Connect(function()
		self:set(self.value - stepBtn)
		if opts.onReleased then
			opts.onReleased(self.value)
		end
	end)
	plus.Activated:Connect(function()
		self:set(self.value + stepBtn)
		if opts.onReleased then
			opts.onReleased(self.value)
		end
	end)
	self:set(self.value, true)
	return self
end

function Slider:set(v: number, silent: boolean?)
	local o = self.opts
	v = math.clamp(v, o.min, o.max)
	if o.step then
		v = math.clamp(math.round(v / o.step) * o.step, o.min, o.max)
		-- убрать хвосты float (6,6000000000000005 → 6,6)
		v = tonumber(string.format("%.6f", v)) :: number
	end
	local changed = v ~= self.value
	self.value = v
	local t = (v - o.min) / (o.max - o.min)
	self.knob.Position = UDim2.fromScale(t, 0.5)
	self.fill.Size = UDim2.fromScale(t, 1)
	self.caption.Text = ("%s = %s"):format(o.label or "", if o.format then o.format(v) else tostring(v))
	if changed and not silent and o.onChanged then
		o.onChanged(v)
	end
end

function Slider:Destroy()
	self.drag.Destroy()
	self.frame:Destroy()
end

return Slider
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Strings</string>
            <string name="Source"><![CDATA[--!strict
-- Strings: все строки интерфейса 3D experience (задел под локализацию).
-- Цвета в RichText подставляются из Theme.hex в местах использования.

return {
	-- Табло
	boardTitle = "Клумба · ошибка предсказания",
	boardIdle = "Подойди к клумбе —\nтабло оживёт",
	slopeName = "наклон",
	heightName = "высота",
	lambdaNote = "регуляризации пока нет",
	plotTitle = "MSE от наклона",
	plotX = "m (наклон)",
	plotY = "MSE, м²",
	staleNote = "бледные — записаны на другой высоте",
	parabolaOtherH = "парабола построена при h = %s; минимум по m тот же",
	recordBtn = "Записать (R)",
	recordCounter = "Записи при h = %s: %d из 5",
	recordsDone = "Записи готовы",

	-- Шаги: баннер (заголовок + задание)
	step = {
		["3D.1"] = { title = "Клумба", task = "Подойди к клумбе с пятью цветками" },
		["3D.2"] = { title = "Ошибки", task = "Протяни нить от каждого цветка до прямой — F у цветка" },
		["3D.3"] = { title = "Квадраты ошибок", task = "Подвигай прямую: Q/E — наклон, Shift/Ctrl — высота" },
		["3D.4"] = { title = "Пять записей", task = "Запиши 5 разных наклонов на одной высоте — R" },
		["3D.5"] = { title = "Парабола и минимум", task = "Поставь прямую на наклон из минимума параболы" },
		["3D.6"] = { title = "Дальше — графики", task = "Подойди ко второму табло и продолжи обучение" },
		["2D"] = { title = "2D experience", task = "Экран обучения на втором табло — F «Продолжить обучение»" },
		["2D.1"] = { title = "Минимум параболы — это dL/dm = 0", task = "Покажи L = n·MSE и веди бегунок, пока касательная не станет горизонтальной" },
		["2D.2"] = { title = "Новый график: ищем свободный член", task = "Сдвинь прямую вверх или вниз — перетащи её или Shift/Ctrl" },
		["2D.3"] = { title = "Минимум по свободному члену — это dL/dc = 0", task = "Запиши 5 положений прямой (R или «Записать»), потом поставь её в минимум" },
		["2D.4"] = { title = "Мало данных — коэффициенты «пляшут»", task = "Поверни облако, проверь модель на остальных 10 точках, обучи на 15, открой 2 дальние точки" },
		["2D.5"] = { title = "L2 и L1: ограничение коэффициентов", task = "Двигай λ: найди, когда L1 обнулит температуру, и доведи L2 до λ = 20" },
		["2D.6"] = { title = "Сумма ошибки от наклона при разных λ", task = "Отметь минимум тапом по графику и найди λ, при котором минимум L1 впервые становится нулём" },
		["2D.7"] = { title = "R² — доля объяснённого разброса", task = "Собери квадраты остатков, поставь прямую на среднее и собери квадраты отклонений" },
		["L.0"] = { title = "Лор: пасечник", task = "Подойди к пасечнику и поговори с ним (F)" },
		["L.1"] = { title = "Лор: какой метод выбрать?", task = "Выбери метод регрессии для прогноза мёда" },
